/* The exported ppp_add_cb_on_*_return / ppp_remove_cb_on_*_return functions: each puts its callback on its
 * call's numbers in every table that has it (sc2_tables.h, SC2_SHIM). Generated by
 * scripts/syscall_parser.py. */
{% for arch, syscalls in syscalls_arch.items() -%}
#if {{architectures[arch].get('boilerplate_target', architectures[arch].qemu_target)}}
{%- for syscall_name, syscall in syscalls|dictsort %}
#ifndef SC2_SHIM_ON_{{syscall.name|upper}}_RETURN
#define SC2_SHIM_ON_{{syscall.name|upper}}_RETURN
SC2_SHIM(on_{{syscall.name}}_return, SC2_N_{{syscall.name}}, SC2_RETURN)
#endif
{%- endfor %}
#endif
{% endfor %}
SC2_SHIM_NR(on_unknown_sys_return, SC2_N_unknown, SC2_RETURN)
SC2_SHIM_ALL(on_all_sys_return, SC2_L_ALL_RETURN)
SC2_SHIM_CTX(on_all_sys_return2, SC2_L_RETURN2)

