/*!
 * @file syscall_names.h
 * @brief The callback names of every profile, numbered for syscalls2's dispatch tables
 * (sc2_tables.h). Generated by scripts/syscall_parser.py.
 */
#pragma once

/** @brief Most arguments of a call in any profile. */
#define SC2_MAX_ARGS {{global_max_syscall_args}}
/** @brief Most raw argument words a call of any profile reads. */
#define SC2_MAX_SLOTS {{global_max_slots}}

enum sc2_name {
	SC2_N_unknown,
{%- for name in names %}
	SC2_N_{{name}},
{%- endfor %}
	SC2_N_COUNT
};

