/* {{os}}:{{arch}} system calls as data, for syscalls2's dispatch (sc2_tables.h): per number its
 * arguments' kinds, flags and callback name. Generated by scripts/syscall_parser.py. */
#include "panda.h"                  /* the target */
#include "sc2_tables.h"

{% set t = table -%}
#if {{ arch_conf.get('runner_target', arch_conf.qemu_target) }}
static const sc2_sys sys[{{ [t.count, 1]|max }}] = {
{%- set ns = namespace(next=t.base) %}
{%- for no, sc in t.dense %}
{%- for gap in range(ns.next, no) %}
	{},
{%- endfor %}
	{ {{sc.args|length}}, {{ ['SC2_F_NORET' if sc.panda_noreturn else '', 'SC2_F_DOUBLE' if sc.panda_double_return else '']|select|join(' | ') or '0' }}, SC2_N_{{sc.name}}, { {{ sc.kind_macros()|join(', ') }} } },	/* {{no}} */
{%- set ns.next = no + 1 %}
{%- endfor %}
};
{%- if t.sparse %}
static const uint32_t sparse_nr[] = { {{ t.sparse|map('first')|map('string')|join(', ') }} };
static const sc2_sys sparse[] = {
{%- for no, sc in t.sparse %}
	{ {{sc.args|length}}, {{ ['SC2_F_NORET' if sc.panda_noreturn else '', 'SC2_F_DOUBLE' if sc.panda_double_return else '']|select|join(' | ') or '0' }}, SC2_N_{{sc.name}}, { {{ sc.kind_macros()|join(', ') }} } },	/* {{no}} */
{%- endfor %}
};
{%- endif %}

extern const sc2_table sc2_table_{{os}}_{{arch}} = {
	{{t.base}}, {{t.count}}, sys, {{t.sparse|length}}, {{ 'sparse_nr, sparse' if t.sparse else 'nullptr, nullptr' }},
	{{t.fast_slots}}, {{t.slots}}, {{arch_conf.bits}},
};
#else
extern const sc2_table sc2_table_{{os}}_{{arch}} = {};	/* not this target's: every number unknown */
#endif

