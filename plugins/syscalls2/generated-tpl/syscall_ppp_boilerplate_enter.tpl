/* The exported ppp_add_cb_on_*_enter / ppp_remove_cb_on_*_enter functions: each puts its callback on its
 * call's numbers in every table that has it (sc2_tables.h, SC2_SHIM). Generated by
 * scripts/syscall_parser.py. */
{% for arch, syscalls in syscalls_arch.items() -%}
#if {{architectures[arch].get('boilerplate_target', architectures[arch].qemu_target)}}
{%- for syscall_name, syscall in syscalls|dictsort %}
#ifndef SC2_SHIM_ON_{{syscall.name|upper}}_ENTER
#define SC2_SHIM_ON_{{syscall.name|upper}}_ENTER
SC2_SHIM(on_{{syscall.name}}_enter, SC2_N_{{syscall.name}}, SC2_ENTER)
#endif
{%- endfor %}
#endif
{% endfor %}
SC2_SHIM_NR(on_unknown_sys_enter, SC2_N_unknown, SC2_ENTER)
SC2_SHIM_ALL(on_all_sys_enter, SC2_L_ALL_ENTER)
SC2_SHIM_CTX(on_all_sys_enter2, SC2_L_ENTER2)

