 }
diff --git a/include/accel/tcg/cpu-ops.h b/include/accel/tcg/cpu-ops.h
index 06ecc0beac77b2d13528e5dd25f6a12a45a718f7..b2eacb554288d5dffb29803a980f3f1f0fcf2870 100644
--- a/include/accel/tcg/cpu-ops.h
+++ b/include/accel/tcg/cpu-ops.h
@@ -121,11 +121,15 @@ struct TCGCPUOps {
     /**
      * @user_access_window: Open (@open true) or close the window in which
      * privileged code may access user memory, as an OS uaccess_enable()
-     * would (e.g. the ARM DACR user domain).  The window may stay open
-     * across a guest exception: the guest saves and restores it with the
-     * rest of the interrupted context.  Optional.
+     * would (e.g. the ARM DACR user domain).  Stateless: opening returns
+     * true only if the window was shut and is now open, with what closing
+     * needs in *@saved; closing (only after such an open) restores it.
+     * The caller owns that state for one access (see plugins/api-system.c);
+     * the window may stay open across a guest exception, which the guest
+     * saves and restores with the rest of the interrupted context.
+     * Optional.
      */
-    void (*user_access_window)(CPUState *cpu, bool open);
+    bool (*user_access_window)(CPUState *cpu, bool open, uint64_t *saved);
 
 #ifdef CONFIG_USER_ONLY
     /**
diff --git a/include/hw/core/cpu.h b/include/hw/core/cpu.h
index c34b0dff8086a57f2e1e34e4e00959d72ae28572..802f0f506757dbc63a072a7f65e74aede0773738 100644
--- a/include/hw/core/cpu.h
+++ b/include/hw/core/cpu.h
@@ -563,6 +563,17 @@ struct CPUState {
     int32_t exception_index;
     /* host return address into the block while a TCG hook runs, or 0 */
     uintptr_t tcg_hook_ra;
+    /*
+     * A user-access window a plugin memory access opened and left open
+     * across the guest fault it raised (plugins/api-system.c): the access
+     * re-run at the same @key adopts it and closes it.  Cleared on reset
+     * and on loadvm.
+     */
+    struct {
+        bool valid;
+        uint64_t key;
+        uint64_t saved;
+    } uaccess_pend;
     /*
      * While a syscall-event callback runs (the vCPU in user mode): the
      * kernel's MMU indexes, which syscall_trap_read() tries after the
diff --git a/plugins/api-system.c b/plugins/api-system.c
index 8876797372c4e4835b670a85e67ed629c139d718..a4bc5a00e4b83e20594bf6623fcaba0b9d3411dd 100644
--- a/plugins/api-system.c
+++ b/plugins/api-system.c
@@ -148,6 +148,58 @@ void qemu_plugin_update_ns(const void *handle, int64_t new_time)
  * instruction callbacks.
  */
 static const QemuPluginHwOps *hw_ops;
+
+/*
+ * The user-access window of one plugin memory access.  The target's hook
+ * is stateless; the access owns what it opened.  When it raises a guest
+ * fault with the window open (the guest must see the access as a uaccess),
+ * the window stays open in the interrupted context and the access re-runs
+ * once the guest has resolved the fault.  @key names the access (its
+ * return address into the block, or the guest PC): the re-run adopts the
+ * pending window and closes it.  A pending window nobody adopts (the task
+ * never came back to the instruction) is dropped at the next open that
+ * finds the window shut, and on reset and loadvm.  Nothing here outlives
+ * one access on this vCPU, so a later access never restores stale state.
+ */
+typedef struct UaccessWin {
+    bool (*fn)(CPUState *, bool, uint64_t *);
+    bool open;
+    uint64_t saved;
+} UaccessWin;
+
+static void uaccess_open(CPUState *cpu, UaccessWin *w, uint64_t key)
+{
+    w->open = false;
+    if (!w->fn) {
+        return;
+    }
+    if (w->fn(cpu, true, &w->saved)) {
+        w->open = true;
+        cpu->uaccess_pend.valid = false;    /* the guest shut it: stale */
+    } else if (cpu->uaccess_pend.valid && cpu->uaccess_pend.key == key) {
+        w->open = true;                     /* ours, from before the fault */
+        w->saved = cpu->uaccess_pend.saved;
+        cpu->uaccess_pend.valid = false;
+    }
+}
+
+/* about to raise a guest fault that does not return here */
+static void uaccess_leave_open(CPUState *cpu, UaccessWin *w, uint64_t key)
+{
+    if (w->open) {
+        cpu->uaccess_pend.valid = true;
+        cpu->uaccess_pend.key = key;
+        cpu->uaccess_pend.saved = w->saved;
+    }
+}
+
+static void uaccess_close(CPUState *cpu, UaccessWin *w)
+{
+    if (w->open) {
+        w->fn(cpu, false, &w->saved);
+        w->open = false;
+    }
+}
 static qemu_plugin_vcpu_bp_cb_t bp_cb;
 static void *bp_udata;
 static uint64_t hw_bps[4];
@@ -235,9 +287,10 @@ static int vaddr_ranges_hw(CPUState *cpu, VaddrRange *r, size_t n,
     if (!hw_ops) {
         return QEMU_PLUGIN_VADDR_BAD_MODE;
     }
-    if (user && hw_ops->window) {
-        hw_ops->window(cpu, true);
-    }
+    UaccessWin win = { .fn = user ? hw_ops->window : NULL };
+    uint64_t key = cpu->cc->get_pc(cpu);   /* state is synchronized */
+
+    uaccess_open(cpu, &win, key);
     for (int copy = 0; copy < 2 && ret == QEMU_PLUGIN_VADDR_OK; copy++) {
         for (size_t i = 0; i < n && ret == QEMU_PLUGIN_VADDR_OK; i++) {
             bool is_write = r[i].access_type == MMU_DATA_STORE;
@@ -261,6 +314,7 @@ static int vaddr_ranges_hw(CPUState *cpu, VaddrRange *r, size_t n,
                      * breakpoint callback.
                      */
                     hw_ops->raise(cpu, a, f);
+                    uaccess_leave_open(cpu, &win, key);
                     siglongjmp(cpu->jmp_env, 1);
                 }
                 if (t != 0) {
@@ -293,9 +347,7 @@ static int vaddr_ranges_hw(CPUState *cpu, VaddrRange *r, size_t n,
             }
         }
     }
-    if (user && hw_ops->window) {
-        hw_ops->window(cpu, false);
-    }
+    uaccess_close(cpu, &win);
     return ret;
 }
 
@@ -312,7 +364,8 @@ static int vaddr_ranges_fault(VaddrRange *r, size_t n,
     CPUState *cpu = current_cpu;
     CPUArchState *env;
     size_t page_size = qemu_target_page_size();
-    void (*window)(CPUState *, bool) = NULL;
+    UaccessWin win = { 0 };
+    uint64_t key = cpu->neg.plugin_cb_ra;
     int mmu_idx, fault_idx, ret = QEMU_PLUGIN_VADDR_OK;
 
     g_assert(cpu);
@@ -325,10 +378,8 @@ static int vaddr_ranges_fault(VaddrRange *r, size_t n,
         if (!cpu->cc->tcg_ops->user_mmu_index) {
             return QEMU_PLUGIN_VADDR_BAD_MODE;
         }
-        window = cpu->cc->tcg_ops->user_access_window;
-        if (window) {
-            window(cpu, true);
-        }
+        win.fn = cpu->cc->tcg_ops->user_access_window;
+        uaccess_open(cpu, &win, key);
         mmu_idx = cpu->cc->tcg_ops->user_mmu_index(cpu);
         fault_idx = cpu->cc->tcg_ops->user_fault_mmu_index ?
                     cpu->cc->tcg_ops->user_fault_mmu_index(cpu) : mmu_idx;
@@ -380,9 +431,12 @@ static int vaddr_ranges_fault(VaddrRange *r, size_t n,
                      * translation became valid meanwhile.  A user access
                      * window stays open: the guest saves it with the
                      * interrupted context and restores it when it resumes
-                     * here; we close it on the way out.
+                     * here, where the re-run adopts and closes it.
                      */
+                    uaccess_leave_open(cpu, &win, ra);
                     probe_access(env, a, 0, access_type, fault_idx, ra);
+                    /* not raised after all: still ours */
+                    cpu->uaccess_pend.valid = false;
                     flags = probe_access_full_mmu(env, a, 0, access_type,
                                                   mmu_idx, &host, &full);
                     if (flags & TLB_INVALID_MASK) {
@@ -411,9 +465,7 @@ static int vaddr_ranges_fault(VaddrRange *r, size_t n,
             }
         }
     }
-    if (window) {
-        window(cpu, false);
-    }
+    uaccess_close(cpu, &win);
     return ret;
 }
 
diff --git a/target/arm/cpu.c b/target/arm/cpu.c
