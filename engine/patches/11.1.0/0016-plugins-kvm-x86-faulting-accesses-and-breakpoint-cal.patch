From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Wed, 7 Oct 2026 15:49:21 -0400
Subject: [PATCH] plugins, kvm/x86: faulting accesses and breakpoint callbacks
 under KVM

Under KVM there is no softmmu TLB and no instruction callback, so:

- qemu_plugin_{read,write}_memory_vaddr_fault() take a hardware path
  (QemuPluginHwOps): the target walks the guest page tables itself and,
  on a miss, queues the fault through the vCPU events; the guest takes it
  at the hooked instruction and re-executes it, exactly as under TCG.
  x86: 4/5-level walk with U/W/SMAP/WP checks, #PF with the error code
  a load or store there would get, EFLAGS.AC window under SMAP.
- qemu_plugin_register_vcpu_bp_cb() / qemu_plugin_hw_breakpoint_insert():
  hardware execution breakpoints (DR0-3), and guest int3s QEMU did not
  plant, run a plugin callback with RW_REGS_PC semantics; set_pc() and
  the faulting accessors unwind to it.  A consumed hardware breakpoint
  resumes with RF set; a consumed int3 is skipped.
- KVM delivers a fault with RF set in the saved RFLAGS (as the CPU does),
  which would resume the hooked instruction past its breakpoint: the vCPU
  is stopped at the #PF handler's first instruction and RF is cleared in
  the frame.
- Light sync: the callback gets GPRs and sregs (3-5 ioctls per event, not
  ~22); avoid cpu_memory_rw_debug(), which syncs the whole vCPU and would
  discard what the callback queued.

Plugin vcpu_init callbacks still do not run under KVM.

Vendored source: src/include/qemu/plugin-hw.h.
---
 include/plugins/qemu-plugin.h |  58 +++++++
 plugins/api-system.c          | 149 ++++++++++++++++++
 plugins/api-user.c            |  11 ++
 target/i386/kvm/kvm.c         | 281 +++++++++++++++++++++++++++++++++-
 4 files changed, 498 insertions(+), 1 deletion(-)

diff --git a/include/plugins/qemu-plugin.h b/include/plugins/qemu-plugin.h
index a7d4b19a26f1c80b66ebef69a4d6ce1fc359f6e5..c174ec45a50eb5f61a8e4cc2894c56b916e2174c 100644
--- a/include/plugins/qemu-plugin.h
+++ b/include/plugins/qemu-plugin.h
@@ -1221,6 +1221,64 @@ int qemu_plugin_write_memory_vaddr_fault(uint64_t addr, GByteArray *data,
                                          enum qemu_plugin_vaddr_mode mode,
                                          bool fault);
 
+/**
+ * typedef qemu_plugin_vcpu_bp_cb_t - breakpoint callback
+ *
+ * @vcpu_index: the vCPU
+ * @pc: guest virtual address of the instruction about to execute
+ * @sw: true for a guest software breakpoint instruction (x86 int3) that
+ *      QEMU did not plant; false for a breakpoint requested with
+ *      qemu_plugin_hw_breakpoint_insert()
+ * @userdata: from registration
+ *
+ * For accelerators without instrumentation (KVM), where instruction
+ * callbacks never run.  The callback runs like an instruction callback
+ * registered with QEMU_PLUGIN_CB_RW_REGS_PC: registers can be read and
+ * written, qemu_plugin_set_pc() works, and the faulting memory accessors
+ * may raise a guest fault, after which the guest re-executes the
+ * instruction at @pc and the callback runs again.
+ *
+ * Returns true if the plugin consumed the event.  The guest then resumes
+ * at its (possibly changed) PC; if the PC is unchanged and no fault was
+ * raised, it executes the instruction at @pc (the hardware breakpoint does
+ * not re-trigger) or, for @sw, skips the breakpoint instruction.  Returns
+ * false to leave the event to QEMU: a stray @sw breakpoint is delivered to
+ * the guest.
+ */
+typedef bool (*qemu_plugin_vcpu_bp_cb_t)(unsigned int vcpu_index,
+                                         uint64_t pc, bool sw,
+                                         void *userdata);
+
+/**
+ * qemu_plugin_register_vcpu_bp_cb() - receive breakpoint events (KVM)
+ *
+ * @id: plugin ID
+ * @cb: callback
+ * @userdata: passed to @cb
+ *
+ * Also routes guest software breakpoint instructions to @cb.  One callback
+ * per QEMU instance.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_vcpu_bp_cb(qemu_plugin_id_t id,
+                                     qemu_plugin_vcpu_bp_cb_t cb,
+                                     void *userdata);
+
+/**
+ * qemu_plugin_hw_breakpoint_insert() - stop before @vaddr executes (KVM)
+ *
+ * @vaddr: guest virtual address of an instruction
+ *
+ * A hardware execution breakpoint, reported to the callback registered
+ * with qemu_plugin_register_vcpu_bp_cb().  KVM on x86 only (four in all,
+ * shared with gdbstub); no effect under TCG, where instruction callbacks
+ * do the job.  Call before the vCPUs run, e.g. from qemu_plugin_install().
+ *
+ * Returns 0, or a negative errno.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_hw_breakpoint_insert(uint64_t vaddr);
+
 /**
  * qemu_plugin_set_pc() - set the program counter for the current vCPU
  *
diff --git a/plugins/api-system.c b/plugins/api-system.c
index 8480a5a5c70e00db55129ba5db53d2742ae7a825..76a2844617e15422dd5d80d636f826446ea129b4 100644
--- a/plugins/api-system.c
+++ b/plugins/api-system.c
@@ -22,6 +22,9 @@
 #include "accel/tcg/cpu-mmu-index.h"
 #include "exec/target_page.h"
 #include "exec/tlb-flags.h"
+#include "qemu/plugin-hw.h"
+#include "system/memory.h"
+#include "system/tcg.h"
 
 /*
  * In system mode we cannot trace the binary being executed so the
@@ -139,6 +142,149 @@ void qemu_plugin_update_ns(const void *handle, int64_t new_time)
  * Consistent virtual memory access
  */
 
+/*
+ * Accelerators without a softmmu TLB (KVM): the target walks the guest page
+ * tables itself and queues the guest fault; breakpoints stand in for
+ * instruction callbacks.
+ */
+static const QemuPluginHwOps *hw_ops;
+static qemu_plugin_vcpu_bp_cb_t bp_cb;
+static void *bp_udata;
+static uint64_t hw_bps[4];
+static int n_hw_bps;
+/* Inside qemu_plugin_vcpu_bp() on this thread: cpu->jmp_env is ours */
+static __thread bool bp_armed;
+
+void qemu_plugin_set_hw_ops(const QemuPluginHwOps *ops)
+{
+    hw_ops = ops;
+}
+
+bool qemu_plugin_bp_enabled(void)
+{
+    return bp_cb;
+}
+
+const uint64_t *qemu_plugin_hw_breakpoints(int *n)
+{
+    *n = n_hw_bps;
+    return hw_bps;
+}
+
+bool qemu_plugin_is_hw_breakpoint(uint64_t pc)
+{
+    for (int i = 0; i < n_hw_bps; i++) {
+        if (hw_bps[i] == pc) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void qemu_plugin_register_vcpu_bp_cb(qemu_plugin_id_t id,
+                                     qemu_plugin_vcpu_bp_cb_t cb,
+                                     void *userdata)
+{
+    bp_cb = cb;
+    bp_udata = userdata;
+}
+
+int qemu_plugin_hw_breakpoint_insert(uint64_t vaddr)
+{
+    if (n_hw_bps == ARRAY_SIZE(hw_bps)) {
+        return -ENOBUFS;
+    }
+    hw_bps[n_hw_bps++] = vaddr;
+    return 0;
+}
+
+bool qemu_plugin_vcpu_bp(CPUState *cpu, uint64_t pc, bool sw)
+{
+    volatile bool handled = true;
+
+    if (!bp_cb) {
+        return false;
+    }
+    qemu_plugin_set_cb_flags(cpu, QEMU_PLUGIN_CB_RW_REGS_PC);
+    bp_armed = true;
+    if (sigsetjmp(cpu->jmp_env, 0) == 0) {
+        handled = bp_cb(cpu->cpu_index, pc, sw, bp_udata);
+    }
+    /* else qemu_plugin_set_pc(), or a guest fault was queued */
+    bp_armed = false;
+    qemu_plugin_set_cb_flags(cpu, QEMU_PLUGIN_CB_NO_REGS);
+    return handled;
+}
+
+static int vaddr_access_hw(CPUState *cpu, uint64_t addr, uint8_t *buf,
+                           size_t len, enum qemu_plugin_vaddr_mode mode,
+                           bool fault, MMUAccessType access_type)
+{
+    bool user = mode == QEMU_PLUGIN_VADDR_USER;
+    bool is_write = access_type == MMU_DATA_STORE;
+    size_t page_size = qemu_target_page_size();
+    int ret = QEMU_PLUGIN_VADDR_OK;
+
+    if (!hw_ops) {
+        return QEMU_PLUGIN_VADDR_BAD_MODE;
+    }
+    if (len == 0) {
+        return QEMU_PLUGIN_VADDR_UNMAPPED;
+    }
+    if (user && hw_ops->window) {
+        hw_ops->window(cpu, true);
+    }
+    for (int copy = 0; copy < 2 && ret == QEMU_PLUGIN_VADDR_OK; copy++) {
+        size_t done = 0;
+
+        while (done < len) {
+            vaddr a = addr + done;
+            size_t chunk = MIN(len - done,
+                               page_size - (a & (page_size - 1)));
+            hwaddr phys, xlat, l = chunk;
+            MemoryRegion *mr;
+            uint64_t f;
+            int t = hw_ops->translate(cpu, a, access_type, user, &phys, &f);
+
+            if (t > 0 && fault && bp_armed) {
+                /*
+                 * As under TCG: the guest takes the fault a load or store
+                 * at this instruction would, resolves it and re-executes
+                 * the instruction, which re-runs the breakpoint callback.
+                 */
+                hw_ops->raise(cpu, a, f);
+                siglongjmp(cpu->jmp_env, 1);
+            }
+            if (t != 0) {
+                ret = QEMU_PLUGIN_VADDR_UNMAPPED;
+                break;
+            }
+            WITH_RCU_READ_LOCK_GUARD() {
+                mr = address_space_translate(cpu->as, phys, &xlat, &l,
+                                             is_write,
+                                             MEMTXATTRS_UNSPECIFIED);
+                if (!memory_region_is_ram(mr) || memory_region_is_romd(mr) ||
+                    (is_write && memory_region_is_rom(mr)) || l < chunk) {
+                    /* Not RAM: an access could have device side effects. */
+                    ret = QEMU_PLUGIN_VADDR_IO;
+                }
+            }
+            if (ret != QEMU_PLUGIN_VADDR_OK) {
+                break;
+            }
+            if (copy) {
+                address_space_rw(cpu->as, phys, MEMTXATTRS_UNSPECIFIED,
+                                 buf + done, chunk, is_write);
+            }
+            done += chunk;
+        }
+    }
+    if (user && hw_ops->window) {
+        hw_ops->window(cpu, false);
+    }
+    return ret;
+}
+
 /*
  * Make every page of [addr, addr + len) accessible for @access_type, then
  * copy.  Checking all pages before copying anything means a fault on a
@@ -156,6 +302,9 @@ static int vaddr_access_fault(uint64_t addr, uint8_t *buf, size_t len,
     int mmu_idx, fault_idx, ret = QEMU_PLUGIN_VADDR_OK;
 
     g_assert(cpu);
+    if (!tcg_enabled()) {
+        return vaddr_access_hw(cpu, addr, buf, len, mode, fault, access_type);
+    }
     env = cpu_env(cpu);
 
     if (len == 0) {
diff --git a/plugins/api-user.c b/plugins/api-user.c
index e6619196b69888ae4ddffae73315043f78a572ae..ee6c5b78171ebd70cb6476d0378e90cf80d6b8d6 100644
--- a/plugins/api-user.c
+++ b/plugins/api-user.c
@@ -70,3 +70,14 @@ int qemu_plugin_write_memory_vaddr_fault(uint64_t addr, GByteArray *data,
 {
     return QEMU_PLUGIN_VADDR_BAD_MODE;
 }
+
+void qemu_plugin_register_vcpu_bp_cb(qemu_plugin_id_t id,
+                                     qemu_plugin_vcpu_bp_cb_t cb,
+                                     void *userdata)
+{
+}
+
+int qemu_plugin_hw_breakpoint_insert(uint64_t vaddr)
+{
+    return -ENOTSUP;
+}
diff --git a/target/i386/kvm/kvm.c b/target/i386/kvm/kvm.c
index b5d9c18bd76f26562bffe6688cb535a9b163d3ff..fbe7b77444153f3b09d38162d7ccfd324447dd62 100644
--- a/target/i386/kvm/kvm.c
+++ b/target/i386/kvm/kvm.c
@@ -72,6 +72,7 @@
 #include "exec/memattrs.h"
 #include "exec/target_page.h"
 #include "trace.h"
+#include "qemu/plugin-hw.h"
 
 #include CONFIG_DEVICES
 
@@ -3451,6 +3452,134 @@ static int xen_init(MachineState *ms, KVMState *s)
 #endif
 }
 
+/*
+ * Plugin guest-memory access under KVM (see qemu/plugin-hw.h): walk the
+ * guest page tables as the MMU would, and hand misses to the guest as #PF.
+ */
+static int kvm_plugin_translate(CPUState *cs, vaddr addr,
+                                MMUAccessType access_type, bool user,
+                                hwaddr *phys, uint64_t *fault)
+{
+    CPUX86State *env = &X86_CPU(cs)->env;
+    bool cpl3 = (env->hflags & HF_CPL_MASK) == 3;
+    bool as_user = user || cpl3;
+    bool wr = access_type == MMU_DATA_STORE;
+    /* the error code of a fault taken at this instruction */
+    uint32_t err = (wr ? PG_ERROR_W_MASK : 0) | (cpl3 ? PG_ERROR_U_MASK : 0);
+    bool us = true, rw = true;
+    int levels, shift = 12;
+    hwaddr table;
+
+    if (!(env->cr[0] & CR0_PG_MASK)) {
+        *phys = addr;
+        return 0;
+    }
+    if (!(env->hflags & HF_LMA_MASK)) {
+        return -1;                      /* legacy paging: not implemented */
+    }
+    levels = (env->cr[4] & CR4_LA57_MASK) ? 5 : 4;
+    if ((int64_t)addr >> (levels * 9 + 11) != (int64_t)addr >> 63) {
+        return -1;                      /* non-canonical: #GP, not #PF */
+    }
+    table = env->cr[3] & PG_ADDRESS_MASK;
+    for (int lvl = levels; lvl >= 1; lvl--) {
+        uint64_t pte;
+
+        shift = 12 + 9 * (lvl - 1);
+        pte = x86_ldq_phys(cs, table + (((addr >> shift) & 0x1ff) << 3));
+        if (!(pte & PG_PRESENT_MASK)) {
+            *fault = err;
+            return 1;
+        }
+        us &= !!(pte & PG_USER_MASK);
+        rw &= !!(pte & PG_RW_MASK);
+        table = pte & PG_ADDRESS_MASK;
+        if ((lvl == 2 || lvl == 3) && (pte & PG_PSE_MASK)) {
+            table &= ~(((hwaddr)1 << shift) - 1);
+            break;
+        }
+        shift = 12;
+    }
+    *phys = table | (addr & (((hwaddr)1 << shift) - 1));
+
+    err |= PG_ERROR_P_MASK;
+    if (as_user && !us) {
+        return -1;      /* supervisor page: no fault grants a user access */
+    }
+    if (!as_user && us && (env->cr[4] & CR4_SMAP_MASK) &&
+        !(env->eflags & AC_MASK)) {
+        *fault = err;   /* SMAP, as a supervisor access here would fault */
+        return 1;
+    }
+    if (wr && !rw && (as_user || (env->cr[0] & CR0_WP_MASK))) {
+        *fault = err;   /* copy-on-write, dirty tracking, or read-only */
+        return 1;
+    }
+    return 0;
+}
+
+/*
+ * Supervisor access to [addr, addr + len) within one page, without
+ * cpu_memory_rw_debug(): that syncs the whole vCPU, discarding what a
+ * plugin callback queued in env under the light sync.
+ */
+static bool kvm_plugin_rw_virt(CPUState *cs, vaddr addr, void *buf, int len,
+                               bool is_write)
+{
+    hwaddr pa;
+    uint64_t f;
+
+    if (kvm_plugin_translate(cs, addr, is_write ? MMU_DATA_STORE
+                                                : MMU_DATA_LOAD,
+                             false, &pa, &f)) {
+        return false;
+    }
+    return address_space_rw(cs->as, pa, MEMTXATTRS_UNSPECIFIED, buf, len,
+                            is_write) == MEMTX_OK;
+}
+
+static __thread bool plugin_raised;
+
+static int kvm_get_vcpu_events(X86CPU *cpu);
+
+static void kvm_plugin_raise(CPUState *cs, vaddr addr, uint64_t fault)
+{
+    CPUX86State *env = &X86_CPU(cs)->env;
+
+    if (!cs->vcpu_dirty) {
+        kvm_get_vcpu_events(X86_CPU(cs));  /* light sync: not fetched yet */
+    }
+    plugin_raised = true;
+    kvm_queue_exception(env, EXCP0E_PAGE, 1, addr);
+    env->has_error_code = 1;
+    env->error_code = fault;
+}
+
+/* As x86_cpu_user_access_window() under TCG: stac/clac around the access */
+static void kvm_plugin_window(CPUState *cs, bool open)
+{
+    X86CPU *cpu = X86_CPU(cs);
+    CPUX86State *env = &cpu->env;
+
+    if (open) {
+        if ((env->hflags & HF_CPL_MASK) == 3 ||
+            !(env->cr[4] & CR4_SMAP_MASK) || (env->eflags & AC_MASK)) {
+            return;
+        }
+        env->eflags |= AC_MASK;
+        cpu->uaccess_open = true;
+    } else if (cpu->uaccess_open) {
+        env->eflags &= ~AC_MASK;
+        cpu->uaccess_open = false;
+    }
+}
+
+static const QemuPluginHwOps kvm_plugin_hw_ops = {
+    .translate = kvm_plugin_translate,
+    .raise = kvm_plugin_raise,
+    .window = kvm_plugin_window,
+};
+
 int kvm_arch_init(MachineState *ms, KVMState *s)
 {
     int ret;
@@ -3461,6 +3590,8 @@ int kvm_arch_init(MachineState *ms, KVMState *s)
     /*
      * Initialize confidential guest (SEV/TDX) context, if required
      */
+    qemu_plugin_set_hw_ops(&kvm_plugin_hw_ops);
+
     if (ms->cgs) {
         ret = confidential_guest_kvm_init(ms->cgs, &local_err);
         if (ret < 0) {
@@ -5913,11 +6044,19 @@ int kvm_arch_get_registers(CPUState *cs, Error **errp)
     return ret;
 }
 
+static void kvm_plugin_debug_init(CPUState *cs);
+
 void kvm_arch_pre_run(CPUState *cpu, struct kvm_run *run)
 {
     X86CPU *x86_cpu = X86_CPU(cpu);
     CPUX86State *env = &x86_cpu->env;
     int ret;
+    static __thread bool plugin_debug_set;
+
+    if (!plugin_debug_set && qemu_plugin_bp_enabled()) {
+        kvm_plugin_debug_init(cpu);
+        plugin_debug_set = true;
+    }
 
     /* Inject NMI */
     if (cpu_test_interrupt(cpu, CPU_INTERRUPT_NMI | CPU_INTERRUPT_SMI)) {
@@ -6254,6 +6393,142 @@ void kvm_arch_remove_all_gdbstub_hw_breakpoints(void)
 
 static CPUWatchpoint hw_watchpoint;
 
+/* #PF handler entry, while a plugin fault is being delivered on this vCPU */
+static __thread target_ulong pf_catch;
+
+/* Load the plugin breakpoints into this vCPU's debug state (vCPU thread). */
+static void kvm_plugin_debug_init(CPUState *cs)
+{
+    static gsize inserted;
+
+    if (g_once_init_enter(&inserted)) {
+        int n;
+        const uint64_t *bp = qemu_plugin_hw_breakpoints(&n);
+
+        for (int i = 0; i < n; i++) {
+            /* shared with gdbstub's hardware breakpoints */
+            if (nb_hw_breakpoint == ARRAY_SIZE(hw_breakpoint)) {
+                warn_report("plugin breakpoint 0x%" PRIx64 " not set", bp[i]);
+                continue;
+            }
+            hw_breakpoint[nb_hw_breakpoint].addr = bp[i];
+            hw_breakpoint[nb_hw_breakpoint].len = 1;
+            hw_breakpoint[nb_hw_breakpoint].type = GDB_BREAKPOINT_HW;
+            nb_hw_breakpoint++;
+        }
+        g_once_init_leave(&inserted, 1);
+    }
+    kvm_update_guest_debug(cs, 0);
+}
+
+/*
+ * A plugin breakpoint, or a guest int3 that is not a gdbstub breakpoint:
+ * run the plugin callback.  Returns true if the plugin consumed the event.
+ */
+static bool kvm_plugin_debug(X86CPU *cpu, struct kvm_debug_exit_arch *arch_info)
+{
+    CPUState *cs = CPU(cpu);
+    CPUX86State *env = &cpu->env;
+    bool sw = false, hw = false, light, handled;
+    target_ulong eip;
+
+    if (!qemu_plugin_bp_enabled()) {
+        return false;
+    }
+    if (pf_catch && arch_info->exception == EXCP01_DB &&
+        (arch_info->dr6 & 1) && arch_info->pc == pf_catch) {
+        /* our #PF is being delivered: [err, rip, cs, rflags, rsp, ss] */
+        uint64_t fl;
+
+        if (!cs->vcpu_dirty) {
+            kvm_getput_regs(cpu, 0);
+        }
+        if (kvm_plugin_rw_virt(cs, env->regs[R_ESP] + 24, &fl, 8, false)) {
+            fl = cpu_to_le64(le64_to_cpu(fl) & ~(uint64_t)RF_MASK);
+            kvm_plugin_rw_virt(cs, env->regs[R_ESP] + 24, &fl, 8, true);
+        }
+        pf_catch = 0;
+        kvm_update_guest_debug(cs, 0);
+        return true;
+    }
+    if (arch_info->exception == EXCP03_INT3) {
+        sw = !kvm_find_sw_breakpoint(cs, arch_info->pc);
+    } else if (arch_info->exception == EXCP01_DB &&
+               !(arch_info->dr6 & DR6_BS)) {
+        for (int n = 0; n < nb_hw_breakpoint; n++) {
+            if ((arch_info->dr6 & (1 << n)) &&
+                hw_breakpoint[n].type == GDB_BREAKPOINT_HW &&
+                qemu_plugin_is_hw_breakpoint(hw_breakpoint[n].addr)) {
+                hw = true;
+            }
+        }
+    }
+    if (!sw && !hw) {
+        return false;
+    }
+    /*
+     * Light sync: the callback needs the GPRs and the paging state, not
+     * the whole vCPU (MSRs, XSAVE, ...: ~20 ioctls per exit).  Anything
+     * that syncs fully meanwhile makes env authoritative again.
+     */
+    light = !cs->vcpu_dirty;
+    if (light && (kvm_getput_regs(cpu, 0) ||
+                  (has_sregs2 ? kvm_get_sregs2(cpu) : kvm_get_sregs(cpu)))) {
+        cpu_synchronize_state(cs);
+        light = false;
+    }
+    plugin_raised = false;
+    eip = env->eip;
+    handled = qemu_plugin_vcpu_bp(cs, arch_info->pc, sw);
+    if (!handled) {
+        if (light && !cs->vcpu_dirty) {
+            kvm_getput_regs(cpu, 1);    /* the callback may have written */
+        }
+        return false;
+    }
+    if (hw && plugin_raised) {
+        /*
+         * KVM delivers the fault with RF set in the saved RFLAGS, as the
+         * CPU does for faults, so the guest would resume the hooked
+         * instruction without its breakpoint and the callback would never
+         * run again.  Stop this vCPU at the first instruction of the #PF
+         * handler and clear RF in the frame.  Nothing else executes on this
+         * vCPU in between, so its other breakpoints can be borrowed.
+         */
+        struct kvm_guest_debug dbg = {
+            .control = KVM_GUESTDBG_ENABLE | KVM_GUESTDBG_USE_HW_BP |
+                       KVM_GUESTDBG_USE_SW_BP,
+        };
+        uint8_t g[16];
+
+        if (kvm_plugin_rw_virt(cs, env->idt.base + EXCP0E_PAGE * 16, g,
+                               sizeof(g), false)) {
+            pf_catch = lduw_le_p(g) | (uint64_t)lduw_le_p(g + 6) << 16 |
