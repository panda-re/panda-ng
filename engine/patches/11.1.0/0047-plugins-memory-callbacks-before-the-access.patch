diff --git a/accel/tcg/plugin-gen.c b/accel/tcg/plugin-gen.c
index 5778330b9b8f5d167b6a47d6604690b53bdf91c6..9e6430bd6af81efb49b18e54f47fab916050c344 100644
--- a/accel/tcg/plugin-gen.c
+++ b/accel/tcg/plugin-gen.c
@@ -275,13 +275,13 @@ static void inject_mem_cb(struct qemu_plugin_dyn_cb *cb,
 {
     switch (cb->type) {
     case PLUGIN_CB_MEM_REGULAR:
-        if (rw & cb->regular.rw) {
+        if (plugin_mem_rw_match(cb->regular.rw, rw)) {
             gen_mem_cb(&cb->regular, meminfo, addr);
         }
         break;
     case PLUGIN_CB_INLINE_ADD_U64:
     case PLUGIN_CB_INLINE_STORE_U64:
-        if (rw & cb->inline_insn.rw) {
