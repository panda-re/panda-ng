@@ -173,8 +176,9 @@ uint64_t cpu_ldq_mmu(CPUArchState *env, vaddr addr,
     uint64_t ret;
 
     tcg_debug_assert((get_memop(oi) & MO_SIZE) == MO_64);
+    plugin_load_cb(env, addr, 0, 0, oi, QEMU_PLUGIN_MEM_BEFORE);
     ret = do_ld8_mmu(env_cpu(env), addr, oi, ra, MMU_DATA_LOAD);
-    plugin_load_cb(env, addr, ret, 0, oi);
+    plugin_load_cb(env, addr, ret, 0, oi, QEMU_PLUGIN_MEM_AFTER);
