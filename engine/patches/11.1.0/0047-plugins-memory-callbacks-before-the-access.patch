     ret = do_ld2_mmu(env_cpu(env), addr, oi, ra, MMU_DATA_LOAD);
-    plugin_load_cb(env, addr, ret, 0, oi);
+    plugin_load_cb(env, addr, ret, 0, oi, QEMU_PLUGIN_MEM_AFTER);
     return ret;
 }
 
@@ -162,8 +164,9 @@ uint32_t cpu_ldl_mmu(CPUArchState *env, vaddr addr,
     uint32_t ret;
 
     tcg_debug_assert((get_memop(oi) & MO_SIZE) == MO_32);
+    plugin_load_cb(env, addr, 0, 0, oi, QEMU_PLUGIN_MEM_BEFORE);
     ret = do_ld4_mmu(env_cpu(env), addr, oi, ra, MMU_DATA_LOAD);
-    plugin_load_cb(env, addr, ret, 0, oi);
+    plugin_load_cb(env, addr, ret, 0, oi, QEMU_PLUGIN_MEM_AFTER);
     return ret;
