     Int128 ret;
 
     tcg_debug_assert((get_memop(oi) & MO_SIZE) == MO_128);
+    plugin_load_cb(env, addr, 0, 0, oi, QEMU_PLUGIN_MEM_BEFORE);
     ret = do_ld16_mmu(env_cpu(env), addr, oi, ra);
-    plugin_load_cb(env, addr, int128_getlo(ret), int128_gethi(ret), oi);
+    plugin_load_cb(env, addr, int128_getlo(ret), int128_gethi(ret), oi, QEMU_PLUGIN_MEM_AFTER);
     return ret;
 }
 
@@ -196,50 +201,55 @@ Int128 cpu_ld16_mmu(CPUArchState *env, vaddr addr,
 static void plugin_store_cb(CPUArchState *env, vaddr addr,
                             uint64_t value_low,
                             uint64_t value_high,
-                            MemOpIdx oi)
+                            MemOpIdx oi, enum qemu_plugin_mem_rw rw)
 {
     if (cpu_plugin_mem_cbs_enabled(env_cpu(env))) {
         qemu_plugin_vcpu_mem_cb(env_cpu(env), addr,
