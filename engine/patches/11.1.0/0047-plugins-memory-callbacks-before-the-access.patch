+    plugin_store_cb(env, addr, val, 0, oi, QEMU_PLUGIN_MEM_BEFORE);
     do_st2_mmu(env_cpu(env), addr, val, oi, retaddr);
-    plugin_store_cb(env, addr, val, 0, oi);
+    plugin_store_cb(env, addr, val, 0, oi, QEMU_PLUGIN_MEM_AFTER);
 }
 
 void cpu_stl_mmu(CPUArchState *env, vaddr addr, uint32_t val,
                     MemOpIdx oi, uintptr_t retaddr)
 {
     tcg_debug_assert((get_memop(oi) & MO_SIZE) == MO_32);
+    plugin_store_cb(env, addr, val, 0, oi, QEMU_PLUGIN_MEM_BEFORE);
     do_st4_mmu(env_cpu(env), addr, val, oi, retaddr);
-    plugin_store_cb(env, addr, val, 0, oi);
+    plugin_store_cb(env, addr, val, 0, oi, QEMU_PLUGIN_MEM_AFTER);
 }
 
 void cpu_stq_mmu(CPUArchState *env, vaddr addr, uint64_t val,
                  MemOpIdx oi, uintptr_t retaddr)
 {
     tcg_debug_assert((get_memop(oi) & MO_SIZE) == MO_64);
+    plugin_store_cb(env, addr, val, 0, oi, QEMU_PLUGIN_MEM_BEFORE);
     do_st8_mmu(env_cpu(env), addr, val, oi, retaddr);
-    plugin_store_cb(env, addr, val, 0, oi);
+    plugin_store_cb(env, addr, val, 0, oi, QEMU_PLUGIN_MEM_AFTER);
 }
 
 void cpu_st16_mmu(CPUArchState *env, vaddr addr, Int128 val,
                   MemOpIdx oi, uintptr_t retaddr)
 {
     tcg_debug_assert((get_memop(oi) & MO_SIZE) == MO_128);
+    plugin_store_cb(env, addr, int128_getlo(val), int128_gethi(val), oi, QEMU_PLUGIN_MEM_BEFORE);
     do_st16_mmu(env_cpu(env), addr, val, oi, retaddr);
