From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: igloo <nix@local>
Date: Wed, 19 Aug 2026 23:02:41 -0400
Subject: [PATCH] target/arm: route guest hypercalls into Penguin

Same helper as the other targets. Unhandled hypercalls return the first
argument unchanged. Hooks both the A32/T32 and A64 translators; the A64 side
needs a decodetree entry as well.

Folds: 797f446cf8 (partial), d7f87bf73e (partial), 087a668076 (partial)
---
 target/arm/tcg/a64.decode      |  1 +
 target/arm/tcg/helper-defs.h   |  1 +
 target/arm/tcg/op_helper.c     | 15 +++++++++++++++
 target/arm/tcg/translate-a64.c |  9 +++++++++
 target/arm/tcg/translate.c     | 24 ++++++++++++++++++++++++
 5 files changed, 50 insertions(+)

diff --git a/target/arm/tcg/a64.decode b/target/arm/tcg/a64.decode
index b5de5d5a0279beec170af7cd29afba6ce992f29f..f6aff3a7c97b356d76b05619010ab06b447d7f39 100644
--- a/target/arm/tcg/a64.decode
+++ b/target/arm/tcg/a64.decode
@@ -314,6 +314,7 @@ MSR_i_SVCR      1101 0101 0000 0 011 0100 0 mask:2 imm:1 011 11111
 # same instruction as far as QEMU is concerned.
 # NB: op0 is bits [20:19], but op0=0b00 is other insns, so we have
 # to hand-decode it.
+PENGUIN         1101 0101 00 0   00 000 0101 0000 000 11111
 SYS             1101 0101 00 l:1 01 op1:3 crn:4 crm:4 op2:3 rt:5 op0=1
 SYS             1101 0101 00 l:1 10 op1:3 crn:4 crm:4 op2:3 rt:5 op0=2
 SYS             1101 0101 00 l:1 11 op1:3 crn:4 crm:4 op2:3 rt:5 op0=3
diff --git a/target/arm/tcg/helper-defs.h b/target/arm/tcg/helper-defs.h
index 0077aeb4e228bc69dff7111b110104b01c230400..350f54e2290e8dd3d162f43b7dc01b3ef1d90beb 100644
--- a/target/arm/tcg/helper-defs.h
+++ b/target/arm/tcg/helper-defs.h
@@ -60,6 +60,7 @@ DEF_HELPER_2(wfet, void, env, i32)
 DEF_HELPER_1(yield, void, env)
 DEF_HELPER_1(pre_hvc, void, env)
 DEF_HELPER_2(pre_smc, void, env, i32)
+DEF_HELPER_7(penguin_guest_hypercall, i64, env, i64, i64, i64, i64, i64, i64)
 DEF_HELPER_1(vesb, void, env)
 DEF_HELPER_1(sev, void, env)
 
diff --git a/target/arm/tcg/op_helper.c b/target/arm/tcg/op_helper.c
index c4433be2ed0ac6644e8a248b1b28839bb652ea7e..943e0129e6a02892383353a73b41bbec790ed6ea 100644
--- a/target/arm/tcg/op_helper.c
+++ b/target/arm/tcg/op_helper.c
@@ -26,6 +26,7 @@
 #include "accel/tcg/cpu-loop.h"
 #include "accel/tcg/probe.h"
 #include "cpregs.h"
+#include "system/penguin.h"
 
 #define SIGNBIT (uint32_t)0x80000000
 #define SIGNBIT64 ((uint64_t)1 << 63)
@@ -84,6 +85,20 @@ void raise_exception_ra(CPUARMState *env, uint32_t excp, uint64_t syndrome,
     raise_exception(env, excp, syndrome, target_el);
 }
 
+uint64_t HELPER(penguin_guest_hypercall)(CPUARMState *env, uint64_t nr,
+                                         uint64_t a0, uint64_t a1,
+                                         uint64_t a2, uint64_t a3,
+                                         uint64_t a4)
+{
+    CPUState *cs = env_cpu(env);
+    uint64_t ret = 0;
+
+    if (penguin_handle_guest_hypercall(cs, nr, a0, a1, a2, a3, a4, 0, &ret)) {
+        return ret;
+    }
+    return a0;
+}
+
 uint64_t HELPER(neon_tbl)(CPUARMState *env, uint32_t desc,
                           uint64_t ireg, uint64_t def)
 {
diff --git a/target/arm/tcg/translate-a64.c b/target/arm/tcg/translate-a64.c
index 1780490065e14fe81fe56513e24484c56f3a542f..8c5a6d9eafd162dd0768ca70f7b034e8cf29d79e 100644
--- a/target/arm/tcg/translate-a64.c
+++ b/target/arm/tcg/translate-a64.c
@@ -3278,6 +3278,15 @@ static bool trans_SYS(DisasContext *s, arg_SYS *a)
     return true;
 }
 
+static bool trans_PENGUIN(DisasContext *s, arg_PENGUIN *a)
+{
+    gen_helper_penguin_guest_hypercall(cpu_reg(s, 0), tcg_env,
+                                       cpu_reg(s, 8), cpu_reg(s, 0),
+                                       cpu_reg(s, 1), cpu_reg(s, 2),
+                                       cpu_reg(s, 3), cpu_reg(s, 4));
+    return true;
+}
+
 static bool trans_SVC(DisasContext *s, arg_i *a)
 {
     /*
diff --git a/target/arm/tcg/translate.c b/target/arm/tcg/translate.c
index 055f3c5b40371616aecf2c4a36cd220abed3bd38..74822d430dd95e10288ec0e33c2fd1685ae6df78 100644
--- a/target/arm/tcg/translate.c
+++ b/target/arm/tcg/translate.c
@@ -2345,6 +2345,30 @@ static bool valid_cp(DisasContext *s, int cp)
 
 static bool trans_MCR(DisasContext *s, arg_MCR *a)
 {
+    if (a->cp == 7 && a->opc1 == 0 && a->rt == 0 &&
+        a->crn == 0 && a->crm == 0 && a->opc2 == 0) {
+        TCGv_i64 nr = tcg_temp_new_i64();
+        TCGv_i64 a0 = tcg_temp_new_i64();
+        TCGv_i64 a1 = tcg_temp_new_i64();
+        TCGv_i64 a2 = tcg_temp_new_i64();
+        TCGv_i64 a3 = tcg_temp_new_i64();
+        TCGv_i64 a4 = tcg_temp_new_i64();
+        TCGv_i64 ret64 = tcg_temp_new_i64();
+        TCGv_i32 ret = tcg_temp_new_i32();
+
+        tcg_gen_extu_i32_i64(nr, load_reg(s, 7));
+        tcg_gen_extu_i32_i64(a0, load_reg(s, 0));
+        tcg_gen_extu_i32_i64(a1, load_reg(s, 1));
+        tcg_gen_extu_i32_i64(a2, load_reg(s, 2));
+        tcg_gen_extu_i32_i64(a3, load_reg(s, 3));
+        tcg_gen_extu_i32_i64(a4, load_reg(s, 4));
+        gen_helper_penguin_guest_hypercall(ret64, tcg_env, nr, a0, a1, a2,
+                                           a3, a4);
+        tcg_gen_extrl_i64_i32(ret, ret64);
+        store_reg(s, 0, ret);
+        return true;
+    }
+
     if (!valid_cp(s, a->cp)) {
         return false;
     }
