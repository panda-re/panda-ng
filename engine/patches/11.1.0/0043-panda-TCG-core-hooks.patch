From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Thu, 22 Oct 2026 10:11:20 -0400
Subject: [PATCH] panda: TCG core hooks

before/after_block_exec around cpu_tb_exec, before/after_block_translate around tb_gen_code,
before_handle_exception (a plugin may rewrite the exception), and panda_lookup_tb. The hooks
are empty inlines without --enable-panda (include/panda/hooks.h). From pandang 0004.
---
 accel/tcg/cpu-exec.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 758a0958e08f718dcd6550bc6536930174262768..7e66f40ef6ee24aaef4cb3bb909e6dc2ab416702 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -51,6 +51,8 @@
 #include "accel/tcg/iommu.h"
 #endif
 
+#include "panda/hooks.h"
+
 /* -icount align implementation. */
 
 typedef struct SyncClocks {
@@ -367,6 +369,18 @@ static inline bool check_for_breakpoints(CPUState *cpu, vaddr pc,
         check_for_breakpoints_slow(cpu, pc, cflags);
 }
 
+#ifdef CONFIG_PANDA
+TranslationBlock *panda_lookup_tb(CPUState *cpu, uint64_t pc);
+TranslationBlock *panda_lookup_tb(CPUState *cpu, uint64_t pc)
+{
+    TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+
+    s.cflags = curr_cflags(cpu);
+    s.pc = pc;
+    return tb_lookup(cpu, s);
+}
+#endif
+
 /**
  * helper_lookup_tb_ptr: quick check for next tb
  * @env: current cpu state
@@ -439,6 +453,8 @@ cpu_tb_exec(CPUState *cpu, TranslationBlock *itb, int *tb_exit)
         log_cpu_exec(log_pc(cpu, itb), cpu, itb);
     }
 
+    panda_callbacks_before_block_exec(cpu, itb);
+
     qemu_thread_jit_execute();
     ret = tcg_qemu_tb_exec(cpu_env(cpu), tb_ptr);
     cpu->neg.can_do_io = true;
@@ -454,6 +470,7 @@ cpu_tb_exec(CPUState *cpu, TranslationBlock *itb, int *tb_exit)
     last_tb = tcg_splitwx_to_rw((void *)(ret & ~TB_EXIT_MASK));
     *tb_exit = ret & TB_EXIT_MASK;
 
+    panda_callbacks_after_block_exec(cpu, itb, *tb_exit);
     trace_exec_tb_exit(last_tb, *tb_exit);
 
     if (*tb_exit > TB_EXIT_IDX1) {
@@ -591,7 +608,9 @@ void cpu_exec_step_atomic(CPUState *cpu)
         tb = tb_lookup(cpu, s);
         if (tb == NULL) {
             mmap_lock();
+            panda_callbacks_before_block_translate(cpu, s.pc);
             tb = tb_gen_code(cpu, s);
+            panda_callbacks_after_block_translate(cpu, tb);
             mmap_unlock();
         }
 
@@ -724,6 +743,13 @@ static inline bool cpu_handle_exception(CPUState *cpu, int *ret)
         cpu->exception_index = -1;
         return true;
     }
+    /* A PANDA plugin may rewrite the exception; re-dispatch the new one. */
+    int32_t exception = cpu->exception_index;
+
+    cpu->exception_index = panda_callbacks_before_handle_exception(cpu, exception);
+    if (exception != cpu->exception_index) {
+        return cpu_handle_exception(cpu, ret);
+    }
 
 #if defined(CONFIG_USER_ONLY)
     /*
@@ -985,7 +1011,9 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
                 uint32_t h;
 
                 mmap_lock();
+                panda_callbacks_before_block_translate(cpu, s.pc);
                 tb = tb_gen_code(cpu, s);
+                panda_callbacks_after_block_translate(cpu, tb);
                 mmap_unlock();
 
                 /*
