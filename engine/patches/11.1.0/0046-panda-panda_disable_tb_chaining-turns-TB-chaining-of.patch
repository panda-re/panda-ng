From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Thu, 22 Oct 2026 17:32:22 -0400
Subject: [PATCH] panda: panda_disable_tb_chaining turns TB chaining off

With chaining on, the before/after_block_exec callbacks in cpu_tb_exec run once per chain of
TBs, with the first TB. Off, curr_cflags asks for no goto_tb/goto_ptr, as -d nochain does,
so every TB returns to cpu_exec.
---
 accel/tcg/cpu-exec-common.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/accel/tcg/cpu-exec-common.c b/accel/tcg/cpu-exec-common.c
index 44e84344f3b37897c2158aa055b58f33f5f82d43..2a006fb20f04cf2c7c5df8471e120ff71c802f04 100644
--- a/accel/tcg/cpu-exec-common.c
+++ b/accel/tcg/cpu-exec-common.c
@@ -22,6 +22,7 @@
 #include "system/tcg.h"
 #include "qemu/plugin.h"
 #include "accel/tcg/cpu-loop.h"
+#include "panda/hooks.h"
 #include "internal-common.h"
 
 bool tcg_allowed;
@@ -53,6 +54,9 @@ uint32_t curr_cflags(CPUState *cpu)
         cflags |= CF_NO_GOTO_TB | 1;
     } else if (qemu_loglevel_mask(CPU_LOG_TB_NOCHAIN)) {
         cflags |= CF_NO_GOTO_TB;
+    } else if (!panda_tb_chaining_enabled()) {
+        /* PANDA: back to cpu_exec after every TB, for the per-TB block_exec callbacks. */
+        cflags |= CF_NO_GOTO_TB | CF_NO_GOTO_PTR;
     }
 
     return cflags;
