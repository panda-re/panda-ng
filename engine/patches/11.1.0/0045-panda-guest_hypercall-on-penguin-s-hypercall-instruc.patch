From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Thu, 22 Oct 2026 10:15:32 -0400
Subject: [PATCH] panda: guest_hypercall on penguin's hypercall instruction

When no penguin consumer takes a hypercall, offer it to PANDA's guest_hypercall callback. A
plugin that handles it sets the guest's registers itself, so the helper returns the current
value of its destination register (x0/r0 on arm, v0 on mips, r3 on ppc, a0 on loongarch and
riscv) instead of the one it read; x86 marks the vCPU dirty. Penguin's consumers keep priority.
Replaces pandang 0007, 0008, 0010, 0011, 0013-0015, which added PANDA's own hypercall
instructions (cpuid on x86, an MCR on arm): with this series the guest uses penguin's.
---
 hw/i386/pc.c                     | 5 +++++
 target/arm/tcg/op_helper.c       | 5 +++++
 target/loongarch/tcg/op_helper.c | 5 +++++
 target/mips/tcg/op_helper.c      | 5 +++++
 target/ppc/misc_helper.c         | 5 +++++
 target/riscv/tcg/op_helper.c     | 5 +++++
 6 files changed, 30 insertions(+)

diff --git a/hw/i386/pc.c b/hw/i386/pc.c
index 8f95fa7a85fd5097f954aed280c7e6d76103231e..e7997007170d7363891c97c000b88983c761682b 100644
--- a/hw/i386/pc.c
+++ b/hw/i386/pc.c
@@ -43,6 +43,7 @@
 #include "hw/audio/pcspk.h"
 #include "system/system.h"
 #include "system/penguin.h"
+#include "panda/hooks.h"
 #include "system/qtest.h"
 #include "system/xen.h"
 #include "system/reset.h"
@@ -248,6 +249,8 @@ static void ioport88_write(void *opaque, hwaddr addr, uint64_t data,
                                            &ret)) {
             env->regs[R_EAX] = ret;
             cs->vcpu_dirty = true;
+        } else if (panda_callbacks_guest_hypercall(cs)) {
+            cs->vcpu_dirty = true;
         }
         return;
     }
@@ -263,6 +266,8 @@ static void ioport88_write(void *opaque, hwaddr addr, uint64_t data,
                                        &ret)) {
         env->regs[R_EAX] = (uint32_t)ret;
         cs->vcpu_dirty = true;
+    } else if (panda_callbacks_guest_hypercall(cs)) {
+        cs->vcpu_dirty = true;
     }
 }
 
diff --git a/target/arm/tcg/op_helper.c b/target/arm/tcg/op_helper.c
index 9ffa6d0690f9e3bd20895f285e440bdbede81bd5..493cb42fd2681d7c7590a41e75833b17e238ff9c 100644
--- a/target/arm/tcg/op_helper.c
+++ b/target/arm/tcg/op_helper.c
@@ -27,6 +27,7 @@
 #include "accel/tcg/probe.h"
 #include "cpregs.h"
 #include "system/penguin.h"
+#include "panda/hooks.h"
 #ifndef CONFIG_USER_ONLY
 #include "system/syscall-trap.h"
 #endif
@@ -99,6 +100,10 @@ uint64_t HELPER(penguin_guest_hypercall)(CPUARMState *env, uint64_t nr,
     if (penguin_handle_guest_hypercall(cs, nr, a0, a1, a2, a3, a4, 0, &ret)) {
         return ret;
     }
+    /* No penguin consumer: offer it to PANDA, whose plugins set registers themselves */
+    if (panda_callbacks_guest_hypercall(cs)) {
+        return is_a64(env) ? env->xregs[0] : env->regs[0];
+    }
     return a0;
 }
 
diff --git a/target/loongarch/tcg/op_helper.c b/target/loongarch/tcg/op_helper.c
index 4db11a3d6f166083400cf0b3dce702bbedf58802..d76ee0f63e07b233a6663c88b460eb38ec0b4264 100644
--- a/target/loongarch/tcg/op_helper.c
+++ b/target/loongarch/tcg/op_helper.c
@@ -16,6 +16,7 @@
 #include <zlib.h> /* for crc32 */
 #include "cpu-csr.h"
 #include "system/penguin.h"
+#include "panda/hooks.h"
 
 /* Exceptions helpers */
 void helper_raise_exception(CPULoongArchState *env, uint32_t exception)
@@ -35,6 +36,10 @@ target_ulong helper_penguin_guest_hypercall(CPULoongArchState *env,
     if (penguin_handle_guest_hypercall(cs, nr, a0, a1, a2, a3, a4, 0, &ret)) {
         return ret;
     }
+    /* No penguin consumer: offer it to PANDA, whose plugins set registers themselves */
+    if (panda_callbacks_guest_hypercall(cs)) {
+        return env->gpr[4];
+    }
     return a0;
 }
 
diff --git a/target/mips/tcg/op_helper.c b/target/mips/tcg/op_helper.c
index 497eb25209d1ab924ad503f1be34d1ad275e7154..5a67badcbb5c2bdd6adfc53d3870f8c7d107a56d 100644
--- a/target/mips/tcg/op_helper.c
+++ b/target/mips/tcg/op_helper.c
@@ -27,6 +27,7 @@
 #include "qemu/crc32c.h"
 #include "qemu/timer.h"
 #include "system/penguin.h"
+#include "panda/hooks.h"
 #include <zlib.h>
 
 static inline target_ulong bitswap(target_ulong v)
@@ -63,6 +64,10 @@ target_ulong helper_penguin_guest_hypercall(CPUMIPSState *env, target_ulong nr,
     if (penguin_handle_guest_hypercall(cs, nr, a0, a1, a2, a3, a4, 0, &ret)) {
         return ret;
     }
+    /* No penguin consumer: offer it to PANDA, whose plugins set registers themselves */
+    if (panda_callbacks_guest_hypercall(cs)) {
+        return env->active_tc.gpr[2];
+    }
     return nr;
 }
 
