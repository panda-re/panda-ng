From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Wed, 21 Oct 2026 18:32:30 -0400
Subject: [PATCH] accel/tcg: rr-ready, launch a VM so that a recording can
 begin later

-accel tcg,rr-ready=on does at launch what x-rr-begin-record cannot do on a
running VM: the round-robin vCPU thread (thread=multi is refused, and so is
more than one vCPU), virtio-pci and virtio-mmio with ioeventfd off (devices
decide at realize, and stopping ioeventfd later drops kicks), and
x-tsc-vclock, so the x86 TSC keeps its rate when icount comes on.
Netdev filters and the blkreplay report are left to begin.

R1 of the panda-next plan.
---
 accel/tcg/tcg-all.c | 42 +++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 41 insertions(+), 1 deletion(-)

diff --git a/accel/tcg/tcg-all.c b/accel/tcg/tcg-all.c
index 71dd6d86e76ab63951262adee72efe24a270006b..aaa4dd8ab7314fb252eb2198fc04fd706f10a31f 100644
--- a/accel/tcg/tcg-all.c
+++ b/accel/tcg/tcg-all.c
@@ -36,6 +36,7 @@
 #include "qapi/qapi-builtin-visit.h"
 #include "qemu/units.h"
 #include "qemu/target-info.h"
+#include "qom/compat-properties.h"
 #ifndef CONFIG_USER_ONLY
 #include "hw/core/boards.h"
 #include "exec/tb-flush.h"
@@ -52,11 +53,14 @@ struct TCGState {
 
     OnOffAuto mttcg_enabled;
     bool one_insn_per_tb;
+    bool rr_ready;
     int splitwx_enabled;
     unsigned long tb_size;
 };
 typedef struct TCGState TCGState;
 
+extern bool tcg_tsc_vclock;             /* tcg-accel-ops.c */
+
 #define TYPE_TCG_ACCEL ACCEL_CLASS_NAME("tcg")
 
 DECLARE_INSTANCE_CHECKER(TCGState, TCG_STATE,
@@ -110,6 +114,27 @@ static int tcg_init_machine(AccelState *as, MachineState *ms)
     CPUClass *cc = CPU_CLASS(object_class_by_name(target_cpu_type()));
     bool mttcg_supported = cc->tcg_ops->mttcg_supported;
 
+    if (s->rr_ready) {
+        /*
+         * What x-rr-begin-record cannot change on a running VM: one vCPU
+         * thread, virtio kicks as MMIO exits rather than eventfds (devices
+         * choose at realize), and an x86 TSC that keeps its rate when
+         * icount comes on.
+         */
+        if (s->mttcg_enabled == ON_OFF_AUTO_ON) {
+            error_report("rr-ready needs thread=single");
+            return -1;
+        }
+        if (ms->smp.max_cpus > 1) {
+            error_report("rr-ready: record/replay supports one vCPU (-smp 1)");
+            return -1;
+        }
+        s->mttcg_enabled = ON_OFF_AUTO_OFF;
+        tcg_tsc_vclock = true;
+        object_register_sugar_prop("virtio-pci", "ioeventfd", "off", true);
+        object_register_sugar_prop("virtio-mmio", "ioeventfd", "off", true);
+    }
+
     switch (s->mttcg_enabled) {
     case ON_OFF_AUTO_AUTO:
         /*
@@ -256,7 +281,6 @@ static void tcg_set_one_insn_per_tb(Object *obj, bool value, Error **errp)
     qatomic_set(&one_insn_per_tb, value);
 }
 
-extern bool tcg_tsc_vclock;
 static bool tcg_get_tsc_vclock(Object *obj, Error **errp)
 {
     return tcg_tsc_vclock;
@@ -267,6 +291,16 @@ static void tcg_set_tsc_vclock(Object *obj, bool value, Error **errp)
     tcg_tsc_vclock = value;
 }
 
+static bool tcg_get_rr_ready(Object *obj, Error **errp)
+{
+    return TCG_STATE(obj)->rr_ready;
+}
+
+static void tcg_set_rr_ready(Object *obj, bool value, Error **errp)
+{
+    TCG_STATE(obj)->rr_ready = value;
+}
+
 static void tcg_accel_class_init(ObjectClass *oc, const void *data)
 {
     AccelClass *ac = ACCEL_CLASS(oc);
@@ -302,6 +336,12 @@ static void tcg_accel_class_init(ObjectClass *oc, const void *data)
                                    tcg_get_tsc_vclock, tcg_set_tsc_vclock);
     object_class_property_set_description(oc, "x-tsc-vclock",
         "rrux: elapsed ticks (x86 TSC) follow the virtual clock without icount");
+
+    object_class_property_add_bool(oc, "rr-ready",
+                                   tcg_get_rr_ready, tcg_set_rr_ready);
+    object_class_property_set_description(oc, "rr-ready",
+        "Launch so that x-rr-begin-record can start a recording later: "
+        "one TCG thread, virtio ioeventfd off, x-tsc-vclock");
 }
 
 static const TypeInfo tcg_accel_type = {
