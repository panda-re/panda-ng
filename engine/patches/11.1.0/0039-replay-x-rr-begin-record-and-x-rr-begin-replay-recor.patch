 accel/tcg/tcg-accel-ops.c |  32 ++--
 include/exec/icount.h     |   6 +
 qapi/replay.json          |  75 ++++++++
 replay/meson.build        |   1 +
 replay/replay-begin.c     | 350 ++++++++++++++++++++++++++++++++++++++
 replay/replay-internal.h  |   6 +
 replay/replay.c           |  26 +++
 replay/stubs-system.c     |  16 ++
