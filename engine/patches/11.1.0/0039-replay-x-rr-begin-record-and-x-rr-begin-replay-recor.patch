diff --git a/accel/tcg/icount-common.c b/accel/tcg/icount-common.c
index b1b6c005fe71fefb29f302f114d3b7a086cf4a52..3e8d226db72b6e2c684969c5fbb521407e175dd1 100644
--- a/accel/tcg/icount-common.c
+++ b/accel/tcg/icount-common.c
@@ -37,6 +37,10 @@
 #include "hw/core/cpu.h"
 #include "exec/icount.h"
 #include "system/cpu-timers-internal.h"
+#include "system/cpu-timers.h"
+#include "system/tcg.h"
+#include "exec/tb-flush.h"
+#include "exec/translation-block.h"
 
 /*
  * ICOUNT: Instruction Counter
@@ -500,3 +504,101 @@ void icount_notify_exit(void)
         qemu_clock_notify(QEMU_CLOCK_VIRTUAL);
     }
 }
+
+/* Reset every vCPU's icount state and drop TBs translated for the old mode. */
+static void icount_switch_vcpus(bool on)
+{
+    CPUState *cpu;
+
+    tcg_accel_ops_set_icount(on);
+    CPU_FOREACH(cpu) {
+        if (on) {
+            tcg_cflags_set(cpu, CF_USE_ICOUNT);
+        } else {
+            cpu->tcg_cflags &= ~CF_USE_ICOUNT;
+        }
+        cpu->cflags_next_tb = -1;
+        cpu->icount_budget = 0;
+        cpu->icount_extra = 0;
+        cpu->neg.icount_decr.u16.low = 0;
+    }
+    tb_flush__exclusive_or_serial();
+}
+
+/*
+ * Switch a TCG VM that was started without icount to icount, at run time
+ * (x-rr-begin-record).  The VM must be stopped and use the round-robin vCPU
+ * thread (-accel tcg,thread=single).  The guest's virtual clock continues
+ * from where it stopped: qemu_icount restarts at 0 and the bias carries the
+ * time.
+ */
+bool icount_enable_runtime(QemuOpts *opts, Error **errp)
+{
+    int64_t vclock;
+
+    if (icount_enabled()) {
+        error_setg(errp, "icount is already enabled");
+        return false;
+    }
+    if (!tcg_enabled()) {
+        error_setg(errp, "icount needs TCG");
+        return false;
+    }
+    if (qemu_tcg_mttcg_enabled()) {
+        error_setg(errp, "icount needs the round-robin TCG vCPU thread: "
+                   "start the VM with -accel tcg,thread=single");
+        return false;
+    }
+    if (runstate_is_running()) {
+        error_setg(errp, "stop the VM first");
+        return false;
+    }
+    vclock = cpu_get_clock();
+    if (!icount_configure(opts, errp)) {
+        return false;
+    }
+    if (!icount_enabled()) {
+        error_setg(errp, "icount options need shift=");
+        return false;
+    }
+    qatomic_set(&timers_state.qemu_icount, 0);
+    qatomic_set(&timers_state.qemu_icount_bias, vclock);
+    icount_switch_vcpus(true);
+    return true;
+}
+
+/*
+ * The reverse, after a recording ends (x-rr-end-record): the stopped VM goes
+ * back to the host-driven virtual clock, continuing from the icount time.
+ */
+bool icount_disable_runtime(Error **errp)
+{
+    int64_t vclock;
+
+    if (!icount_enabled()) {
+        error_setg(errp, "icount is not enabled");
+        return false;
+    }
+    if (runstate_is_running()) {
+        error_setg(errp, "stop the VM first");
+        return false;
+    }
+    vclock = icount_get();
+    timer_free(timers_state.icount_warp_timer);
+    timer_free(timers_state.icount_rt_timer);
+    timer_free(timers_state.icount_vm_timer);
+    timers_state.icount_warp_timer = NULL;
+    timers_state.icount_rt_timer = NULL;
+    timers_state.icount_vm_timer = NULL;
+    timers_state.vm_clock_warp_start = -1;
+    use_icount = ICOUNT_DISABLED;
+
+    /* stopped, cpu_get_clock() is cpu_clock_offset: resume from vclock */
+    seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                       &timers_state.vm_clock_lock);
+    timers_state.cpu_clock_offset = vclock;
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                         &timers_state.vm_clock_lock);
+    icount_switch_vcpus(false);
+    return true;
+}
diff --git a/accel/tcg/tcg-accel-ops.c b/accel/tcg/tcg-accel-ops.c
index 7668e55254a462fd0b4539e85119ca632314a81c..0ff08bc7046179ba89206db1ec450bc2a97624a7 100644
--- a/accel/tcg/tcg-accel-ops.c
+++ b/accel/tcg/tcg-accel-ops.c
@@ -50,6 +50,7 @@
 #include "tcg-accel-ops-rr.h"
 #include "tcg-accel-ops-icount.h"
 #include "system/cpu-timers.h"
+#include "qemu/accel.h"
 
 /* common functionality among all TCG variants */
 
@@ -204,6 +205,26 @@ static void tcg_remove_all_gdbstub_breakpoints(CPUState *cpu)
  * so they keep their value and rate across a later switch to icount. */
 bool tcg_tsc_vclock;
 
+/* The round-robin ops that depend on icount. */
+static void rr_ops_set_icount(AccelOpsClass *ops, bool on)
+{
+    if (on) {
+        ops->handle_interrupt = icount_handle_interrupt;
+        ops->get_virtual_clock = icount_get;
+        ops->get_elapsed_ticks = icount_get;
+    } else {
+        ops->handle_interrupt = tcg_handle_interrupt;
+        ops->get_virtual_clock = NULL;
+        ops->get_elapsed_ticks = tcg_tsc_vclock ? cpu_get_clock : NULL;
+    }
+}
+
+/* icount switched on or off after machine init (replay/replay-begin.c) */
+void tcg_accel_ops_set_icount(bool on)
+{
+    rr_ops_set_icount(ACCEL_GET_CLASS(current_accel())->ops, on);
+}
+
 static void tcg_accel_ops_init(AccelClass *ac)
 {
     AccelOpsClass *ops = ac->ops;
@@ -216,16 +237,7 @@ static void tcg_accel_ops_init(AccelClass *ac)
         ops->create_vcpu_thread = rr_start_vcpu_thread;
         ops->kick_vcpu_thread = rr_kick_vcpu_thread;
 
-        if (icount_enabled()) {
-            ops->handle_interrupt = icount_handle_interrupt;
-            ops->get_virtual_clock = icount_get;
-            ops->get_elapsed_ticks = icount_get;
-        } else {
-            ops->handle_interrupt = tcg_handle_interrupt;
-            if (tcg_tsc_vclock) {
-                ops->get_elapsed_ticks = cpu_get_clock;
-            }
-        }
+        rr_ops_set_icount(ops, icount_enabled());
     }
 
     ops->cpu_reset_hold = tcg_cpu_reset_hold;
diff --git a/include/exec/icount.h b/include/exec/icount.h
index 7a26b40084dbf8c14560607f3350b89b49fa41bd..4f84aa7e71e7ad1f1cd685a857b11c4ca1d9b5b5 100644
--- a/include/exec/icount.h
+++ b/include/exec/icount.h
@@ -65,6 +65,12 @@ int64_t icount_to_ns(int64_t icount);
  */
 bool icount_configure(QemuOpts *opts, Error **errp);
 
+/* switch a stopped, round-robin TCG VM to icount at run time, and back */
+bool icount_enable_runtime(QemuOpts *opts, Error **errp);
+bool icount_disable_runtime(Error **errp);
+/* the TCG ops that depend on icount (accel/tcg/tcg-accel-ops.c) */
+void tcg_accel_ops_set_icount(bool on);
+
 /* used by tcg vcpu thread to calc icount budget */
 int64_t icount_round(int64_t count);
 
diff --git a/qapi/replay.json b/qapi/replay.json
index ccf84da68efcd8061fed2eab29019d36538e4892..1325130ecdd21439063f85bb1cb515f5f8d08b63 100644
--- a/qapi/replay.json
+++ b/qapi/replay.json
@@ -120,3 +120,78 @@
 #     <- { "return": {} }
 ##
 { 'command': 'replay-seek', 'data': { 'icount': 'int' } }
+
+##
+# @RrBeginRecordInfo:
+#
+# What `x-rr-begin-record` set up.
+#
+# @icount: instruction count at the start of the recording
+#
+# @chardevs: chardevs journalled, in registration order
+#
+# @netfilters: netdevs that carry a filter-replay, in registration
+#     order
+#
+# @unrecorded: devices whose input is not journalled
+#
+# Since: 11.1
+##
+{ 'struct': 'RrBeginRecordInfo',
+  'data': { 'icount': 'int', 'chardevs': ['str'], 'netfilters': ['str'],
+            'unrecorded': ['str'] } }
+
+##
+# @x-rr-begin-record:
+#
+# Start recording a running VM: switch it to icount if needed, move
+# its devices onto their replay paths, save the internal snapshot
+# @snapshot and log to @file.  Replay with -icount
+# ...,rr=replay,rrfile=@file,rrsnapshot=@snapshot.
+#
+# @snapshot: internal snapshot saved at the start point
+#
+# @file: the replay log
+#
+# @icount: icount options when icount is off (default "shift=auto")
+#
+# @chardevs: chardev ids to journal (default: serialN and parallelN)
+#
+# Features:
+#
+# @unstable: experimental
+#
+# Since: 11.1
+##
+{ 'command': 'x-rr-begin-record',
+  'data': { 'snapshot': 'str', 'file': 'str', '*icount': 'str',
+            '*chardevs': ['str'] },
+  'returns': 'RrBeginRecordInfo',
+  'features': [ 'unstable' ] }
+
+##
+# @x-rr-begin-replay:
+#
+# Replay a recording made by `x-rr-begin-record`.  Start the VM with
+# the recording's command line and -S; this loads @snapshot, enters
+# replay mode and resumes.
+#
+# @snapshot: the snapshot the recording began at
+#
+# @file: the replay log
+#
+# @icount: icount options when icount is off (default "shift=auto")
+#
+# @chardevs: chardev ids to replay, as given to `x-rr-begin-record`
+#
+# Features:
+#
+# @unstable: experimental
+#
+# Since: 11.1
+##
+{ 'command': 'x-rr-begin-replay',
+  'data': { 'snapshot': 'str', 'file': 'str', '*icount': 'str',
+            '*chardevs': ['str'] },
+  'returns': 'RrBeginRecordInfo',
+  'features': [ 'unstable' ] }
