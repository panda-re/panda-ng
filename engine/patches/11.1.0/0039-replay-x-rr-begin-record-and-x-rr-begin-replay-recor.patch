diff --git a/replay/replay-begin.c b/replay/replay-begin.c
new file mode 100644
index 0000000000000000000000000000000000000000..514bfee2dc64fb8099d33867b481619907aa2a16
--- /dev/null
+++ b/replay/replay-begin.c
@@ -0,0 +1,350 @@
+/*
+ * Record/replay begun and ended on a running VM, PANDA style.
+ *
+ * x-rr-begin-record stops the VM, switches it to icount if it was started
+ * without (icount_enable_runtime), moves every replay-relevant device onto
+ * its replay path (chardevs journalled, filter-replay on every netdev; virtio
+ * ioeventfd must already be off), saves an internal snapshot as the start
+ * point, reloads it and opens the log.  x-rr-begin-replay does the same in a
+ * process started with -S and replays from the snapshot.
+ *
+ * Loading the start snapshot relies on run_on_cpu() handing the replay mutex
+ * to a vCPU while it waits (system/cpus.c), which drops and retakes the BQL.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-replay.h"
+#include "qemu/option.h"
+#include "qemu/config-file.h"
+#include "qom/object.h"
+#include "qom/object_interfaces.h"
+#include "system/replay.h"
+#include "system/runstate.h"
+#include "system/cpus.h"
+#include "exec/icount.h"
+#include "migration/snapshot.h"
+#include "chardev/char.h"
+#include "chardev/chardev-internal.h"
+#include "net/net.h"
+#include "net/filter.h"
+#include "system/block-backend.h"
+#include "block/block_int.h"
+#include "hw/virtio/virtio-pci.h"
+#include "hw/virtio/virtio-mmio.h"
+#include "replay-internal.h"
+
+#define MAX_NETDEVS 64
+
+/* icount was switched on by a begin command, so undoing it switches it off */
+static bool icount_by_begin;
+
+static bool want_chardev(const char *id, strList *explicit)
+{
+    strList *e;
+
+    for (e = explicit; e; e = e->next) {
+        if (!strcmp(e->value, id)) {
+            return true;
+        }
+    }
+    if (explicit) {
+        return false;
+    }
+    /* default: what a plain -serial/-parallel would have journalled */
+    return g_str_has_prefix(id, "serial") || g_str_has_prefix(id, "parallel");
+}
+
+typedef struct BeginCtx {
+    strList *explicit;
+    strList **chardevs;
+    Error **errp;
+} BeginCtx;
+
+static int begin_chardev(Object *obj, void *opaque)
+{
+    BeginCtx *c = opaque;
+    Chardev *chr = CHARDEV(obj);
+
+    if (!want_chardev(chr->label, c->explicit)) {
+        return 0;
+    }
+    if (CHARDEV_GET_CLASS(chr)->chr_ioctl) {
+        error_setg(c->errp, "chardev '%s': ioctl-capable backends (serial "
+                   "tty/pty-like) cannot be replayed", chr->label);
+        return -1;
+    }
+    /* registered after replay_enable_record(): it is a no-op in mode NONE */
+    QAPI_LIST_APPEND(c->chardevs, g_strdup(chr->label));
+    return 0;
+}
+
+static int ioeventfd_on(Object *obj, void *opaque)
+{
+    strList ***tail = opaque;
+    uint32_t flags = 0, bit = 0;
+
+    if (object_dynamic_cast(obj, TYPE_VIRTIO_PCI)) {
+        flags = VIRTIO_PCI(obj)->flags;
+        bit = VIRTIO_PCI_FLAG_USE_IOEVENTFD;
+    } else if (object_dynamic_cast(obj, TYPE_VIRTIO_MMIO)) {
+        flags = VIRTIO_MMIO(obj)->flags;
+        bit = VIRTIO_IOMMIO_FLAG_USE_IOEVENTFD;
+    }
+    if (flags & bit) {
+        /*
+         * Not fixable here: devices decide at realize whether they use
+         * ioeventfd (e.g. virtio-blk's ioeventfd_disabled), and stopping it
+         * afterwards makes virtio-blk drop kicks.  rr from boot clears the
+         * flag at realize (virtio-pci.c/virtio-mmio.c).
+         */
+        QAPI_LIST_APPEND(*tail, g_strdup_printf("%s (%s)",
+                         object_get_canonical_path(obj),
+                         object_get_typename(obj)));
+    }
+    return 0;
+}
+
+/*
+ * Everything begin-record and begin-replay do identically, so that the
+ * registration order of chardevs and network filters matches.
+ */
+static bool rr_prepare(RrBeginRecordInfo *info, const char *icount,
+                       strList *chardevs, Error **errp)
+{
+    NetClientState *ncs[MAX_NETDEVS];
+    strList *ioev = NULL, **ioev_tail = &ioev;
+    strList **nf_tail = &info->netfilters, **un_tail = &info->unrecorded;
+    BeginCtx ctx;
+    BlockBackend *blk;
+    int i, n;
+
+    object_child_foreach_recursive(object_get_root(), ioeventfd_on, &ioev_tail);
+    if (ioev) {
+        g_autoptr(GString) s = g_string_new("");
+        for (strList *e = ioev; e; e = e->next) {
+            g_string_append_printf(s, " %s", e->value);
+        }
+        error_setg(errp, "virtio transports with ioeventfd on (kicks would "
+                   "bypass the log; start the VM with -global "
+                   "<transport>.ioeventfd=off):%s", s->str);
+        qapi_free_strList(ioev);
+        return false;
+    }
+
+    if (!icount_enabled()) {
+        QemuOpts *opts = qemu_opts_parse(qemu_find_opts("icount"),
+                                         icount ? icount : "shift=auto",
+                                         false, errp);
+        if (!opts || !icount_enable_runtime(opts, errp)) {
+            return false;
+        }
+        icount_by_begin = true;
+    }
+
+    n = qemu_find_net_clients_except(NULL, ncs, NET_CLIENT_DRIVER_NIC,
+                                     MAX_NETDEVS);
+    for (i = 0; i < n && i < MAX_NETDEVS; i++) {
+        NetFilterState *nf;
+        bool has = false;
+
+        QTAILQ_FOREACH(nf, &ncs[i]->filters, next) {
+            if (object_dynamic_cast(OBJECT(nf), "filter-replay")) {
+                has = true;
+            }
+        }
+        if (!has) {
+            g_autofree char *id = g_strdup_printf("rr-filter-%s", ncs[i]->name);
+            Object *o = object_new_with_props("filter-replay",
+                                              object_get_objects_root(), id,
+                                              errp, "netdev", ncs[i]->name,
+                                              NULL);
+            if (!o) {
+                return false;
+            }
+        }
+        QAPI_LIST_APPEND(nf_tail, g_strdup(ncs[i]->name));
+    }
+
+    for (blk = blk_next(NULL); blk; blk = blk_next(blk)) {
+        BlockDriverState *bs = blk_bs(blk);
+        g_autofree char *dev = blk_get_attached_dev_id(blk);
+
+        if (!bs || !dev || !*dev || !blk_is_writable(blk)) {
+            continue;
+        }
+        if (!bs->drv || strcmp(bs->drv->format_name, "blkreplay")) {
+            QAPI_LIST_APPEND(un_tail,
+                g_strdup_printf("block %s (%s): writable, not behind blkreplay; "
+                                "safe only if the device does synchronous I/O "
+                                "(pflash)", blk_name(blk), dev));
+        }
+    }
+
+    ctx.explicit = chardevs;
+    ctx.chardevs = &info->chardevs;
+    ctx.errp = errp;
+    if (object_child_foreach(get_chardevs_root(), begin_chardev, &ctx)) {
+        return false;
+    }
+    return true;
+}
+
+static void rr_register_chardevs(RrBeginRecordInfo *info)
+{
+    for (strList *e = info->chardevs; e; e = e->next) {
+        Chardev *chr = qemu_chr_find(e->value);
+        qemu_chr_set_feature(chr, QEMU_CHAR_FEATURE_REPLAY);
+        replay_register_char_driver(chr);
+    }
+}
+
+/*
+ * load_snapshot() of the start snapshot.  Some post_load hooks need
+ * synchronous vCPU work (x86 vapic_post_load -> run_on_cpu); a vCPU thread
+ * that has run blocks on the replay mutex this (main-loop) thread holds, so
+ * run_on_cpu() hands the mutex over while it waits (0028).
+ */
+static bool rr_load_start(const char *snapshot, Error **errp)
+{
+    return load_snapshot(snapshot, NULL, false, NULL, errp);
+}
+
+/* Undo a begin that failed: no log, and icount as it was. */
+static void rr_abandon(void)
+{
+    replay_finish();
+    if (icount_by_begin) {
+        icount_disable_runtime(&error_abort);
+        icount_by_begin = false;
+    }
+}
+
+RrBeginRecordInfo *qmp_x_rr_begin_record(const char *snapshot,
+                                         const char *file,
+                                         const char *icount,
+                                         bool has_chardevs,
+                                         strList *chardevs,
+                                         Error **errp)
+{
+    ERRP_GUARD();
+    RrBeginRecordInfo *info;
+    bool was_running = runstate_is_running();
+    FILE *probe;
+
+    if (replay_mode != REPLAY_MODE_NONE) {
+        error_setg(errp, "record/replay is already active");
+        return NULL;
+    }
+    if (replay_check_blockers(errp)) {
+        return NULL;
+    }
+    probe = fopen(file, "wb");
+    if (!probe) {
+        error_setg_errno(errp, errno, "cannot open '%s'", file);
+        return NULL;
+    }
+    fclose(probe);
+
+    info = g_new0(RrBeginRecordInfo, 1);
+    if (was_running) {
+        vm_stop(RUN_STATE_PAUSED);
+    }
+    if (!rr_prepare(info, icount, chardevs, errp)) {
+        rr_abandon();
+        goto fail;
+    }
+
+    /* the same sequence vl.c runs for -icount rr=record,rrsnapshot= */
+    replay_set_snapshot_name(snapshot);
+    replay_vmstate_register();
+    replay_enable_record(file);
+    rr_register_chardevs(info);
+    replay_vmstate_init();          /* save_snapshot(snapshot) */
+    /*
+     * The replay starts by loading this snapshot; start the recording from
+     * the loaded state too.  Loading is not the identity: a virtual timer
+     * that is already due becomes vCPU work on load (util/qemu-timer.c,
+     * timer_mod_ns_locked under replay) but fires from the main loop, with
+     * a CHECKPOINT_CLOCK_VIRTUAL, in a VM that was merely paused.
+     */
+    if (!rr_load_start(snapshot, errp)) {
+        error_prepend(errp, "reloading the start snapshot: ");
+        rr_abandon();
+        goto fail;
+    }
+    replay_start();
+    info->icount = replay_get_current_icount();
+
+    if (was_running) {
+        vm_start();
+    }
+    return info;
+
+fail:
+    if (was_running) {
+        vm_start();
+    }
+    qapi_free_RrBeginRecordInfo(info);
+    return NULL;
+}
+
+/*
+ * Replay a recording made by x-rr-begin-record.  Upstream's rr=replay
+ * journals machine init (e.g. the virt board's fdt rng-seed draws a random
+ * event), which a recording begun at run time does not contain; so the
+ * replaying process boots normally (start it with -S) and enters replay at
+ * the snapshot, the way PANDA's -replay did.
+ */
+RrBeginRecordInfo *qmp_x_rr_begin_replay(const char *snapshot,
+                                         const char *file,
+                                         const char *icount,
+                                         bool has_chardevs,
+                                         strList *chardevs,
+                                         Error **errp)
+{
+    ERRP_GUARD();
+    RrBeginRecordInfo *info;
+    FILE *probe;
+
+    if (replay_mode != REPLAY_MODE_NONE) {
+        error_setg(errp, "record/replay is already active");
+        return NULL;
+    }
+    if (runstate_is_running()) {
+        error_setg(errp, "start the replaying VM paused (-S)");
+        return NULL;
+    }
+    if (replay_check_blockers(errp)) {
+        return NULL;
+    }
+    probe = fopen(file, "rb");
+    if (!probe) {
+        error_setg_errno(errp, errno, "cannot open '%s'", file);
+        return NULL;
+    }
+    fclose(probe);
+
+    info = g_new0(RrBeginRecordInfo, 1);
+    if (!rr_prepare(info, icount, chardevs, errp)) {
+        rr_abandon();
+        qapi_free_RrBeginRecordInfo(info);
+        return NULL;
+    }
+    replay_set_snapshot_name(snapshot);
+    replay_vmstate_register();
+    replay_enable_play(file);
+    rr_register_chardevs(info);
+    if (!rr_load_start(snapshot, errp)) {      /* seeks the log */
+        rr_abandon();
+        qapi_free_RrBeginRecordInfo(info);
+        return NULL;
+    }
+    replay_start();
+    info->icount = replay_get_current_icount();
+    vm_start();
+    return info;
+}
