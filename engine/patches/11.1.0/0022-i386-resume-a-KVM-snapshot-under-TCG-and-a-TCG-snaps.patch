From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Tue, 20 Oct 2026 12:45:17 -0400
Subject: [PATCH] i386: resume a KVM snapshot under TCG and a TCG snapshot
 under KVM

Every x86 machine creates a kvmclock device under KVM, so every KVM
stream has a 'kvmclock' section that TCG cannot load.  Under any other
accelerator, accept and drop it (never saved).

TCG's ltr leaves TR's cached type 'available'; VMX entry needs a busy
TSS.  Mark it busy when putting sregs.  The other way, a TR from a KVM
snapshot is busy, and TCG's I/O-permission check accepted only an
available TSS, so every user-mode port I/O raised #GP (penguin's x86
hypercall is a user-mode out to port 0x88): accept both.

License: GPL-2.0-or-later
Patch-Set: igloo-core
---
 hw/i386/kvm/clock.h                 |  1 +
 hw/i386/pc.c                        | 53 +++++++++++++++++++++++++++++
 hw/i386/pc_piix.c                   |  2 ++
 hw/i386/pc_q35.c                    |  2 ++
 target/i386/kvm/kvm.c               | 16 +++++++++
 target/i386/tcg/system/seg_helper.c |  7 ++--
 6 files changed, 79 insertions(+), 2 deletions(-)

diff --git a/hw/i386/kvm/clock.h b/hw/i386/kvm/clock.h
index 401c7e445bd50bdd5191a625e2879508db07df0a..d79ffa92db906726d9d5572663df0da8c394ac77 100644
--- a/hw/i386/kvm/clock.h
+++ b/hw/i386/kvm/clock.h
@@ -14,5 +14,6 @@
 #define HW_I386_KVM_CLOCK_H
 
 void kvmclock_create(bool create_always);
+void kvmclock_sink_register(void);
 
 #endif
diff --git a/hw/i386/pc.c b/hw/i386/pc.c
index b6f29fccfa957e64d5b0cbfd8c6457d55caabec6..8f95fa7a85fd5097f954aed280c7e6d76103231e 100644
--- a/hw/i386/pc.c
+++ b/hw/i386/pc.c
@@ -47,6 +47,8 @@
 #include "system/xen.h"
 #include "system/reset.h"
 #include "kvm/kvm_i386.h"
+#include "hw/i386/kvm/clock.h"
+#include "migration/vmstate.h"
 #include "kvm/tdx.h"
 #include "hw/xen/xen.h"
 #include "qobject/qlist.h"
@@ -1872,3 +1874,54 @@ static void pc_machine_register_types(void)
 }
 
 type_init(pc_machine_register_types)
+
+/*
+ * Every x86 machine creates a "kvmclock" device under KVM
+ * (kvmclock_create_always since the 5.2 machine types), so every KVM stream
+ * carries a "kvmclock" section that no other accelerator can load:
+ * "Unknown section or instance 'kvmclock' 0".  Under any other accelerator,
+ * accept that section and drop it, so a snapshot taken under KVM resumes
+ * under TCG.  Never saved (needed() is false), so TCG streams don't change.
+ */
+typedef struct KVMClockSink {
+    uint64_t clock;
+    bool clock_is_reliable;
+} KVMClockSink;
+
+static KVMClockSink kvmclock_sink;
+
+static bool kvmclock_sink_needed(void *opaque)
+{
+    return false;
+}
+
+static const VMStateDescription kvmclock_sink_reliable = {
+    .name = "kvmclock/clock_is_reliable",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = kvmclock_sink_needed,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(clock_is_reliable, KVMClockSink),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static const VMStateDescription kvmclock_sink_vmsd = {
+    .name = "kvmclock",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = kvmclock_sink_needed,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT64(clock, KVMClockSink),
+        VMSTATE_END_OF_LIST()
+    },
+    .subsections = (const VMStateDescription * const []) {
+        &kvmclock_sink_reliable,
+        NULL
+    }
+};
+
+void kvmclock_sink_register(void)
+{
+    vmstate_register(NULL, 0, &kvmclock_sink_vmsd, &kvmclock_sink);
+}
diff --git a/hw/i386/pc_piix.c b/hw/i386/pc_piix.c
index 82457bdb167a36de43d858db45c66f63f9bce4da..883a70c24daf85b5e21ea2eb5b6ee23a68ea4254 100644
--- a/hw/i386/pc_piix.c
+++ b/hw/i386/pc_piix.c
@@ -188,6 +188,8 @@ static void pc_init1(MachineState *machine, const char *pci_type)
 
     if (kvm_enabled()) {
         kvmclock_create(pcmc->kvmclock_create_always);
+    } else {
+        kvmclock_sink_register();
     }
 
     pci_memory = g_new(MemoryRegion, 1);
diff --git a/hw/i386/pc_q35.c b/hw/i386/pc_q35.c
index 6c1e4eff5f1d2c49bacd1db716b591dd00be2487..d5a06e5d38dcab35fa05e889e8b95bc3f2eb273a 100644
--- a/hw/i386/pc_q35.c
+++ b/hw/i386/pc_q35.c
@@ -196,6 +196,8 @@ static void pc_q35_init(MachineState *machine)
 
     if (kvm_enabled()) {
         kvmclock_create(pcmc->kvmclock_create_always);
+    } else {
+        kvmclock_sink_register();
     }
 
     /* create pci host bus */
diff --git a/target/i386/kvm/kvm.c b/target/i386/kvm/kvm.c
index fbe7b77444153f3b09d38162d7ccfd324447dd62..706cfbd95aeeddadcba7763d237336b8e2528ac1 100644
--- a/target/i386/kvm/kvm.c
+++ b/target/i386/kvm/kvm.c
@@ -3913,6 +3913,14 @@ static int kvm_put_sregs(X86CPU *cpu)
     }
 
     set_seg(&sregs.tr, &env->tr);
+    /*
+     * TCG's ltr loads the TR cache before it sets the descriptor's busy bit,
+     * so a TCG snapshot has TR "available" (type 1/9); VMX entry requires a
+     * busy TSS (3/11) and fails with hardware error 0x80000021.
+     */
+    if (sregs.tr.type == 1 || sregs.tr.type == 9) {
+        sregs.tr.type |= 2;
+    }
     set_seg(&sregs.ldt, &env->ldt);
 
     sregs.idt.limit = env->idt.limit;
@@ -3960,6 +3968,14 @@ static int kvm_put_sregs2(X86CPU *cpu)
     }
 
     set_seg(&sregs.tr, &env->tr);
+    /*
+     * TCG's ltr loads the TR cache before it sets the descriptor's busy bit,
+     * so a TCG snapshot has TR "available" (type 1/9); VMX entry requires a
+     * busy TSS (3/11) and fails with hardware error 0x80000021.
+     */
+    if (sregs.tr.type == 1 || sregs.tr.type == 9) {
+        sregs.tr.type |= 2;
+    }
     set_seg(&sregs.ldt, &env->ldt);
 
     sregs.idt.limit = env->idt.limit;
diff --git a/target/i386/tcg/system/seg_helper.c b/target/i386/tcg/system/seg_helper.c
index 3d705e294fa77ee5382c4bbcd0b3e057ac62dea2..8ed8460b236289ad8817ecd05e841d58c0abdd3b 100644
--- a/target/i386/tcg/system/seg_helper.c
+++ b/target/i386/tcg/system/seg_helper.c
@@ -281,9 +281,12 @@ void helper_check_io(CPUX86State *env, uint32_t addr, uint32_t size)
     uintptr_t retaddr = GETPC();
     uint32_t io_offset, val, mask;
 
-    /* TSS must be a valid 32 bit one */
+    /*
+     * TSS must be a valid 32 bit one, available (9) or busy (11): a TR
+     * loaded from a KVM snapshot is busy, as VMX requires.
+     */
     if (!(env->tr.flags & DESC_P_MASK) ||
-        ((env->tr.flags >> DESC_TYPE_SHIFT) & 0xf) != 9 ||
+        (((env->tr.flags >> DESC_TYPE_SHIFT) & 0xf) | 2) != 11 ||
         env->tr.limit < 103) {
         goto fail;
     }
