From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Wed, 21 Oct 2026 12:44:10 -0400
Subject: [PATCH] target/arm/kvm: penguin hypercalls under arm64 KVM (SMCCC
 filter + mailbox doorbell)

Patch 0009 routes KVM_EXIT_HYPERCALL with run->hypercall.args[], which arm64
KVM never fills, and enables KVM_CAP_EXIT_HYPERCALL, which is x86-only, so
on arm64 no penguin hypercall reached QEMU (and the &run->hypercall.ret
argument failed to build with gcc 14: __u64 * vs uint64_t *).

Install an SMCCC filter forwarding 0xC3001337 (the guest kernel's
re-issued msr hypercall; linux_builder 'arm64: forward IGLOO hypercalls')
and 0xC3001338 (mailbox doorbell) to userspace. Unwanted numbers are
answered from 4 ONE_REG ioctls; the mailbox doorbell touches no register;
a handled call pulls the vCPU and pushes back only changed GPRs/PC when
nothing else changed.

Ported from Jacques Becker's kvm_aarch64 QEMU patch and the kvmperf lane's
mailbox and put-changed-GPRs commits.

SPDX-License-Identifier: GPL-2.0-or-later
Origin: penguin
---
 target/arm/kvm.c | 212 +++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 196 insertions(+), 16 deletions(-)

diff --git a/target/arm/kvm.c b/target/arm/kvm.c
index e7294ed8f0ec5bf15b4e6b873329b24ca5bb0e1d..97e35eb15c7573b444c90e3c12ad047b1b306a5f 100644
--- a/target/arm/kvm.c
+++ b/target/arm/kvm.c
@@ -44,6 +44,51 @@
 #include "migration/blocker.h"
 #include "system/penguin.h"
 
+/*
+ * Penguin hypercalls under arm64 KVM.
+ *
+ * The TCG hypercall instruction (msr S0_0_c5_c0_0, xzr; x8 = number, x0..x4 =
+ * arguments, result in x0; AArch32 tasks: mcr p7, 0, r0, c0, c0, 0 with the
+ * number in r7) is unallocated on hardware, so under KVM it UNDEFs to the
+ * guest kernel, which re-issues it as this SMCCC call (SMC64 fast call, OEM
+ * range; linux_builder "arm64: forward IGLOO hypercalls to the hypervisor
+ * under KVM"):
+ *
+ *   x0 = PENGUIN_SMCCC_HYPERCALL, x6 = original x0 (argument 0),
+ *   x1..x4 = arguments 1..4, x8 = penguin hypercall number.
+ *
+ * The result is returned in x0; the guest copies x1..x5 and x8 back to the
+ * caller. As in the TCG helper, a5 is 0 and an unhandled call returns a0.
+ *
+ * PENGUIN_SMCCC_MAILBOX is the hypercall-mailbox doorbell (igloo_driver
+ * portal/mailbox.h, kvmperf DESIGN-mailbox.md): the call's number, arguments,
+ * buffers and result live in guest-physical memory the host reads directly,
+ * so the exit reads and writes no vCPU register. It reaches the host as
+ * hypercall IGLOO_HYPER_MAILBOX.
+ *
+ * Both are forwarded to us by an SMCCC filter (Linux 6.4+). Unlike x86, arm64
+ * KVM reports only the function ID (run->hypercall.nr): arguments and result
+ * live in the guest GPRs, reachable only with KVM_{GET,SET}_ONE_REG.
+ */
+#define PENGUIN_SMCCC_HYPERCALL 0xC3001337u
+#define PENGUIN_SMCCC_MAILBOX   0xC3001338u
+#define IGLOO_HYPER_MAILBOX     0x7905u
+#define SMCCC_RET_NOT_SUPPORTED ((uint64_t)-1)
+
+/* Lets the host side see that this QEMU has the no-sync doorbell path. */
+bool __attribute__((visibility("default"))) penguin_kvm_mailbox_supported(void);
+bool penguin_kvm_mailbox_supported(void)
+{
+    return true;
+}
+
+/*
+ * After a handled hypercall, push back only the GPRs/PC the handler changed
+ * when nothing else changed (see kvm_arm_handle_smccc_hypercall). Cleared
+ * only for measurements.
+ */
+bool penguin_kvm_put_changed_gprs = true;
+
 const KVMCapabilityInfo kvm_arch_required_capabilities[] = {
     KVM_CAP_INFO(DEVICE_CTRL),
     KVM_CAP_LAST_INFO
@@ -595,6 +640,32 @@ int kvm_arch_get_default_type(MachineState *ms)
     return fixed_ipa ? 0 : size;
 }
 
+/*
+ * Ask KVM to forward the penguin SMCCC function IDs to us. Needs Linux 6.4+
+ * and must happen before any vCPU runs. arm64 KVM does not advertise
+ * KVM_CAP_VM_ATTRIBUTES, so kvm_vm_check_attr() can't probe for it; just try.
+ */
+static void kvm_arm_install_penguin_smccc_filter(KVMState *s)
+{
+    struct kvm_smccc_filter filter = {
+        .base = PENGUIN_SMCCC_HYPERCALL,
+        .nr_functions = 2,      /* PENGUIN_SMCCC_HYPERCALL, _MAILBOX */
+        .action = KVM_SMCCC_FILTER_FWD_TO_USER,
+    };
+    struct kvm_device_attr attr = {
+        .group = KVM_ARM_VM_SMCCC_CTRL,
+        .attr = KVM_ARM_VM_SMCCC_FILTER,
+        .addr = (uintptr_t)&filter,
+    };
+    int err = kvm_vm_ioctl(s, KVM_SET_DEVICE_ATTR, &attr);
+
+    if (err < 0) {
+        warn_report("kvm: failed to install penguin SMCCC filter (needs "
+                    "Linux 6.4+): %s; penguin hypercalls will not reach QEMU",
+                    strerror(-err));
+    }
+}
+
 int kvm_arch_init(MachineState *ms, KVMState *s)
 {
     int ret = 0;
@@ -632,14 +703,11 @@ int kvm_arch_init(MachineState *ms, KVMState *s)
         }
     }
 
-    if (kvm_check_extension(s, KVM_CAP_EXIT_HYPERCALL)) {
-        ret = kvm_vm_enable_cap(s, KVM_CAP_EXIT_HYPERCALL, 0, 1);
-        if (ret < 0) {
-            warn_report("kvm: failed to enable KVM_CAP_EXIT_HYPERCALL: %s",
-                        strerror(-ret));
-            ret = 0;
-        }
-    }
+    /*
+     * KVM_CAP_EXIT_HYPERCALL is x86-only; arm64 forwards hypercalls through
+     * an SMCCC filter instead.
+     */
+    kvm_arm_install_penguin_smccc_filter(s);
 
     if (s->kvm_eager_split_size) {
         uint32_t sizes;
@@ -1554,6 +1622,125 @@ static bool kvm_arm_handle_debug(ARMCPU *cpu,
     return false;
 }
 
+#define PENGUIN_CORE_REG(x) (KVM_REG_ARM64 | KVM_REG_SIZE_U64 | \
+                             KVM_REG_ARM_CORE | KVM_REG_ARM_CORE_REG(x))
+
+/*
+ * A wanted hypercall pulls the whole vCPU in (kvm_cpu_synchronize_state),
+ * which marks it dirty, so the next KVM_RUN would push the whole vCPU back
+ * out: another ~330 single-register ioctls. Nearly every handler only reads
+ * state and memory and returns a value in x0 (or writes x1..x5/x8), so
+ * snapshot env after the pull and, if nothing but GPRs and the PC changed,
+ * write just those and leave the vCPU clean. Anything else changed (system
+ * registers, FP/SIMD, PSTATE, ...) falls back to the full put. The compare
+ * never copies the snapshot back into env.
+ */
+static __thread CPUARMState *penguin_env_snap;
+
+static bool penguin_put_changed_gprs(CPUState *cs, CPUARMState *env)
+{
+    CPUARMState *snap = penguin_env_snap;
+    uint64_t old_x[31], old_pc;
+    int i;
+
+    memcpy(old_x, snap->xregs, sizeof(old_x));
+    old_pc = snap->pc;
+    memcpy(snap->xregs, env->xregs, sizeof(old_x));
+    snap->pc = env->pc;
+    if (memcmp(snap, env, sizeof(*env)) != 0) {
+        return false;
+    }
+    for (i = 0; i < 31; i++) {
+        if (env->xregs[i] != old_x[i] &&
+            kvm_set_one_reg(cs, PENGUIN_CORE_REG(regs.regs[i]),
+                            &env->xregs[i])) {
+            return false;
+        }
+    }
+    if (env->pc != old_pc &&
+        kvm_set_one_reg(cs, PENGUIN_CORE_REG(regs.pc), &env->pc)) {
+        return false;
+    }
+    return true;
+}
+
+/*
+ * A penguin SMCCC call forwarded by the filter installed in kvm_arch_init().
+ * The PC is already past the HVC.
+ */
+static void kvm_arm_handle_smccc_hypercall(CPUState *cs, struct kvm_run *run)
+{
+    CPUARMState *env = &ARM_CPU(cs)->env;
+    uint64_t ret = 0;
+    bool was_dirty;
+
+    if (run->hypercall.nr == PENGUIN_SMCCC_MAILBOX) {
+        /*
+         * Neither pull nor push the vCPU: the answer goes in the mailbox. A
+         * handler that does need live state calls penguin_sync_cpu_state(),
+         * which also marks the vCPU dirty so its changes are pushed before
+         * the next KVM_RUN.
+         */
+        penguin_handle_guest_hypercall(cs, IGLOO_HYPER_MAILBOX,
+                                       0, 0, 0, 0, 0, 0, &ret);
+        return;
+    }
+
+    /*
+     * Peek at the hypercall number before pulling in the whole vCPU: a
+     * number nobody registered for is answered (a0 back in x0) from four
+     * ONE_REG ioctls. KVM's copy is only authoritative while QEMU's isn't
+     * dirty.
+     */
+    if (run->hypercall.nr == PENGUIN_SMCCC_HYPERCALL && !cs->vcpu_dirty) {
+        uint64_t pstate, nr, a0;
+
+        if (!kvm_get_one_reg(cs, PENGUIN_CORE_REG(regs.pstate), &pstate) &&
+            !(pstate & PSTATE_nRW) &&
+            !kvm_get_one_reg(cs, PENGUIN_CORE_REG(regs.regs[8]), &nr) &&
+            !penguin_guest_hypercall_wanted(nr) &&
+            !kvm_get_one_reg(cs, PENGUIN_CORE_REG(regs.regs[6]), &a0) &&
+            !kvm_set_one_reg(cs, PENGUIN_CORE_REG(regs.regs[0]), &a0)) {
+            return;
+        }
+    }
+
+    was_dirty = cs->vcpu_dirty;
+    kvm_cpu_synchronize_state(cs);
+
+    if (run->hypercall.nr != PENGUIN_SMCCC_HYPERCALL || !is_a64(env)) {
+        /* Not ours: answer as KVM does for calls it doesn't implement. */
+        if (is_a64(env)) {
+            env->xregs[0] = SMCCC_RET_NOT_SUPPORTED;
+        } else {
+            env->regs[0] = (uint32_t)SMCCC_RET_NOT_SUPPORTED;
+        }
+        return;
+    }
+
+    if (!was_dirty && penguin_kvm_put_changed_gprs) {
+        if (!penguin_env_snap) {
+            penguin_env_snap = g_new(CPUARMState, 1);
+        }
+        memcpy(penguin_env_snap, env, sizeof(*env));
+    }
+
+    if (penguin_handle_guest_hypercall(cs, env->xregs[8],
+                                       env->xregs[6], env->xregs[1],
+                                       env->xregs[2], env->xregs[3],
+                                       env->xregs[4], 0, &ret)) {
+        env->xregs[0] = ret;
+    } else {
+        env->xregs[0] = env->xregs[6];
+    }
+
+    if (!was_dirty && penguin_kvm_put_changed_gprs && cs->vcpu_dirty &&
+        penguin_put_changed_gprs(cs, env)) {
+        /* KVM now holds everything the handler changed. */
+        cs->vcpu_dirty = false;
+    }
+}
+
 int kvm_arch_handle_exit(CPUState *cs, struct kvm_run *run)
 {
     ARMCPU *cpu = ARM_CPU(cs);
@@ -1561,14 +1748,7 @@ int kvm_arch_handle_exit(CPUState *cs, struct kvm_run *run)
 
     switch (run->exit_reason) {
     case KVM_EXIT_HYPERCALL:
-        penguin_handle_guest_hypercall(cs, run->hypercall.nr,
-                                       run->hypercall.args[0],
-                                       run->hypercall.args[1],
-                                       run->hypercall.args[2],
-                                       run->hypercall.args[3],
-                                       run->hypercall.args[4],
-                                       run->hypercall.args[5],
-                                       &run->hypercall.ret);
+        kvm_arm_handle_smccc_hypercall(cs, run);
         break;
     case KVM_EXIT_DEBUG:
         if (kvm_arm_handle_debug(cpu, &run->debug.arch)) {
