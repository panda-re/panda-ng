From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: igloo <nix@local>
Date: Wed, 19 Aug 2026 23:02:41 -0400
Subject: [PATCH] build: emit shared libraries for the Penguin embedding API

Penguin drives QEMU as a library through CFFI, not as a subprocess, so each
softmmu target must also be linked as a shared object.

Emits libqemu-system-<name>.so for every TCG softmmu target, including the
Penguin arch-name aliases (intel64, armel, mipseb, mips64eb, powerpc,
powerpc64, powerpc64le), and qemu-kvm-<target>.so for the KVM targets.
Requires b_staticpic=true, since the default static-PIC-free build cannot be
relinked into a shared object.

Folds: 67bfb34d25, 797f446cf8 (partial)
---
 meson.build | 34 +++++++++++++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index 49a5baf5b52fd257001b81d4212a129a0315cd11..471f3f9964bb9129ed344d0615c9b87e858d5ca9 100644
--- a/meson.build
+++ b/meson.build
@@ -1,6 +1,6 @@
 project('qemu', ['c'], meson_version: '>=1.5.0',
         default_options: ['warning_level=1', 'c_std=gnu11', 'cpp_std=gnu++23', 'b_colorout=auto',
-                          'b_staticpic=false', 'stdsplit=false', 'optimization=2', 'b_pie=true'] +
+                          'b_staticpic=true', 'stdsplit=false', 'optimization=2', 'b_pie=true'] +
 
                           # build.rust_std breaks with older meson, but Rust does not
                           # support old meson anyway
@@ -4451,6 +4451,38 @@ foreach target : target_dirs
                link_args: link_args,
                win_subsystem: exe['win_subsystem'])
 
+    if target.endswith('-softmmu') and 'CONFIG_TCG' in config_target
+      penguin_system_names = {
+        'x86_64': ['x86_64', 'intel64'],
+        'arm': ['arm', 'armel'],
+        'mips': ['mips', 'mipseb'],
+        'mips64': ['mips64', 'mips64eb'],
+        'ppc': ['ppc', 'powerpc'],
+        'ppc64': ['ppc64', 'powerpc64', 'powerpc64le'],
+      }.get(target_name, [target_name])
+
+      foreach penguin_system_name: penguin_system_names
+        shared_library('libqemu-system-' + penguin_system_name, exe['sources'],
+                   install: true,
+                   name_prefix: '',
+                   c_args: c_args,
+                   dependencies: arch_deps + exe['dependencies'],
+                   objects: lib.extract_all_objects(recursive: true),
+                   link_depends: [block_syms, qemu_syms],
+                   link_args: link_args)
+      endforeach
+    endif
+
+    if target.endswith('-softmmu') and 'CONFIG_KVM' in config_target and target_name in ['x86_64', 'aarch64']
+      shared_library('qemu-kvm-' + target_name, exe['sources'],
+                 install: true,
+                 c_args: c_args,
+                 dependencies: arch_deps + exe['dependencies'],
+                 objects: lib.extract_all_objects(recursive: true),
+                 link_depends: [block_syms, qemu_syms],
+                 link_args: link_args)
+    endif
+
     if host_os == 'darwin'
       icon = 'pc-bios/qemu.rsrc'
       build_input = [emulator, files(icon)]
