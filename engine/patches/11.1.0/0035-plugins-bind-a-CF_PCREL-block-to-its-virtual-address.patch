From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Wed, 21 Oct 2026 17:55:16 -0400
Subject: [PATCH] plugins: bind a CF_PCREL block to its virtual address when a
 plugin read it

A CF_PCREL TB is keyed by physical page and runs at every virtual address
that maps it.  Plugin instrumentation is decided at translation, and a
plugin that read qemu_plugin_insn_vaddr (or tb_vaddr, disas, symbol) made a
decision that holds only at the address the TB was translated at: the same
code mapped at a second address ran the first one's callbacks, or none.
On x86_64, aarch64, arm and riscv64 an instruction callback keyed on an
address fired at its aliases and missed its target.

When a plugin reads the address, bind the TB to it (pc_bound, with tb->pc
set): lookups and tb_cmp compare the address for a bound TB, and a TB that
runs at any address does not chain straight into a bound one.  TBs whose
instrumentation never looked at the address stay shared.
---
 accel/tcg/cpu-exec.c             | 13 ++++++++++---
 accel/tcg/plugin-gen.c           | 11 +++++++++++
 accel/tcg/tb-maint.c             |  3 ++-
 accel/tcg/translate-all.c        |  1 +
 include/exec/translation-block.h | 12 ++++++++++++
 include/qemu/plugin.h            |  3 +++
 plugins/api.c                    | 18 +++++++++++++++++-
 7 files changed, 56 insertions(+), 5 deletions(-)

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 0130d18aa08ea61f24b2237f865938119082d62a..9d7319de27d6bd4f882ede3e2c454c08acb7d2dc 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -163,7 +163,7 @@ static bool tb_lookup_cmp(const void *p, const void *d)
     const TranslationBlock *tb = p;
     const struct tb_desc *desc = d;
 
-    if ((tb_cflags(tb) & CF_PCREL || tb->pc == desc->s.pc) &&
+    if ((!tb_pc_exact(tb) || tb->pc == desc->s.pc) &&
         tb_page_addr0(tb) == desc->page_addr0 &&
         tb->cs_base == desc->s.cs_base &&
         tb->flags == desc->s.flags &&
@@ -259,9 +259,9 @@ static inline TranslationBlock *tb_lookup(CPUState *cpu, TCGTBCPUState s)
 hit:
     /*
      * As long as tb is not NULL, the contents are consistent.  Therefore,
-     * the virtual PC has to match for non-CF_PCREL translations.
+     * the virtual PC has to match for translations bound to it.
      */
-    assert((tb_cflags(tb) & CF_PCREL) || tb->pc == s.pc);
+    assert(!tb_pc_exact(tb) || tb->pc == s.pc);
     return tb;
 }
 
@@ -1007,6 +1007,13 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
                 last_tb = NULL;
             }
 #endif
+            /*
+             * A TB that runs at any virtual address must not jump
+             * straight into one that is right at only one of them.
+             */
+            if (last_tb && tb_pc_exact(tb) && !tb_pc_exact(last_tb)) {
+                last_tb = NULL;
+            }
             /* See if we can patch the calling TB. */
             if (last_tb) {
                 tb_add_jump(last_tb, tb_exit, tb);
diff --git a/accel/tcg/plugin-gen.c b/accel/tcg/plugin-gen.c
index 1ffcb4b2d2d0fc37c80f92ebcd76ed8a85fa7cae..5778330b9b8f5d167b6a47d6604690b53bdf91c6 100644
--- a/accel/tcg/plugin-gen.c
+++ b/accel/tcg/plugin-gen.c
@@ -431,6 +431,7 @@ bool plugin_gen_tb_start(CPUState *cpu, const DisasContextBase *db)
         }
         ptb->n = 0;
         ptb->mem_helper = false;
+        ptb->vaddr_read = false;
     } else {
         ptb = g_new0(struct qemu_plugin_tb, 1);
         tcg_ctx->plugin_tb = ptb;
@@ -501,6 +502,16 @@ void plugin_gen_tb_end(CPUState *cpu, size_t num_insns)
     /* collect instrumentation requests */
     qemu_plugin_tb_trans_cb(cpu, ptb);
 
+    /*
+     * A CF_PCREL TB runs at every virtual address that maps its physical
+     * page.  If a plugin read the address while instrumenting it, the
+     * instrumentation is right only at this one: bind the TB to it.
+     */
+    if (ptb->vaddr_read && (tb_cflags(tcg_ctx->plugin_db->tb) & CF_PCREL)) {
+        tcg_ctx->plugin_db->tb->pc = tcg_ctx->plugin_db->pc_first;
+        tcg_ctx->plugin_db->tb->pc_bound = true;
+    }
+
     /* inject the instrumentation at the appropriate places */
     plugin_gen_inject(ptb);
 
diff --git a/accel/tcg/tb-maint.c b/accel/tcg/tb-maint.c
index 1944ad5dd5543b594a2a18de6dcedf6a61ec4dfa..17f45ffbc926e4def01f9cbcb47338357772c6a8 100644
--- a/accel/tcg/tb-maint.c
+++ b/accel/tcg/tb-maint.c
@@ -58,7 +58,8 @@ static bool tb_cmp(const void *ap, const void *bp)
     const TranslationBlock *a = ap;
     const TranslationBlock *b = bp;
 
-    return ((tb_cflags(a) & CF_PCREL || a->pc == b->pc) &&
+    return (tb_pc_exact(a) == tb_pc_exact(b) &&
+            (!tb_pc_exact(a) || a->pc == b->pc) &&
             a->cs_base == b->cs_base &&
             a->flags == b->flags &&
             (tb_cflags(a) & ~CF_INVALID) == (tb_cflags(b) & ~CF_INVALID) &&
diff --git a/accel/tcg/translate-all.c b/accel/tcg/translate-all.c
index b85b1c25c6bb6bd065be9354edea3340cc8f2a6d..2c7df12c01a67bf06c814b7179d24c9f3d78520a 100644
--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -321,6 +321,7 @@ TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s)
 
  restart_translate:
     trace_translate_block(tb, s.pc, tb->tc.ptr);
+    tb->pc_bound = false;               /* see plugin_gen_tb_end() */
 
     gen_code_size = setjmp_gen_code(env, tb, s.pc, host_pc, &max_insns, &ti);
     if (unlikely(gen_code_size < 0)) {
diff --git a/include/exec/translation-block.h b/include/exec/translation-block.h
index 40cc6990318ca41b748b68cb6280f74e66d69705..16c3717741648fe17375222d999ea283e08a15e0 100644
--- a/include/exec/translation-block.h
+++ b/include/exec/translation-block.h
@@ -95,6 +95,12 @@ struct TranslationBlock {
     uint16_t size;
     uint16_t icount;
 
+    /*
+     * CF_PCREL only: a plugin read the virtual address while instrumenting
+     * this TB, so it is right only at that address, which is kept in @pc.
+     */
+    bool pc_bound;
+
     struct tb_tc tc;
 
     /*
@@ -158,6 +164,12 @@ static inline uint32_t tb_cflags(const TranslationBlock *tb)
     return qatomic_read(&tb->cflags);
 }
 
+/* Does @tb run only at the virtual address @tb->pc? */
+static inline bool tb_pc_exact(const TranslationBlock *tb)
+{
+    return !(tb_cflags(tb) & CF_PCREL) || tb->pc_bound;
+}
+
 bool tcg_cflags_has(CPUState *cpu, uint32_t flags);
 void tcg_cflags_set(CPUState *cpu, uint32_t flags);
 
diff --git a/include/qemu/plugin.h b/include/qemu/plugin.h
index 9c2ec8ceaeba3d061e5fbe717e1fded745b3c035..49c49c97e3ccb062feea4614224a698c24820075 100644
--- a/include/qemu/plugin.h
+++ b/include/qemu/plugin.h
@@ -136,6 +136,9 @@ struct qemu_plugin_tb {
     /* if set, the TB calls helpers that might access guest memory */
     bool mem_helper;
 
+    /* if set, a plugin read a virtual address (see plugin_gen_tb_end) */
+    bool vaddr_read;
+
     GArray *cbs;
 };
 
diff --git a/plugins/api.c b/plugins/api.c
index 6580b5b4c1441744b35a72468f6a20f22fa5ce44..89de232a7829ce0444e81c710391b1bf35e51d8a 100644
--- a/plugins/api.c
+++ b/plugins/api.c
@@ -252,9 +252,20 @@ size_t qemu_plugin_tb_n_insns(const struct qemu_plugin_tb *tb)
     return tb->n;
 }
 
+/*
+ * The answer depends on the virtual address the TB was translated at, so
+ * the TB must not run at others (see plugin_gen_tb_end()).
+ */
+static void vaddr_read(void)
+{
+    tcg_ctx->plugin_tb->vaddr_read = true;
+}
+
 uint64_t qemu_plugin_tb_vaddr(const struct qemu_plugin_tb *tb)
 {
     const DisasContextBase *db = tcg_ctx->plugin_db;
+
+    vaddr_read();
     return db->pc_first;
 }
 
@@ -290,6 +301,7 @@ size_t qemu_plugin_insn_size(const struct qemu_plugin_insn *insn)
 
 uint64_t qemu_plugin_insn_vaddr(const struct qemu_plugin_insn *insn)
 {
+    vaddr_read();
     return insn->vaddr;
 }
 
@@ -323,13 +335,17 @@ void *qemu_plugin_insn_haddr(const struct qemu_plugin_insn *insn)
 
 char *qemu_plugin_insn_disas(const struct qemu_plugin_insn *insn)
 {
+    vaddr_read();               /* PC-relative operands */
     return plugin_disas(tcg_ctx->cpu, tcg_ctx->plugin_db,
                         insn->vaddr, insn->len);
 }
 
 const char *qemu_plugin_insn_symbol(const struct qemu_plugin_insn *insn)
 {
-    const char *sym = lookup_symbol(insn->vaddr);
+    const char *sym;
+
+    vaddr_read();
+    sym = lookup_symbol(insn->vaddr);
     return sym[0] != 0 ? sym : NULL;
 }
 
