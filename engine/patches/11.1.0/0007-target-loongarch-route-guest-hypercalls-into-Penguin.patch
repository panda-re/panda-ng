From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: igloo <nix@local>
Date: Wed, 19 Aug 2026 23:02:41 -0400
Subject: [PATCH] target/loongarch: route guest hypercalls into Penguin

Same helper as the other targets. LoongArch has no spare instruction, so the
hook is a decoded-insn match on rd == 0 && rj == 0, which is otherwise a no-op
encoding.

Folds: 797f446cf8 (partial), d7f87bf73e (partial), 9cdbac967b (partial),
087a668076 (partial)
---
 target/loongarch/tcg/helper.h                    |  1 +
 .../loongarch/tcg/insn_trans/trans_extra.c.inc   | 11 +++++++++++
 target/loongarch/tcg/op_helper.c                 | 16 ++++++++++++++++
 3 files changed, 28 insertions(+)

diff --git a/target/loongarch/tcg/helper.h b/target/loongarch/tcg/helper.h
index 8a6c62f11618d7125122831f4a9fe0d0fab73364..83644912accc123733b204cfb4d7cc6da949f1be 100644
--- a/target/loongarch/tcg/helper.h
+++ b/target/loongarch/tcg/helper.h
@@ -4,6 +4,7 @@
  */
 
 DEF_HELPER_2(raise_exception, noreturn, env, i32)
+DEF_HELPER_7(penguin_guest_hypercall, tl, env, tl, tl, tl, tl, tl, tl)
 
 DEF_HELPER_FLAGS_1(bitrev_w, TCG_CALL_NO_RWG_SE, tl, tl)
 DEF_HELPER_FLAGS_1(bitrev_d, TCG_CALL_NO_RWG_SE, tl, tl)
diff --git a/target/loongarch/tcg/insn_trans/trans_extra.c.inc b/target/loongarch/tcg/insn_trans/trans_extra.c.inc
index 655dce329e8d57ee6f464eb97b23d30574e855cb..78d79c70fa51927dbb9560cf3a598f926686855a 100644
--- a/target/loongarch/tcg/insn_trans/trans_extra.c.inc
+++ b/target/loongarch/tcg/insn_trans/trans_extra.c.inc
@@ -87,6 +87,17 @@ static bool trans_cpucfg(DisasContext *ctx, arg_cpucfg *a)
 
     gen_helper_cpucfg(dest, tcg_env, src1);
     gen_set_gpr(a->rd, dest, EXT_NONE);
+    if (a->rd == 0 && a->rj == 0) {
+        TCGv ret = tcg_temp_new();
+        gen_helper_penguin_guest_hypercall(ret, tcg_env,
+                                           gpr_src(ctx, 11, EXT_NONE),
+                                           gpr_src(ctx, 4, EXT_NONE),
+                                           gpr_src(ctx, 5, EXT_NONE),
+                                           gpr_src(ctx, 6, EXT_NONE),
+                                           gpr_src(ctx, 7, EXT_NONE),
+                                           gpr_src(ctx, 8, EXT_NONE));
+        gen_set_gpr(4, ret, EXT_NONE);
+    }
 
     return true;
 }
diff --git a/target/loongarch/tcg/op_helper.c b/target/loongarch/tcg/op_helper.c
index e63ac66daae545d51fab6578feb88de4f9c1ca2a..4db11a3d6f166083400cf0b3dce702bbedf58802 100644
--- a/target/loongarch/tcg/op_helper.c
+++ b/target/loongarch/tcg/op_helper.c
@@ -15,6 +15,7 @@
 #include "qemu/crc32c.h"
 #include <zlib.h> /* for crc32 */
 #include "cpu-csr.h"
+#include "system/penguin.h"
 
 /* Exceptions helpers */
 void helper_raise_exception(CPULoongArchState *env, uint32_t exception)
@@ -22,6 +23,21 @@ void helper_raise_exception(CPULoongArchState *env, uint32_t exception)
     do_raise_exception(env, exception, GETPC());
 }
 
+target_ulong helper_penguin_guest_hypercall(CPULoongArchState *env,
+                                            target_ulong nr,
+                                            target_ulong a0, target_ulong a1,
+                                            target_ulong a2, target_ulong a3,
+                                            target_ulong a4)
+{
+    CPUState *cs = env_cpu(env);
+    uint64_t ret = 0;
+
+    if (penguin_handle_guest_hypercall(cs, nr, a0, a1, a2, a3, a4, 0, &ret)) {
+        return ret;
+    }
+    return a0;
+}
+
 target_ulong helper_bitrev_w(target_ulong rj)
 {
     return (int32_t)revbit32(rj);
