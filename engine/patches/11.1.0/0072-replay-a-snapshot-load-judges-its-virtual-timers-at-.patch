     return timer_new(type, SCALE_MS, cb, opaque);
 }
 
+/**
+ * timer_replay_load_begin:
+ * timer_replay_load_end:
+ * @loaded: the load succeeded
+ * @convert: turn the due timers into vCPU work
+ *
+ * Bracket a snapshot load under record/replay (replay_load_snapshot()):
+ * whether a virtual timer the load arms is already expired is decided at
+ * the end, against the loaded clock, not when it is armed.  Under the BQL.
+ */
+void timer_replay_load_begin(void);
+void timer_replay_load_end(bool loaded, bool convert);
+
+/**
+ * timer_replay_report_expired:
+ *
+ * error_report() each expired virtual timer that needs a
+ * CHECKPOINT_CLOCK_VIRTUAL to run under replay.
+ *
+ * Returns: the number reported
+ */
+int timer_replay_report_expired(void);
+
 /**
  * timer_deinit:
  * @ts: the timer to be de-initialised
diff --git a/include/system/replay.h b/include/system/replay.h
index d7612217d6637a0177d2c4e42916dd227acf4fba..01d7f3f448d13254b78fa6332b97266d9e03242c 100644
--- a/include/system/replay.h
+++ b/include/system/replay.h
@@ -187,4 +187,15 @@ void replay_vmstate_init(void);
     can be created */
 bool replay_can_snapshot(void);
 
+/**
+ * replay_check_timer_stall:
+ *
+ * In replay, the vCPU loop ran the virtual timers and one is still expired:
+ * it waits for a CHECKPOINT_CLOCK_VIRTUAL, and the vCPU runs nothing until
+ * it fires.  If that does not change for a while at the same instruction
+ * count, the log and the timers disagree and the replay would spin forever:
+ * report the timers and stop with an error.  With the replay mutex held.
+ */
+void replay_check_timer_stall(void);
+
 #endif
diff --git a/replay/replay-begin.c b/replay/replay-begin.c
index fc2aef535d64e2cd9ebceece53a781287d8c2e22..39d85484dd4f228f02c2642e8c809bb1c2551494 100644
--- a/replay/replay-begin.c
+++ b/replay/replay-begin.c
@@ -212,10 +212,16 @@ static void rr_register_chardevs(RrBeginRecordInfo *info)
  * synchronous vCPU work (x86 vapic_post_load -> run_on_cpu); a vCPU thread
  * that has run blocks on the replay mutex this (main-loop) thread holds, so
  * run_on_cpu() hands the mutex over while it waits (0028).
+ *
+ * Record and replay must leave the load with the same virtual timers armed
+ * and the same ones turned into vCPU work, although they load from
+ * different clocks (the recorder's is already the snapshot's, a fresh
+ * replaying process's is near 0, and on x86 the APIC loads before the
+ * "timer" section): replay_load_snapshot() decides after the load.
  */
 static bool rr_load_start(const char *snapshot, Error **errp)
 {
-    return load_snapshot(snapshot, NULL, false, NULL, errp);
+    return replay_load_snapshot(snapshot, errp);
 }
 
 /*
@@ -288,9 +294,10 @@ RrBeginRecordInfo *qmp_x_rr_begin_record(const char *snapshot,
     /*
      * The replay starts by loading this snapshot; start the recording from
      * the loaded state too.  Loading is not the identity: a virtual timer
-     * that is already due becomes vCPU work on load (util/qemu-timer.c,
-     * timer_mod_ns_locked under replay) but fires from the main loop, with
-     * a CHECKPOINT_CLOCK_VIRTUAL, in a VM that was merely paused.
+     * that is already due becomes vCPU work after the load (no log event;
+     * replay_load_snapshot -> timer_replay_load_end) but fires from the
+     * main loop, with a CHECKPOINT_CLOCK_VIRTUAL, in a VM that was merely
+     * paused.
      */
     if (!rr_load_start(snapshot, errp)) {
         error_prepend(errp, "reloading the start snapshot: ");
