@@ -86,6 +86,9 @@ void icount_handle_deadline(void)
      */
     if (deadline == 0) {
         icount_notify_aio_contexts();
+        if (replay_mode == REPLAY_MODE_PLAY) {
+            replay_check_timer_stall();
+        }
     }
 }
 
diff --git a/include/qemu/timer.h b/include/qemu/timer.h
index 9a62ac8cded11cc5c538117bda6826d33ff3cc76..fd7915087bc69305e7f723effe5ebe7b3aae2284 100644
