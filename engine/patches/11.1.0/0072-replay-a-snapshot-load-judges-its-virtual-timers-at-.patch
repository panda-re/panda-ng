 include/qemu/timer.h             |  23 +++++
 include/system/replay.h          |  11 ++
 replay/replay-begin.c            |  15 ++-
 replay/replay-debugging.c        |   2 +-
 replay/replay-internal.h         |   8 ++
 replay/replay-snapshot.c         |  32 +++++-
 replay/replay.c                  |  41 ++++++++
 util/qemu-timer.c                | 166 ++++++++++++++++++++++++++++++-
 9 files changed, 292 insertions(+), 9 deletions(-)

