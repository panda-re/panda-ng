diff --git a/replay/replay-snapshot.c b/replay/replay-snapshot.c
index 54e32abc01f9d7cf2d9a56053092e9c7a1bec21c..bc968fb87affe988e1dbdb972969362bc6d82c78 100644
--- a/replay/replay-snapshot.c
+++ b/replay/replay-snapshot.c
@@ -52,12 +52,70 @@ static int replay_post_load(void *opaque, int version_id)
     return 0;
 }
 
+static bool replay_begin_needed(void *opaque)
+{
+    ReplayState *state = opaque;
+
+    return state->begin_start;
+}
+
+/* replay_vmstate_init() loads the -icount rrsnapshot= snapshot at startup */
+static bool replay_startup_load;
+
+static int replay_begin_post_load(void *opaque, int version_id)
+{
+    ReplayState *state = opaque;
+
+    /*
+     * A recording begun at run time cannot be replayed from startup: its
+     * log has nothing of machine init (a board's random draws), nor of this
+     * load's block requests (x-rr-begin-record saved and reloaded the
+     * snapshot with the events off, before replay_start(), as
+     * x-rr-begin-replay loads it; here the flush that closes the vmstate
+     * would wait for ever in blkreplay), and the network filters
+     * x-rr-begin-record added are not on this command line.  Stop here,
+     * before the load blocks, instead of hanging or diverging.
+     */
+    if (state->begin_start && replay_startup_load) {
+        error_report("replay: snapshot '%s' starts a recording made with "
+                     "x-rr-begin-record; -icount rr=replay,rrsnapshot= "
+                     "cannot replay it: start this VM paused (-S) without "
+                     "rr=, and replay it with x-rr-begin-replay "
+                     "(Panda.run_replay)", replay_snapshot);
+        exit(1);
+    }
+    return 0;
+}
+
+/*
+ * Marks x-rr-begin-record's start snapshot: every load of it converts its
+ * due virtual timers the way the recorder's reload did
+ * (replay_load_snapshot()), and the -icount rr=replay,rrsnapshot= startup
+ * path, which cannot replay such a recording, refuses it.  (The log's
+ * format stays as it is.)
+ */
+static const VMStateDescription vmstate_replay_begin = {
+    .name = "replay/begin",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = replay_begin_needed,
+    .post_load = replay_begin_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(begin_start, ReplayState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
 static const VMStateDescription vmstate_replay = {
     .name = "replay",
     .version_id = 3,
     .minimum_version_id = 3,
     .pre_save = replay_pre_save,
     .post_load = replay_post_load,
+    .subsections = (const VMStateDescription * const []) {
+        &vmstate_replay_begin,
+        NULL
+    },
     .fields = (const VMStateField[]) {
         VMSTATE_INT64_ARRAY(cached_clock, ReplayState, REPLAY_CLOCK_COUNT),
         VMSTATE_UINT64(current_icount, ReplayState),
@@ -73,6 +131,10 @@ static const VMStateDescription vmstate_replay = {
 };
 
 static bool replay_vmstate_registered;
+/* replay_vmstate_init() saves the start snapshot */
+static bool replay_saving_start;
+/* replay_load_snapshot() or -loadvm (replay_permit_load()) loads */
+static bool replay_loading;
 
 void replay_vmstate_register(void)
 {
@@ -93,14 +155,26 @@ void replay_vmstate_init(void)
 
     if (replay_snapshot) {
         if (replay_mode == REPLAY_MODE_RECORD) {
-            if (!save_snapshot(replay_snapshot,
-                               true, NULL, false, NULL, &err)) {
+            bool ok;
+
+            /* x-rr-begin-record reloads it: mark it */
+            replay_state.begin_start = replay_snapshot_reloaded;
+            replay_saving_start = true;
+            ok = save_snapshot(replay_snapshot, true, NULL, false, NULL, &err);
+            replay_saving_start = false;
+            replay_state.begin_start = false;
+            if (!ok) {
                 error_report_err(err);
                 error_report("Could not create snapshot for icount record");
                 exit(1);
             }
         } else if (replay_mode == REPLAY_MODE_PLAY) {
-            if (!replay_load_snapshot(replay_snapshot, &err)) {
+            bool ok;
+
+            replay_startup_load = true;
+            ok = replay_load_snapshot(replay_snapshot, &err);
+            replay_startup_load = false;
+            if (!ok) {
                 error_report_err(err);
                 error_report("Could not load snapshot for icount replay");
                 exit(1);
@@ -112,7 +186,8 @@ void replay_vmstate_init(void)
 /*
  * Load a snapshot in record/replay mode: the start snapshot of
  * x-rr-begin-record/-replay, the -icount rrsnapshot= one at startup, or the
- * nearest one for a reverse-debugging seek.
+ * nearest one for a reverse-debugging seek.  The only loads allowed while
+ * recording or replaying (replay_can_load_snapshot()).
  *
  * The devices' virtual timers are re-armed while QEMU_CLOCK_VIRTUAL still
  * runs at the loading process's time (see timer_replay_load_begin()), so
@@ -128,16 +203,56 @@ void replay_vmstate_init(void)
  */
 bool replay_load_snapshot(const char *name, Error **errp)
 {
-    bool convert = replay_snapshot_reloaded &&
-                   !g_strcmp0(name, replay_snapshot);
+    bool convert;
     bool ok;
 
+    replay_state.begin_start = false;
+    replay_loading = true;
     timer_replay_load_begin();
     ok = load_snapshot(name, NULL, false, NULL, errp);
+    /*
+     * The start snapshot of x-rr-begin-record: marked ("replay/begin"), or
+     * (one saved before the mark) by its name while x-rr-begin-* runs.
+     */
+    convert = replay_state.begin_start ||
+              (replay_snapshot_reloaded && !g_strcmp0(name, replay_snapshot));
     timer_replay_load_end(ok, convert);
+    replay_loading = false;
+    replay_state.begin_start = false;
     return ok;
 }
 
+void replay_permit_load(bool permit)
+{
+    replay_loading = permit;
+}
+
+bool replay_can_load_snapshot(Error **errp)
+{
+    if (replay_mode == REPLAY_MODE_NONE || replay_loading) {
+        return true;
+    }
+    error_setg(errp, "Record/replay does not allow loading a snapshot while "
+               "%s: the log would not contain the load, so a replay could "
+               "not repeat it (load it before the recording begins, or "
+               "after it ends)",
+               replay_mode == REPLAY_MODE_RECORD ? "recording" : "replaying");
+    return false;
+}
+
+bool replay_can_save_snapshot(const char *name, Error **errp)
+{
+    if (replay_mode == REPLAY_MODE_NONE || replay_saving_start ||
+        !replay_snapshot || g_strcmp0(name, replay_snapshot)) {
+        return true;
+    }
+    error_setg(errp, "Record/replay does not allow replacing snapshot '%s' "
+               "while %s: it is the recording's start snapshot, which its "
+               "replay loads", name,
+               replay_mode == REPLAY_MODE_RECORD ? "recording" : "replaying");
+    return false;
+}
+
 bool replay_can_snapshot(void)
 {
     return replay_mode == REPLAY_MODE_NONE
diff --git a/replay/replay.c b/replay/replay.c
