--- a/replay/stubs-system.c
+++ b/replay/stubs-system.c
@@ -34,6 +34,17 @@ bool replay_can_snapshot(void)
 {
     return true;
 }
+bool replay_can_load_snapshot(Error **errp)
+{
+    return true;
+}
+void replay_permit_load(bool permit)
+{
+}
+bool replay_can_save_snapshot(const char *name, Error **errp)
+{
+    return true;
+}
 void replay_configure(struct QemuOpts *opts)
 {
 }
diff --git a/system/vl.c b/system/vl.c
index 5fa6050ba4ed9060a6d329f4ebc778b8f5d762c8..626d854e71c3a2bb8f3f4aafee365e2236f1196d 100644
--- a/system/vl.c
+++ b/system/vl.c
@@ -2895,7 +2895,9 @@ void qmp_x_exit_preconfig(Error **errp)
 
     if (loadvm) {
         RunState state = autostart ? RUN_STATE_RUNNING : runstate_get();
+        replay_permit_load(true);
         load_snapshot(loadvm, NULL, false, NULL, &error_fatal);
+        replay_permit_load(false);
         load_snapshot_resume(state);
     }
     if (replay_mode != REPLAY_MODE_NONE) {
