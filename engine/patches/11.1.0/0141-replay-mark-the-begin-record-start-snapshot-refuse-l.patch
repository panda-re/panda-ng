 migration/migration-hmp-cmds.c |   6 ++
 migration/savevm.c             |  12 ++++
 replay/replay-internal.h       |   6 ++
 replay/replay-random.c         |   6 ++
 replay/replay-snapshot.c       | 127 +++++++++++++++++++++++++++++++--
 replay/replay.c                |   4 ++
 replay/stubs-system.c          |  11 +++
 system/vl.c                    |   2 +
 9 files changed, 186 insertions(+), 6 deletions(-)

diff --git a/include/system/replay.h b/include/system/replay.h
index 01d7f3f448d13254b78fa6332b97266d9e03242c..ce93b2d2303ad6e58240070b2117fed362fbf5c9 100644
--- a/include/system/replay.h
+++ b/include/system/replay.h
@@ -186,6 +186,24 @@ void replay_vmstate_init(void);
 /*! Called to ensure that replay state is consistent and VM snapshot
     can be created */
 bool replay_can_snapshot(void);
+/**
+ * replay_can_load_snapshot:
+ *
+ * A snapshot load while recording or replaying is not in the log, so the
+ * replay could not repeat it: refuse it (with @errp set) unless record/replay
+ * loads it itself (its start snapshot, a reverse-debugging seek), or it is
+ * -loadvm (replay_permit_load()).
+ */
+bool replay_can_load_snapshot(Error **errp);
+/* -loadvm: before the run, and a replay given the same command line loads it too */
+void replay_permit_load(bool permit);
+/**
+ * replay_can_save_snapshot:
+ *
+ * The recording's start snapshot is what its replay loads: refuse a savevm
+ * that would replace it while recording or replaying.
+ */
+bool replay_can_save_snapshot(const char *name, Error **errp);
 
 /**
  * replay_check_timer_stall:
diff --git a/migration/migration-hmp-cmds.c b/migration/migration-hmp-cmds.c
