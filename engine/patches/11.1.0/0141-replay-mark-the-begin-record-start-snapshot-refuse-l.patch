+        return;
+    }
     vm_stop(RUN_STATE_RESTORE_VM);
 
     if (load_snapshot(name, NULL, false, NULL, &err)) {
diff --git a/migration/savevm.c b/migration/savevm.c
index e19f6420a610a8d63f32e2c98d9ea7c5f4fe7a50..490aa7e5ae056780c82308566bb327cfcb232cae 100644
--- a/migration/savevm.c
+++ b/migration/savevm.c
@@ -3303,6 +3303,9 @@ bool save_snapshot(const char *name, bool overwrite, const char *vmstate,
         return false;
     }
 
+    if (!replay_can_save_snapshot(name, errp)) {
+        return false;
+    }
     if (!replay_can_snapshot()) {
         error_setg(errp, "Record/replay does not allow making snapshot "
                    "right now. Try once more later.");
@@ -3490,6 +3493,9 @@ bool load_snapshot(const char *name, const char *vmstate,
     if (!migrate_can_snapshot(errp)) {
         return false;
     }
+    if (!replay_can_load_snapshot(errp)) {
+        return false;
+    }
 
     if (!bdrv_all_can_snapshot(has_devices, devices, errp)) {
         return false;
@@ -3643,6 +3649,11 @@ static void snapshot_load_job_bh(void *opaque)
 
     job_progress_set_remaining(&s->common, 1);
 
+    /* refused before the VM stops, so it keeps running */
+    if (!replay_can_load_snapshot(s->errp)) {
+        s->ret = false;
+        goto out;
+    }
     vm_stop(RUN_STATE_RESTORE_VM);
 
     s->ret = load_snapshot(s->tag, s->vmstate, true, s->devices, s->errp);
@@ -3650,6 +3661,7 @@ static void snapshot_load_job_bh(void *opaque)
         load_snapshot_resume(orig_state);
     }
 
+out:
     job_progress_update(&s->common, 1);
 
     qmp_snapshot_job_free(s);
diff --git a/replay/replay-internal.h b/replay/replay-internal.h
index 1ff43cd59429afe9ee925321a14693014b2953f1..f891f1e46a72d3e1d0dbf17358f9554a17c38f06 100644
--- a/replay/replay-internal.h
+++ b/replay/replay-internal.h
@@ -98,6 +98,12 @@ typedef struct ReplayState {
     uint64_t block_request_id;
     uint64_t read_event_id;
     size_t n_audio_samples;
+    /*
+     * x-rr-begin-record's start snapshot: true while it is saved (the
+     * "replay/begin" subsection marks it), and after a load of a snapshot
+     * so marked
+     */
+    bool begin_start;
 } ReplayState;
 extern ReplayState replay_state;
 
diff --git a/replay/replay-random.c b/replay/replay-random.c
index 7f4c46f74d9cd7bbb635151af23f4f21641bb1c2..33330e195acee853450a49c65d0d6897f51abde9 100644
