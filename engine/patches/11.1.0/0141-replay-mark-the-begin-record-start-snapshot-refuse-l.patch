--- a/replay/replay.c
+++ b/replay/replay.c
@@ -352,6 +352,10 @@ void replay_check_timer_stall(void)
     int64_t now_ms;
 
     g_assert(replay_mutex_locked());
+    /*
+     * Not the caller's deadline: that one was taken before it ran the
+     * timers, and only a timer still expired after the run is stuck.
+     */
     if (qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
                                    QEMU_TIMER_ATTR_ALL) != 0) {
         rounds = 0;
diff --git a/replay/stubs-system.c b/replay/stubs-system.c
