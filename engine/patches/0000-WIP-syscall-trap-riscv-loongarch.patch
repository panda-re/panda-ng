+/*
+ * The syscall trap (system/syscall-trap.h).
+ *
+ * The task key: no register names the task while it runs at PLV3.  Linux
+ * keeps its thread_info in tp in the kernel and restores the user's tp
+ * only after it has written ERA on the way out (RESTORE_SOME), so the last
+ * kernel value of tp at a csrwr of ERA (trans_privileged.c.inc, into
+ * CPUState.syscall_current) is the task the CPU last returned to user
+ * mode: the same at a call's entry and at its return.  The user stack
+ * pointer is the second word.  Until the kernel has written ERA with a
+ * kernel tp (after a reset, or a snapshot restore until the next exception
+ * return), the key is the address space (PGDL).  percpu: the kernel's
+ * per-CPU base, which Linux keeps in KS3 (PERCPU_BASE_KS).
+ */
+#define LA_SC_KMMU (1u << MMU_KERNEL_IDX)
+#define LA_A0 4
+#define LA_A7 11
+#define LA_SP 3
+
+static uint64_t loongarch_sc_key(CPULoongArchState *env)
+{
+    uint64_t cur = env_cpu(env)->syscall_current;
+
+    return cur >> 63 ? cur : env_sys(env)->CSR_PGDL | 1;
+}
+
+static uint64_t loongarch_sc_percpu(CPULoongArchState *env)
+{
+    return env_sys(env)->CSR_SAVE[3];
+}
+
+/* syscall from PLV3: report it; true if the consumer skipped it */
+static bool loongarch_sc_enter(CPULoongArchState *env)
+{
+    CPUState *cs = env_cpu(env);
+    uint64_t args[6], ret;
+    int r;
+
+    memcpy(args, &env->gpr[LA_A0], sizeof(args));
+    cs->syscall_inject_abis = 1u << SYSCALL_ABI_LOONGARCH64;
+    /*
+     * Linux returns past the syscall (do_syscall: era += 4).  A fault: the
+     * PC is at the syscall, still at PLV3, so the fault returns there and
+     * the syscall traps again.
+     */
+    while ((r = syscall_trap_enter(cs, SYSCALL_ABI_LOONGARCH64,
+                                   (int64_t)env->gpr[LA_A7], args,
+                                   env->pc + 4, 4, loongarch_sc_key(env),
+                                   env->gpr[LA_SP], loongarch_sc_percpu(env),
+                                   LA_SC_KMMU, &ret)) & SYSCALL_TRAP_FAULT) {
+        syscall_trap_fault(cs, 0);
+    }
+    if (r & (SYSCALL_TRAP_ARGS | SYSCALL_TRAP_INJECT)) {
+        memcpy(&env->gpr[LA_A0], args, sizeof(args));
+    }
+    if (r & SYSCALL_TRAP_INJECT) {
+        env->gpr[LA_A7] = ret;
+    }
+    if (r & SYSCALL_TRAP_SKIP) {
+        env->gpr[LA_A0] = ret;
+        set_pc(env, env->pc + 4);
+        return true;
+    }
+    return false;
+}
+
+/*
+ * ertn back to PLV3 (helper_ertn: the PC and PLV are set) while a call is
+ * pending: report the return, and put back what an injection changed.
+ */
+void loongarch_sc_return(CPULoongArchState *env)
+{
+    CPUState *cs = env_cpu(env);
+
+    for (;;) {
+        uint64_t ret = env->gpr[LA_A0];
+        SyscallTrapRewind rw = { .abi = -1 };
+        int r = syscall_trap_return(cs, env->pc, loongarch_sc_key(env),
+                                    env->gpr[LA_SP], loongarch_sc_percpu(env),
+                                    LA_SC_KMMU, &ret, &rw);
+
+        if (rw.abi != SYSCALL_ABI_LOONGARCH64) {
+            r &= ~(SYSCALL_TRAP_REWIND | SYSCALL_TRAP_RESTORE);
+        }
+        if (r & SYSCALL_TRAP_REWIND) {
+            /* an injected call is back: the task's own call, again */
+            env->gpr[LA_A7] = rw.num;
+            memcpy(&env->gpr[LA_A0], rw.args, sizeof(rw.args));
+            set_pc(env, env->pc - rw.len);
+            return;
+        }
+        if (r & SYSCALL_TRAP_RESTORE) {
+            /* back from a call injected at the return: this call's registers */
+            env->gpr[LA_A7] = rw.num;
+            memcpy(&env->gpr[LA_A0 + 1], &rw.args[1], 5 * sizeof(rw.args[0]));
+        }
+        if (r & SYSCALL_TRAP_RET) {
+            env->gpr[LA_A0] = ret;
+        }
+        if (!(r & SYSCALL_TRAP_FAULT)) {
+            return;
+        }
+        /* the state is exact: the task is back at PLV3 */
+        syscall_trap_fault(cs, 0);
+    }
+}
