+/*
+ * The syscall trap (system/syscall-trap.h).
+ *
+ * The task key is sscratch: Linux writes the current task (tp) there on
+ * every return to user mode and swaps it back into tp at the next trap, so
+ * while a task runs in U-mode sscratch is that task's task_struct, the same
+ * at a call's entry and at its return, on any hart.  The user stack pointer
+ * is the second word.  A kernel that leaves sscratch 0 gets the address
+ * space (satp) instead.
+ */
+uint64_t riscv_sc_key(CPURISCVState *env)
+{
+    return env->sscratch ? env->sscratch : (env->satp | 1);
+}
+
+/* the kernel's MMU indexes, for reads from a callback in U-mode */
+#define RISCV_SC_KMMU ((1u << MMUIdx_S) | (1u << MMUIdx_S_SUM))
+
+static inline bool riscv_sc_is32(CPURISCVState *env)
+{
+    return riscv_cpu_xlen(env) == 32;
+}
+
+/* what a U-mode register holds for @v: sign-extended in a 32-bit task */
+static inline target_ulong riscv_sc_reg(CPURISCVState *env, uint64_t v)
+{
+    return riscv_sc_is32(env) ? (target_ulong)(int32_t)v : (target_ulong)v;
+}
+
+static uint32_t riscv_sc_inject_abis(CPURISCVState *env)
+{
+    return riscv_cpu_mxl(env) == MXL_RV32 ? 1u << SYSCALL_ABI_RISCV32 :
+           (1u << SYSCALL_ABI_RISCV64) | (1u << SYSCALL_ABI_RISCV32);
+}
+
+/* ecall from U-mode: report the syscall; true if the consumer skipped it */
+static bool riscv_sc_enter(CPURISCVState *env)
+{
+    CPUState *cs = env_cpu(env);
+    bool is32 = riscv_sc_is32(env);
+    int abi = is32 ? SYSCALL_ABI_RISCV32 : SYSCALL_ABI_RISCV64;
+    int64_t num = is32 ? (uint32_t)env->gpr[xA7] : (int64_t)env->gpr[xA7];
+    uint64_t args[6], ret;
+    int r;
+
+    for (int i = 0; i < 6; i++) {
+        args[i] = is32 ? (uint32_t)env->gpr[xA0 + i] : env->gpr[xA0 + i];
+    }
+    cs->syscall_inject_abis = riscv_sc_inject_abis(env);
+    /*
+     * Linux returns past the ecall (do_trap_ecall_u: epc += 4).  A fault:
+     * the PC is at the ecall, still in U-mode, so the fault returns there
+     * and the ecall traps again.
+     */
+    while ((r = syscall_trap_enter(cs, abi, num, args, env->pc + 4, 4,
+                                   riscv_sc_key(env), env->gpr[xSP],
+                                   env->sscratch, RISCV_SC_KMMU, &ret)) &
+           SYSCALL_TRAP_FAULT) {
+        syscall_trap_fault(cs, 0);
+    }
+    if (r & (SYSCALL_TRAP_ARGS | SYSCALL_TRAP_INJECT)) {
+        for (int i = 0; i < 6; i++) {
+            env->gpr[xA0 + i] = riscv_sc_reg(env, args[i]);
+        }
+    }
+    if (r & SYSCALL_TRAP_INJECT) {
+        env->gpr[xA7] = riscv_sc_reg(env, ret);
+    }
+    if (r & SYSCALL_TRAP_SKIP) {
+        env->gpr[xA0] = riscv_sc_reg(env, ret);
+        env->pc += 4;
+        return true;
+    }
+    return false;
+}
+
+/*
+ * sret or mret back to U-mode (not VU) at @retpc while a call is pending:
+ * report the return, and put back what an injection changed.  Returns the
+ * PC to resume at.
+ */
+target_ulong riscv_sc_return(CPURISCVState *env, target_ulong retpc)
+{
+    CPUState *cs = env_cpu(env);
+
+    for (;;) {
+        uint64_t ret = env->gpr[xA0];
+        SyscallTrapRewind rw;
+        int r = syscall_trap_return(cs, retpc, riscv_sc_key(env),
+                                    env->gpr[xSP], env->sscratch,
+                                    RISCV_SC_KMMU, &ret, &rw);
+
+        if ((r & (SYSCALL_TRAP_REWIND | SYSCALL_TRAP_RESTORE)) &&
+            rw.abi != SYSCALL_ABI_RISCV64 && rw.abi != SYSCALL_ABI_RISCV32) {
+            r &= ~(SYSCALL_TRAP_REWIND | SYSCALL_TRAP_RESTORE);
+        }
+        if (r & SYSCALL_TRAP_REWIND) {
+            /* an injected call is back: the task's own call, again */
+            env->gpr[xA7] = riscv_sc_reg(env, rw.num);
+            for (int i = 0; i < 6; i++) {
+                env->gpr[xA0 + i] = riscv_sc_reg(env, rw.args[i]);
+            }
+            return retpc - rw.len;
+        }
+        if (r & SYSCALL_TRAP_RESTORE) {
+            /* back from a call injected at the return: this call's registers */
+            env->gpr[xA7] = riscv_sc_reg(env, rw.num);
+            for (int i = 1; i < 6; i++) {
+                env->gpr[xA0 + i] = riscv_sc_reg(env, rw.args[i]);
+            }
+        }
+        if (r & SYSCALL_TRAP_RET) {
+            env->gpr[xA0] = riscv_sc_reg(env, ret);
+        }
+        if (!(r & SYSCALL_TRAP_FAULT)) {
+            return retpc;
+        }
+        /* the fault is taken in U-mode at the return address */
+        env->pc = retpc;
+        syscall_trap_fault(cs, 0);
+    }
+}
