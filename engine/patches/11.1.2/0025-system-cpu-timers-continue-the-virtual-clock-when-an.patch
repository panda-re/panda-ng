From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Wed, 21 Oct 2026 12:54:12 -0400
Subject: [PATCH] system/cpu-timers: continue the virtual clock when an icount
 process loads a non-icount snapshot

When icount is on and the snapshot has no icount subsection (it was taken without icount, or under
KVM), set qemu_icount_bias from cpu_clock_offset, the virtual time at which the saver stopped, so
QEMU_CLOCK_VIRTUAL continues instead of restarting near 0 under timers armed at the old time.
Also re-arm icount_vm_timer at now + 100 ms: icount_configure() armed it at ~0, so it is already
expired here, and a replay that loads the snapshot gets it as vCPU work with no checkpoint and
waits forever. Records whether the clock domain changed, for the TSC fix that follows.

From observe's rr spike (gate/rrux, P1 + P1b).

SPDX-License-Identifier: GPL-2.0-or-later AND MIT
Origin: new
---
 include/system/cpu-timers.h |  2 ++
 system/cpu-timers.c         | 60 +++++++++++++++++++++++++++++++++++++
 2 files changed, 62 insertions(+)

diff --git a/include/system/cpu-timers.h b/include/system/cpu-timers.h
index a1abed0d7a07bbf9607505a9ef7191db6b2ee5f4..c00abafa99bfc5b9e3aaea1cfba7fd15124089cc 100644
--- a/include/system/cpu-timers.h
+++ b/include/system/cpu-timers.h
@@ -35,6 +35,8 @@ int64_t cpu_get_ticks(void);
  * the time between vm_start and vm_stop
  */
 int64_t cpu_get_clock(void);
+/* rrux: true after loading a snapshot taken without icount into an icount process */
+bool cpu_timers_clock_domain_changed(void);
 
 void qemu_timer_notify_cb(void *opaque, QEMUClockType type);
 
diff --git a/system/cpu-timers.c b/system/cpu-timers.c
index 9919b46230f1caf8be1a1b6ef00acd94678437ce..f6ae04549d2dbcf560808e9d224defb3f2678ca2 100644
--- a/system/cpu-timers.c
+++ b/system/cpu-timers.c
@@ -140,6 +140,63 @@ static bool icount_state_needed(void *opaque)
     return icount_enabled();
 }
 
+/*
+ * rrux: a snapshot taken without icount, loaded into a process with icount
+ * (the "record from a running VM" path).  Without this the guest's
+ * QEMU_CLOCK_VIRTUAL restarts at qemu_icount_bias (~0) while every guest
+ * timer in the snapshot is armed at the old virtual time.
+ */
+static bool icount_state_loaded;
+static bool clock_domain_changed;
+
+bool cpu_timers_clock_domain_changed(void)
+{
+    return clock_domain_changed;
+}
+
+static int timers_pre_load(void *opaque)
+{
+    icount_state_loaded = false;
+    clock_domain_changed = false;
+    return 0;
+}
+
+static int icount_timers_post_load(void *opaque, int version_id)
+{
+    icount_state_loaded = true;
+    return 0;
+}
+
+static int timers_post_load(void *opaque, int version_id)
+{
+    TimersState *s = opaque;
+
+    if (icount_enabled() && !icount_state_loaded) {
+        /*
+         * cpu_clock_offset holds the virtual time at which the saving VM
+         * stopped (cpu_disable_ticks).  Continue from there.
+         */
+        s->qemu_icount_bias = s->cpu_clock_offset -
+                              icount_to_ns(qatomic_read(&s->qemu_icount));
+        clock_domain_changed = true;
+        /*
+         * The icount adjust timers were armed by icount_configure() at
+         * virtual time ~0 and the snapshot has no state for them.  Left
+         * alone they are already expired here, fire through the main loop
+         * (a CHECKPOINT_CLOCK_VIRTUAL in the log), while a replay loading
+         * the rrsnapshot gets them through timer_mod() of an expired timer,
+         * which util/qemu-timer.c turns into vCPU work with no checkpoint:
+         * the replay waits for that checkpoint forever.
+         */
+        if (s->icount_vm_timer) {
+            timer_mod(s->icount_vm_timer,
+                      qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                      NANOSECONDS_PER_SECOND / 10);
+        }
+    }
+    return 0;
+}
+
 static bool warp_timer_state_needed(void *opaque)
 {
     TimersState *s = opaque;
@@ -204,6 +261,7 @@ static const VMStateDescription icount_vmstate_timers = {
     .version_id = 1,
     .minimum_version_id = 1,
     .needed = icount_state_needed,
+    .post_load = icount_timers_post_load,
     .fields = (const VMStateField[]) {
         VMSTATE_INT64(qemu_icount_bias, TimersState),
         VMSTATE_INT64(qemu_icount, TimersState),
@@ -221,6 +279,8 @@ static const VMStateDescription vmstate_timers = {
     .name = "timer",
     .version_id = 2,
     .minimum_version_id = 1,
+    .pre_load = timers_pre_load,
+    .post_load = timers_post_load,
     .fields = (const VMStateField[]) {
         VMSTATE_INT64(cpu_ticks_offset, TimersState),
         VMSTATE_UNUSED(8),
