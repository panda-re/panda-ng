diff --git a/system/vl.c b/system/vl.c
index 4afa05bb93f7eeed9808840d0c5e6ca88eddb251..133c5ec29908332ea6b5bd8d68c31b6e13528e4d 100644
--- a/system/vl.c
+++ b/system/vl.c
@@ -23,6 +23,7 @@
  */
 
 #include "qemu/osdep.h"
+#include "system/capabilities.h"
 #include "qemu/help-texts.h"
 #include "qemu/datadir.h"
 #include "qemu/units.h"
@@ -2784,6 +2785,34 @@ static void qemu_init_displays(void)
     }
 }
 
+/*
+ * Choose the startup capabilities before option, module and plugin processing can run anything
+ * that depends on them. The real option table gives each option its arity, so an option-looking
+ * argument of -append or -device is not an option. The last -capabilities wins. Without one, a
+ * run has none, unless an embedding chose them first (panda_configure_capabilities); a
+ * -capabilities must then repeat that choice.
+ */
+static bool seal_startup_capabilities(int argc, char **argv, Error **errp)
+{
+    uint32_t requested = startup_caps();
+    int optind = 1;
+    const char *optarg;
+
+    while (optind < argc) {
+        if (argv[optind][0] != '-') {
+            optind++; /* positional disk image, as in normal parsing */
+        } else {
+            const QEMUOption *popt = lookup_opt(argc, argv, &optarg, &optind);
+
+            if (popt->index == QEMU_OPTION_capabilities &&
+                !startup_caps_parse(optarg, &requested, errp)) {
+                return false;
+            }
+        }
+    }
+    return startup_caps_seal(requested, errp);
+}
+
 static void qemu_init_board(void)
 {
     MachineClass *machine_class = MACHINE_GET_CLASS(current_machine);
@@ -2932,6 +2961,10 @@ void qemu_init(int argc, char **argv)
     bool userconfig = true;
     FILE *vmstate_dump_file = NULL;
 
+    /* Before option, module and plugin processing can run constructors. */
+    error_init(argv[0]);
+    seal_startup_capabilities(argc, argv, &error_fatal);
+
     qemu_add_opts(&qemu_drive_opts);
     qemu_add_drive_opts(&qemu_legacy_drive_opts);
     qemu_add_drive_opts(&qemu_common_drive_opts);
@@ -2966,7 +2999,6 @@ void qemu_init(int argc, char **argv)
     qemu_add_run_with_opts();
     module_call_init(MODULE_INIT_OPTS);
 
-    error_init(argv[0]);
     qemu_init_exec_dir(argv[0]);
 
     os_setup_limits();
@@ -3667,6 +3699,9 @@ void qemu_init(int argc, char **argv)
             case QEMU_OPTION_plugin:
                 qemu_plugin_opt_parse(optarg, &plugin_list);
                 break;
+            case QEMU_OPTION_capabilities:
