 hw/virtio/vhost-stub.c    |  5 +++++
 hw/virtio/vhost.c         |  5 +++++
 include/hw/virtio/vhost.h |  2 ++
 include/system/replay.h   |  8 ++++++++
 replay/replay-internal.h  |  2 --
 replay/stubs-system.c     |  4 ++++
 system/vl.c               | 32 ++++++++++++++++++++++++++++++++
 8 files changed, 68 insertions(+), 4 deletions(-)

diff --git a/accel/tcg/tcg-all.c b/accel/tcg/tcg-all.c
index aaa4dd8ab7314fb252eb2198fc04fd706f10a31f..cca3af2c6efbe347163e40df7f4b28a635996957 100644
--- a/accel/tcg/tcg-all.c
+++ b/accel/tcg/tcg-all.c
@@ -38,6 +38,9 @@
 #include "qemu/target-info.h"
 #include "qom/compat-properties.h"
 #ifndef CONFIG_USER_ONLY
+#include "system/capabilities.h"
+#endif
+#ifndef CONFIG_USER_ONLY
 #include "hw/core/boards.h"
 #include "exec/tb-flush.h"
 #include "system/runstate.h"
@@ -114,7 +117,13 @@ static int tcg_init_machine(AccelState *as, MachineState *ms)
     CPUClass *cc = CPU_CLASS(object_class_by_name(target_cpu_type()));
     bool mttcg_supported = cc->tcg_ops->mttcg_supported;
 
+    /* The record capability launches a recordable machine. */
+    if (startup_caps_has(STARTUP_CAP_RECORD)) {
+        s->rr_ready = true;
+    }
     if (s->rr_ready) {
+        const char *why = startup_caps_has(STARTUP_CAP_RECORD) ?
+                          "-capabilities record" : "rr-ready";
         /*
          * What x-rr-begin-record cannot change on a running VM: one vCPU
          * thread, virtio kicks as MMIO exits rather than eventfds (devices
@@ -122,11 +131,12 @@ static int tcg_init_machine(AccelState *as, MachineState *ms)
          * icount comes on.
          */
         if (s->mttcg_enabled == ON_OFF_AUTO_ON) {
-            error_report("rr-ready needs thread=single");
+            error_report("%s: thread=multi can't be recorded (one TCG thread)",
+                         why);
             return -1;
         }
         if (ms->smp.max_cpus > 1) {
-            error_report("rr-ready: record/replay supports one vCPU (-smp 1)");
+            error_report("%s: record/replay supports one vCPU (-smp 1)", why);
             return -1;
         }
         s->mttcg_enabled = ON_OFF_AUTO_OFF;
