 #include "qapi/qapi-events-run-state.h"
 #include "qapi/qapi-types-audio.h"
 #include "qapi/qapi-visit-audio.h"
@@ -2868,6 +2869,33 @@ static void qemu_create_cli_devices(void)
     }
 }
 
+/*
+ * -capabilities record: refuse, with the reason, a machine whose arguments
+ * can't be recorded. The accelerator's own checks (one TCG thread, one vCPU)
+ * ran when it started.
+ */
+static bool record_startup_check(Error **errp)
+{
+    Error *err = NULL;
+
+    if (!tcg_enabled()) {
+        error_setg(errp, "-capabilities record: recording needs TCG, and this "
+                   "run uses %s", current_accel_name());
+        return false;
+    }
+    if (replay_check_blockers(&err)) {
+        error_propagate_prepend(errp, err, "-capabilities record: ");
+        return false;
+    }
+    if (vhost_has_dev()) {
+        error_setg(errp, "-capabilities record: a vhost backend (vhost=on, "
+                   "vhost-user, vhost-vdpa) handles device I/O outside the "
+                   "log");
+        return false;
+    }
+    return true;
+}
+
 static bool qemu_machine_creation_done(Error **errp)
 {
     MachineState *machine = MACHINE(qdev_get_machine());
@@ -2899,6 +2927,10 @@ static bool qemu_machine_creation_done(Error **errp)
 
     foreach_device_config_or_exit(DEV_GDB, gdbserver_start);
 
+    if (startup_caps_has(STARTUP_CAP_RECORD) && !record_startup_check(errp)) {
+        return false;
+    }
+
     if (!vga_interface_created && !default_vga &&
         vga_interface_type != VGA_NONE) {
         warn_report("A -vga option was passed but this machine "
