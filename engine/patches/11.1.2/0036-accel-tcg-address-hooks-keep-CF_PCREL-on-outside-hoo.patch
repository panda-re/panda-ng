Origin: new
---
 accel/tcg/cpu-exec.c      | 73 ++++++++++++++++++++++++++++-----------
 accel/tcg/tcg-accel-ops.c |  2 +-
 accel/tcg/translator.c    | 10 ++++++
 3 files changed, 64 insertions(+), 21 deletions(-)

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 5a8cd5725bfbeb3f60113e11b9160d7396797cfd..d7727680c96670201ff4bdc6109d0ee78f5694fd 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -46,6 +46,7 @@
 #include "tb-context.h"
 #include "tb-internal.h"
 #include "internal-common.h"
+#include "hooks-internal.h"
 #if !defined(CONFIG_USER_ONLY)
 #include "accel/tcg/iommu.h"
 #endif
@@ -227,25 +228,30 @@ static TranslationBlock *tb_htable_lookup(CPUState *cpu, TCGTBCPUState s)
  *
  * Returns: an existing translation block or NULL.
  */
-static inline TranslationBlock *tb_lookup(CPUState *cpu, TCGTBCPUState s)
+/*
+ * A jump-cache miss: the page's hook cflags, the hash table, and the
+ * jump-cache fill.  Out of line, so tb_lookup()'s hit path stays inlined
+ * into its callers as upstream's is.
+ */
+static TranslationBlock * __attribute__((noinline))
+tb_lookup_miss(CPUState *cpu, TCGTBCPUState s, TranslationBlock *tb,
+               CPUJumpCache *jc, uint32_t hash)
 {
-    TranslationBlock *tb;
-    CPUJumpCache *jc;
-    uint32_t hash;
-
-    /* we should never be trying to look up an INVALID tb */
-    tcg_debug_assert(!(s.cflags & CF_INVALID));
-
-    hash = tb_jmp_cache_hash_func(s.pc);
-    jc = cpu->tb_jmp_cache;
-
-    tb = qatomic_read(&jc->array[hash].tb);
-    if (likely(tb &&
-               jc->array[hash].pc == s.pc &&
-               tb->cs_base == s.cs_base &&
-               tb->flags == s.flags &&
-               tb_cflags(tb) == s.cflags)) {
-        goto hit;
+    /*
+     * Address hooks: a page that holds a hook site gets blocks translated
+     * for their virtual address (tcg_hooks_cflags).  The jump cache holds
+     * only blocks looked up with their page's cflags (a hooks commit
+     * empties it), so the hit in tb_lookup() needs no check of its own.
+     */
+    if (tcg_hooks_cflags(s.pc, s.cflags) != s.cflags) {
+        s.cflags = tcg_hooks_cflags(s.pc, s.cflags);
+        if (tb &&
+            jc->array[hash].pc == s.pc &&
+            tb->cs_base == s.cs_base &&
+            tb->flags == s.flags &&
+            tb_cflags(tb) == s.cflags) {
+            return tb;
+        }
     }
 
     tb = tb_htable_lookup(cpu, s);
@@ -261,8 +267,33 @@ static inline TranslationBlock *tb_lookup(CPUState *cpu, TCGTBCPUState s)
     assert(!tb_pc_exact(tb) || tb->pc == s.pc);
     jc->array[hash].pc = s.pc;
     qatomic_set(&jc->array[hash].tb, tb);
+    return tb;
+}
+
+static inline TranslationBlock *tb_lookup(CPUState *cpu, TCGTBCPUState s)
+{
+    TranslationBlock *tb;
+    CPUJumpCache *jc;
+    uint32_t hash;
+
+    /* we should never be trying to look up an INVALID tb */
+    tcg_debug_assert(!(s.cflags & CF_INVALID));
+
+    hash = tb_jmp_cache_hash_func(s.pc);
+    jc = cpu->tb_jmp_cache;
+
+    tb = qatomic_read(&jc->array[hash].tb);
+    if (unlikely(!(tb &&
+                   jc->array[hash].pc == s.pc &&
+                   tb->cs_base == s.cs_base &&
+                   tb->flags == s.flags &&
+                   tb_cflags(tb) == s.cflags))) {
+        tb = tb_lookup_miss(cpu, s, tb, jc, hash);
+        if (tb == NULL) {
+            return NULL;
+        }
+    }
 
-hit:
     /*
      * As long as tb is not NULL, the contents are consistent.  Therefore,
      * the virtual PC has to match for non-CF_PCREL translations.
@@ -580,7 +611,7 @@ void cpu_exec_step_atomic(CPUState *cpu)
         cpu->running = true;
 
         TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
-        s.cflags = curr_cflags(cpu);
+        s.cflags = tcg_hooks_cflags(s.pc, curr_cflags(cpu));
 
         /* Execute in a serial context. */
         s.cflags &= ~CF_PARALLEL;
@@ -990,6 +1021,8 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
                 CPUJumpCache *jc;
                 uint32_t h;
 
+                /* tb_lookup() asked for these; translate with them */
+                s.cflags = tcg_hooks_cflags(s.pc, s.cflags);
                 mmap_lock();
                 tb = tb_gen_code(cpu, s);
                 mmap_unlock();
diff --git a/accel/tcg/tcg-accel-ops.c b/accel/tcg/tcg-accel-ops.c
index eaf546dd68a1e6e950170e05dff7fcef21c79d71..7668e55254a462fd0b4539e85119ca632314a81c 100644
--- a/accel/tcg/tcg-accel-ops.c
+++ b/accel/tcg/tcg-accel-ops.c
@@ -70,7 +70,7 @@ void tcg_cpu_init_cflags(CPUState *cpu, bool parallel)
     cflags |= parallel ? CF_PARALLEL : 0;
     cflags |= icount_enabled() ? CF_USE_ICOUNT : 0;
     tcg_cflags_set(cpu, cflags);
-    tcg_hooks_vcpu_cflags(cpu);
+    tcg_hooks_vcpu_init(cpu);
 }
 
 void tcg_cpu_destroy(CPUState *cpu)
diff --git a/accel/tcg/translator.c b/accel/tcg/translator.c
index aaa48ed9b74d7f401f63ea951f2f349026f3d19c..89a6d6f3481989471771236af7f2f4ba879b5ad2 100644
--- a/accel/tcg/translator.c
+++ b/accel/tcg/translator.c
@@ -206,6 +206,16 @@ void translator_loop(CPUState *cpu, TranslationBlock *tb, int *max_insns,
             db->is_jmp = DISAS_TOO_MANY;
             break;
         }
+
+        /*
+         * While address hooks are in use, a CF_PCREL TB stays on its first
+         * page: that page has no hook site, but the next one may get one.
+         */
+        if (unlikely(qatomic_read(&tcg_hooks_enabled)) && (cflags & CF_PCREL)
+            && !translator_is_same_page(db, db->pc_next)) {
+            db->is_jmp = DISAS_TOO_MANY;
+            break;
+        }
     }
 
     /* Emit code to exit the TB, as indicated by db->is_jmp.  */
