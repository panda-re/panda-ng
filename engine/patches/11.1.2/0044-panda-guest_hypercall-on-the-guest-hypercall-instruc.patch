From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Thu, 22 Oct 2026 10:15:32 -0400
Subject: [PATCH] panda: guest_hypercall on the guest hypercall instruction

When the embedding API's consumers do not take a hypercall, offer it to PANDA's guest_hypercall
callback. A plugin that handles it sets the guest's registers itself, so the helper returns the
current value of its destination register (x0/r0 on arm, v0 on mips, r3 on ppc, a0 on loongarch
and riscv) instead of the one it read; x86 marks the vCPU dirty. The embedding API's consumers
keep priority. Replaces pandang 0007, 0008, 0010, 0011, 0013-0015, which added PANDA's own
hypercall instructions (cpuid on x86, an MCR on arm): with this series the guest uses one
hypercall instruction per target.

SPDX-License-Identifier: GPL-2.0-or-later AND LGPL-2.1-or-later AND MIT
Origin: new
---
 hw/i386/pc.c                     | 5 +++++
 target/arm/tcg/op_helper.c       | 5 +++++
 target/loongarch/tcg/op_helper.c | 5 +++++
 target/mips/tcg/op_helper.c      | 5 +++++
 target/ppc/misc_helper.c         | 5 +++++
 target/riscv/tcg/op_helper.c     | 5 +++++
 6 files changed, 30 insertions(+)

diff --git a/hw/i386/pc.c b/hw/i386/pc.c
index f2f8784ccec43bae69574008dc7db7f85478a87d..6fdc783e7393bc1ccc3d4f1dda2e95dd303c719f 100644
--- a/hw/i386/pc.c
+++ b/hw/i386/pc.c
@@ -43,6 +43,7 @@
 #include "hw/audio/pcspk.h"
 #include "system/system.h"
 #include "system/panda-embed.h"
+#include "panda/hooks.h"
 #include "system/qtest.h"
 #include "system/xen.h"
 #include "system/reset.h"
@@ -248,6 +249,8 @@ static void ioport88_write(void *opaque, hwaddr addr, uint64_t data,
                                          &ret)) {
             env->regs[R_EAX] = ret;
             cs->vcpu_dirty = true;
+        } else if (panda_callbacks_guest_hypercall(cs)) {
+            cs->vcpu_dirty = true;
         }
         return;
     }
@@ -263,6 +266,8 @@ static void ioport88_write(void *opaque, hwaddr addr, uint64_t data,
                                      &ret)) {
         env->regs[R_EAX] = (uint32_t)ret;
         cs->vcpu_dirty = true;
+    } else if (panda_callbacks_guest_hypercall(cs)) {
+        cs->vcpu_dirty = true;
     }
 }
 
diff --git a/target/arm/tcg/op_helper.c b/target/arm/tcg/op_helper.c
index a57fe8f050ba14b55d54c6f735c7acb399e12986..34997eb4e4d050b04b413bbef5bb635c4f6b8ea4 100644
--- a/target/arm/tcg/op_helper.c
+++ b/target/arm/tcg/op_helper.c
@@ -27,6 +27,7 @@
 #include "accel/tcg/probe.h"
 #include "cpregs.h"
 #include "system/panda-embed.h"
+#include "panda/hooks.h"
 #ifndef CONFIG_USER_ONLY
 #include "system/syscall-trap.h"
 #endif
@@ -99,6 +100,10 @@ uint64_t HELPER(guest_hypercall)(CPUARMState *env, uint64_t nr,
     if (panda_handle_guest_hypercall(cs, nr, a0, a1, a2, a3, a4, 0, &ret)) {
         return ret;
     }
+    /* Not taken by the embedding API: offer it to PANDA, whose plugins set registers themselves */
+    if (panda_callbacks_guest_hypercall(cs)) {
+        return is_a64(env) ? env->xregs[0] : env->regs[0];
+    }
     return a0;
 }
 
diff --git a/target/loongarch/tcg/op_helper.c b/target/loongarch/tcg/op_helper.c
index 4c1e2e9def313a455e6a67390d94cdcc56fd1576..755579eb50171b53355e9f6d7781d0d00786adea 100644
--- a/target/loongarch/tcg/op_helper.c
+++ b/target/loongarch/tcg/op_helper.c
@@ -16,6 +16,7 @@
 #include <zlib.h> /* for crc32 */
 #include "cpu-csr.h"
 #include "system/panda-embed.h"
+#include "panda/hooks.h"
 
 /* Exceptions helpers */
 void helper_raise_exception(CPULoongArchState *env, uint32_t exception)
@@ -35,6 +36,10 @@ target_ulong helper_guest_hypercall(CPULoongArchState *env,
     if (panda_handle_guest_hypercall(cs, nr, a0, a1, a2, a3, a4, 0, &ret)) {
         return ret;
     }
+    /* Not taken by the embedding API: offer it to PANDA, whose plugins set registers themselves */
+    if (panda_callbacks_guest_hypercall(cs)) {
+        return env->gpr[4];
+    }
     return a0;
 }
 
diff --git a/target/mips/tcg/op_helper.c b/target/mips/tcg/op_helper.c
index 3996a4cf3f4cdefc5dbe1778faa44a9e59c9a9c0..a2feaf7785530487be555a808bd9936fc7ca637b 100644
--- a/target/mips/tcg/op_helper.c
+++ b/target/mips/tcg/op_helper.c
@@ -27,6 +27,7 @@
 #include "qemu/crc32c.h"
 #include "qemu/timer.h"
 #include "system/panda-embed.h"
+#include "panda/hooks.h"
 #include <zlib.h>
 
 static inline target_ulong bitswap(target_ulong v)
@@ -63,6 +64,10 @@ target_ulong helper_guest_hypercall(CPUMIPSState *env, target_ulong nr,
     if (panda_handle_guest_hypercall(cs, nr, a0, a1, a2, a3, a4, 0, &ret)) {
         return ret;
     }
+    /* Not taken by the embedding API: offer it to PANDA, whose plugins set registers themselves */
+    if (panda_callbacks_guest_hypercall(cs)) {
+        return env->active_tc.gpr[2];
+    }
     return nr;
 }
 
diff --git a/target/ppc/misc_helper.c b/target/ppc/misc_helper.c
index 700c75675d256550aa1429e0088246343316120b..d6f5b9007f210693799c63086f1c9dc7331c7033 100644
--- a/target/ppc/misc_helper.c
+++ b/target/ppc/misc_helper.c
@@ -27,6 +27,7 @@
