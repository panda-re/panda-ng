 #include "hw/ppc/ppc.h"
 #include "system/panda-embed.h"
+#include "panda/hooks.h"
 
 #include "helper_regs.h"
 
@@ -55,6 +56,10 @@ target_ulong helper_guest_hypercall(CPUPPCState *env, target_ulong nr,
     if (panda_handle_guest_hypercall(cs, nr, a0, a1, a2, a3, a4, 0, &ret)) {
         return ret;
     }
+    /* Not taken by the embedding API: offer it to PANDA, whose plugins set registers themselves */
+    if (panda_callbacks_guest_hypercall(cs)) {
+        return env->gpr[3];
+    }
     return a0;
 }
 
diff --git a/target/riscv/tcg/op_helper.c b/target/riscv/tcg/op_helper.c
index 716d9970840856ca313f15c12bff04ca6152f3d1..91434dcac0405210063895d886d7cc03e7034262 100644
--- a/target/riscv/tcg/op_helper.c
+++ b/target/riscv/tcg/op_helper.c
@@ -33,6 +33,7 @@
 #include "exec/tlb-flags.h"
 #include "trace.h"
 #include "system/panda-embed.h"
+#include "panda/hooks.h"
 
 /* Exceptions processing helpers */
 G_NORETURN void riscv_raise_exception(CPURISCVState *env,
@@ -68,6 +69,10 @@ target_ulong helper_guest_hypercall(CPURISCVState *env, target_ulong nr,
     if (panda_handle_guest_hypercall(cs, nr, a0, a1, a2, a3, a4, 0, &ret)) {
         return ret;
     }
+    /* Not taken by the embedding API: offer it to PANDA, whose plugins set registers themselves */
+    if (panda_callbacks_guest_hypercall(cs)) {
+        return env->gpr[10];
+    }
     return a0;
 }
 
