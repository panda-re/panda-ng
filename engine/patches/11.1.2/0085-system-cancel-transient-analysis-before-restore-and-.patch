From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Wed, 28 Oct 2026 18:30:00 -0400
Subject: [PATCH] system: cancel transient analysis before restore and reset

Cancel abandoned host-side syscall/plugin analysis at destructive transitions,
independently of successful-load notification. Preserve registration policy.

SPDX-License-Identifier: GPL-2.0-or-later AND MIT
Origin: new
---
 migration/savevm.c | 1 +
 system/runstate.c  | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/migration/savevm.c b/migration/savevm.c
index 951151367f9c0a4be162aa709984e272c07f7bf3..fb4285ae8b60283c273e63269368d188b7a6ea56 100644
--- a/migration/savevm.c
+++ b/migration/savevm.c
@@ -3112,6 +3112,7 @@ int qemu_loadvm_state(QEMUFile *f, Error **errp)
 
     /* RAM is about to change without dirty bits, whether or not the load succeeds */
     panda_before_loadvm();
+    panda_analysis_reset();
     ret = qemu_loadvm_state_main(f, mis, errp);
     qemu_event_set(&mis->main_thread_load_event);
 
diff --git a/system/runstate.c b/system/runstate.c
index 61adbf7d98d557b37ee258ba49f80d5d521af3f8..d90dd28761d87eb916c40034a16c0e72e85acce2 100644
--- a/system/runstate.c
+++ b/system/runstate.c
@@ -522,6 +522,8 @@ void qemu_system_reset(ShutdownCause reason)
     int ret;
     ResetType type;
 
+    /* Abandon host analysis before reset/rebuild, including failed resets. */
+    panda_analysis_reset();
     cpu_synchronize_all_states();
 
     switch (reason) {
