From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Wed, 21 Oct 2026 12:54:13 -0400
Subject: [PATCH] accel/tcg: x-tsc-vclock, the x86 TSC from the virtual clock
 without icount

-accel tcg,x-tsc-vclock=on makes elapsed ticks (the x86 TSC) follow the virtual clock (1 tick/ns)
in a non-icount TCG VM instead of the host cycle counter, so they keep their value and rate across
a later switch to icount (record from a running VM). From observe's rr spike (gate/rrux, P3); the
spike's runtime icount switch is left for R4.

SPDX-License-Identifier: MIT
Origin: new
---
 accel/tcg/tcg-accel-ops.c |  9 +++++++++
 accel/tcg/tcg-all.c       | 16 ++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/accel/tcg/tcg-accel-ops.c b/accel/tcg/tcg-accel-ops.c
index df1b6bd24a09372c5fb91bdb54fc6fa5b5dc9bb4..eaf546dd68a1e6e950170e05dff7fcef21c79d71 100644
--- a/accel/tcg/tcg-accel-ops.c
+++ b/accel/tcg/tcg-accel-ops.c
@@ -49,6 +49,7 @@
 #include "tcg-accel-ops-mttcg.h"
 #include "tcg-accel-ops-rr.h"
 #include "tcg-accel-ops-icount.h"
+#include "system/cpu-timers.h"
 
 /* common functionality among all TCG variants */
 
@@ -198,6 +199,11 @@ static void tcg_remove_all_gdbstub_breakpoints(CPUState *cpu)
     cpu_watchpoint_remove_all(cpu, BP_GDB);
 }
 
+/* rrux: x-tsc-vclock: in a non-icount TCG VM, elapsed ticks (the x86 TSC)
+ * follow the virtual clock (1 tick/ns) instead of the host cycle counter,
+ * so they keep their value and rate across a later switch to icount. */
+bool tcg_tsc_vclock;
+
 static void tcg_accel_ops_init(AccelClass *ac)
 {
     AccelOpsClass *ops = ac->ops;
@@ -216,6 +222,9 @@ static void tcg_accel_ops_init(AccelClass *ac)
             ops->get_elapsed_ticks = icount_get;
         } else {
             ops->handle_interrupt = tcg_handle_interrupt;
+            if (tcg_tsc_vclock) {
+                ops->get_elapsed_ticks = cpu_get_clock;
+            }
         }
     }
 
diff --git a/accel/tcg/tcg-all.c b/accel/tcg/tcg-all.c
index 7186c10cf02248dc5d20a23fddeb66906ce1ba59..71dd6d86e76ab63951262adee72efe24a270006b 100644
--- a/accel/tcg/tcg-all.c
+++ b/accel/tcg/tcg-all.c
@@ -256,6 +256,17 @@ static void tcg_set_one_insn_per_tb(Object *obj, bool value, Error **errp)
     qatomic_set(&one_insn_per_tb, value);
 }
 
+extern bool tcg_tsc_vclock;
+static bool tcg_get_tsc_vclock(Object *obj, Error **errp)
+{
+    return tcg_tsc_vclock;
+}
+
+static void tcg_set_tsc_vclock(Object *obj, bool value, Error **errp)
+{
+    tcg_tsc_vclock = value;
+}
+
 static void tcg_accel_class_init(ObjectClass *oc, const void *data)
 {
     AccelClass *ac = ACCEL_CLASS(oc);
@@ -286,6 +297,11 @@ static void tcg_accel_class_init(ObjectClass *oc, const void *data)
                                    tcg_set_one_insn_per_tb);
     object_class_property_set_description(oc, "one-insn-per-tb",
         "Only put one guest insn in each translation block");
+
+    object_class_property_add_bool(oc, "x-tsc-vclock",
+                                   tcg_get_tsc_vclock, tcg_set_tsc_vclock);
+    object_class_property_set_description(oc, "x-tsc-vclock",
+        "rrux: elapsed ticks (x86 TSC) follow the virtual clock without icount");
 }
 
 static const TypeInfo tcg_accel_type = {
