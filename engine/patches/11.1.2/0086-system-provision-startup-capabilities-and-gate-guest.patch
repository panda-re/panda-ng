+/* Startup policy only: callers cannot turn extensions on after realization. */
+static bool parse_analysis_capabilities(const char *value, Error **errp)
+{
+    g_auto(GStrv) names = g_strsplit(value, ",", -1);
+    uint32_t requested = 0;
+
+    for (char **name = names; *name; name++) {
+        if (!strcmp(*name, "vanilla")) {
+            if (names[1]) {
+                error_setg(errp, "vanilla cannot be combined with capabilities");
+                return false;
+            }
+        } else if (!strcmp(*name, "analysis")) {
+            requested |= ANALYSIS_CAP_ANALYSIS;
+        } else if (!strcmp(*name, "fuzz")) {
+            requested |= ANALYSIS_CAP_FUZZ;
+        } else if (!strcmp(*name, "rr")) {
+            requested |= ANALYSIS_CAP_RR;
+        } else if (!strcmp(*name, "guest-hypercall")) {
+            requested |= ANALYSIS_CAP_GUEST_HYPERCALL;
+        } else if (!strcmp(*name, "handoff")) {
+            requested |= ANALYSIS_CAP_HANDOFF;
+        } else {
+            error_setg(errp, "unknown analysis capability '%s'", *name);
+            return false;
+        }
+    }
+    if (!value[0]) {
+        error_setg(errp, "analysis capabilities must not be empty");
+        return false;
+    }
+    return analysis_policy_configure(requested, errp);
+}
+
 static void qemu_init_board(void)
 {
     MachineClass *machine_class = MACHINE_GET_CLASS(current_machine);
 
+    analysis_policy_freeze();
+    if (analysis_policy_has(ANALYSIS_CAP_ANALYSIS)) {
+        analysis_policy_set_analysis_active(true, &error_fatal);
+    }
+
     /* process plugin before CPUs are created, but once -smp has been parsed */
     qemu_plugin_load_list(&plugin_list, &error_fatal);
 
@@ -3667,6 +3707,9 @@ void qemu_init(int argc, char **argv)
             case QEMU_OPTION_plugin:
                 qemu_plugin_opt_parse(optarg, &plugin_list);
                 break;
+            case QEMU_OPTION_analysis_capabilities:
+                parse_analysis_capabilities(optarg, &error_fatal);
+                break;
             case QEMU_OPTION_module:
                 if (is_help_option(optarg)) {
                     printf("panda ABI %s\n", module_panda_abi());
