+    }
     VaddrRange r = { addr, NULL, len, MMU_DATA_LOAD };
 
     if (len == 0) {
@@ -500,6 +511,9 @@ int qemu_plugin_write_memory_vaddr_fault(uint64_t addr, GByteArray *data,
                                          enum qemu_plugin_vaddr_mode mode,
                                          bool fault)
 {
+    if (!replay_analysis_write_allowed()) {
+        return QEMU_PLUGIN_VADDR_BAD_MODE;
+    }
     VaddrRange r = { addr, data->data, data->len, MMU_DATA_STORE };
 
     if (data->len == 0) {
@@ -513,6 +527,12 @@ int qemu_plugin_access_memory_vaddr_fault(struct qemu_plugin_vaddr_op *ops,
                                           enum qemu_plugin_vaddr_mode mode,
                                           bool fault, size_t *failed_op)
 {
+    if (!replay_analysis_write_allowed()) {
+        if (failed_op) {
+            *failed_op = 0;
+        }
+        return QEMU_PLUGIN_VADDR_BAD_MODE;
+    }
     VaddrRange r[QEMU_PLUGIN_VADDR_OPS_MAX];
 
     if (n == 0 || n > QEMU_PLUGIN_VADDR_OPS_MAX) {
diff --git a/plugins/api.c b/plugins/api.c
index fdb70054eb27ad3d81c08a16cb66cb47340e8149..902d2ec6639afee321fcd1e38d3e0b6aa68cc012 100644
--- a/plugins/api.c
+++ b/plugins/api.c
@@ -55,6 +55,7 @@
 #include "system/syscall-trap.h"
 #endif
 #include "plugin.h"
