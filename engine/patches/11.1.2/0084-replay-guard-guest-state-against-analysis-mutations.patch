 {
+    if (!replay_analysis_write_allowed()) {
+        return false;
+    }
     g_assert(current_cpu);
 
     if (data->len == 0) {
@@ -675,6 +700,9 @@ qemu_plugin_read_memory_hwaddr(hwaddr addr, GByteArray *data, size_t len)
     }
 
     g_byte_array_set_size(data, len);
+    if (!replay_analysis_read_allowed(as, addr, len, MEMTXATTRS_UNSPECIFIED)) {
+        return QEMU_PLUGIN_HWADDR_OPERATION_ACCESS_DENIED;
+    }
     MemTxResult res = address_space_rw(as, addr,
                                        MEMTXATTRS_UNSPECIFIED, data->data,
                                        data->len, false);
@@ -700,6 +728,9 @@ enum qemu_plugin_hwaddr_operation_result
 qemu_plugin_write_memory_hwaddr(hwaddr addr, GByteArray *data)
 {
 #ifdef CONFIG_SOFTMMU
+    if (!replay_analysis_write_allowed()) {
+        return QEMU_PLUGIN_HWADDR_OPERATION_ACCESS_DENIED;
+    }
     if (data->len == 0) {
         return QEMU_PLUGIN_HWADDR_OPERATION_ERROR;
     }
