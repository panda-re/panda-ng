 /* Uninstall and Reset handlers */
 
@@ -546,6 +547,9 @@ bool qemu_plugin_read_register(struct qemu_plugin_register *reg,
 bool qemu_plugin_write_register(struct qemu_plugin_register *reg,
                                 GByteArray *buf)
 {
+    if (!replay_analysis_write_allowed()) {
+        return false;
+    }
     g_assert(current_cpu);
 
     /* Read-only property is encoded in least significant bit */
@@ -564,6 +568,10 @@ bool qemu_plugin_write_register(struct qemu_plugin_register *reg,
 void *qemu_plugin_register_ptr(struct qemu_plugin_register *reg,
                                size_t *size)
 {
+    /* Mutable pointers cannot be made observe-only. Use read_register instead. */
+    if (!replay_analysis_write_allowed()) {
+        return NULL;
+    }
 #ifdef CONFIG_TCG
     ptrdiff_t off;
     unsigned n;
@@ -587,6 +595,12 @@ void *qemu_plugin_register_ptr(struct qemu_plugin_register *reg,
 
 void qemu_plugin_set_pc(uint64_t vaddr)
 {
+    if (!replay_analysis_write_allowed()) {
+        error_report("qemu_plugin_set_pc: guest mutation is forbidden during record/replay");
+        /* This legacy API promises noreturn. Returning would be undefined in
+         * native callers compiled against that promise. */
+        exit(EXIT_FAILURE);
+    }
     g_assert(current_cpu);
 
     g_assert(qemu_plugin_get_cb_flags() == QEMU_PLUGIN_CB_RW_REGS_PC);
@@ -611,6 +625,14 @@ void qemu_plugin_set_pc(uint64_t vaddr)
     cpu_loop_exit(current_cpu);
 }
 
+bool qemu_plugin_try_set_pc(uint64_t vaddr)
+{
+    if (!replay_analysis_write_allowed()) {
+        return false;
+    }
+    qemu_plugin_set_pc(vaddr);
+}
+
 bool qemu_plugin_read_memory_vaddr(uint64_t addr, GByteArray *data, size_t len)
 {
     g_assert(current_cpu);
@@ -640,6 +662,9 @@ bool qemu_plugin_read_memory_vaddr(uint64_t addr, GByteArray *data, size_t len)
 
