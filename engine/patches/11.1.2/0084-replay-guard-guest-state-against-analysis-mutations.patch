diff --git a/include/system/replay-analysis.h b/include/system/replay-analysis.h
new file mode 100644
index 0000000000000000000000000000000000000000..784738dafcf5f9823b50769579c8e5e197ec4493
--- /dev/null
+++ b/include/system/replay-analysis.h
@@ -0,0 +1,43 @@
+/*
+ * Guest mutations requested by analysis must not perturb deterministic replay.
+ * Internal device/CPU execution and snapshot loading use their normal paths.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef SYSTEM_REPLAY_ANALYSIS_H
+#define SYSTEM_REPLAY_ANALYSIS_H
+
+#ifdef CONFIG_SOFTMMU
+#include "system/replay.h"
+#include "system/memory.h"
+#include "qemu/rcu.h"
+static inline bool replay_analysis_write_allowed(void)
+{
+    return replay_mode == REPLAY_MODE_NONE;
+}
+
+/* A device read can acknowledge interrupts or consume a FIFO. Preflight the
+ * whole range so even an access straddling RAM/MMIO has no device side effects. */
+static inline bool replay_analysis_read_allowed(AddressSpace *as, hwaddr addr,
+                                                 size_t len, MemTxAttrs attrs)
+{
+    if (replay_analysis_write_allowed()) {
+        return true;
+    }
+    RCU_READ_LOCK_GUARD();
+    while (len) {
+        hwaddr offset, chunk = len;
+        MemoryRegion *mr = address_space_translate(as, addr, &offset, &chunk,
+                                                  false, attrs);
+        if (!chunk || !memory_region_is_ram(mr)) {
+            return false;
+        }
+        addr += chunk;
+        len -= chunk;
+    }
+    return true;
+}
+#else
+static inline bool replay_analysis_write_allowed(void) { return true; }
+#endif
+
+#endif
