 {
     if (env->pstate & PSTATE_SP) {
-        env->sp_el[el] = env->xregs[31];
+        arm_env_move(env, &env->sp_el[el], &env->xregs[31], sizeof(uint64_t));
     } else {
-        env->sp_el[0] = env->xregs[31];
+        arm_env_move(env, &env->sp_el[0], &env->xregs[31], sizeof(uint64_t));
     }
 }
 
 static inline void aarch64_restore_sp(CPUARMState *env, int el)
 {
     if (env->pstate & PSTATE_SP) {
-        env->xregs[31] = env->sp_el[el];
+        arm_env_move(env, &env->xregs[31], &env->sp_el[el], sizeof(uint64_t));
     } else {
-        env->xregs[31] = env->sp_el[0];
+        arm_env_move(env, &env->xregs[31], &env->sp_el[0], sizeof(uint64_t));
     }
 }
 
