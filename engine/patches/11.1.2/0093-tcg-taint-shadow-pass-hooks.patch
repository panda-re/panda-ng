+/*
+ * Taint: the ram_addr behind @addr if the TLB (main or victim) maps it to RAM, or to ROMD for
+ * a load. Never fills the TLB or faults, so it is safe after the guest access in replay.
+ */
+bool tlb_peek_ram_addr(CPUState *cpu, vaddr addr, int mmu_idx,
+                       MMUAccessType type, uint64_t *ram_addr)
+{
+    uintptr_t index = tlb_index(cpu, mmu_idx, addr);
+    CPUTLBEntry *entry = tlb_entry(cpu, mmu_idx, addr);
+    vaddr page = addr & TARGET_PAGE_MASK;
+    CPUTLBEntryFull *full;
+    MemoryRegion *mr;
+
+    if (!tlb_hit_page(tlb_read_idx(entry, type), page)) {
+        if (!victim_tlb_hit(cpu, mmu_idx, index, type, page)) {
+            return false;
+        }
+    }
+    full = &cpu->neg.tlb.d[mmu_idx].fulltlb[index];
+    mr = full->section->mr;
+    if (memory_region_is_ram(mr)) {
+        *ram_addr = addr + full->xlat_offset;
+        return true;
+    }
+    if (memory_region_is_romd(mr) && type != MMU_DATA_STORE) {
+        *ram_addr = memory_region_get_ram_addr(mr) + addr + full->xlat_offset;
+        return true;
+    }
+    return false;
+}
