+/*
+ * Copy @n bytes between CPU-state fields: a register bank switch done in C. Taint's shadow of
+ * the CPU state follows (exception entry and return swap the stack pointer this way).
+ */
+static inline void arm_env_move(CPUARMState *env, void *dst, const void *src, size_t n)
+{
+    memmove(dst, src, n);
+#ifndef CONFIG_USER_ONLY
+    if (unlikely(taint_active)) {
+        taint_env_copy(env_cpu(env), (uint8_t *)dst - (uint8_t *)env,
+                       (const uint8_t *)src - (const uint8_t *)env, n);
+    }
+#endif
+}
+
 static inline void aarch64_save_sp(CPUARMState *env, int el)
 {
     if (env->pstate & PSTATE_SP) {
-        env->sp_el[el] = env->xregs[31];
+        arm_env_move(env, &env->sp_el[el], &env->xregs[31], sizeof(uint64_t));
     } else {
-        env->sp_el[0] = env->xregs[31];
+        arm_env_move(env, &env->sp_el[0], &env->xregs[31], sizeof(uint64_t));
     }
 }
 
 static inline void aarch64_restore_sp(CPUARMState *env, int el)
 {
     if (env->pstate & PSTATE_SP) {
-        env->xregs[31] = env->sp_el[el];
+        arm_env_move(env, &env->xregs[31], &env->sp_el[el], sizeof(uint64_t));
     } else {
-        env->xregs[31] = env->sp_el[0];
+        arm_env_move(env, &env->xregs[31], &env->sp_el[0], sizeof(uint64_t));
     }
 }
 
