+++ b/target/arm/internals.h
@@ -1990,6 +1990,8 @@ int delete_gdbstub_hw_watchpoint(vaddr addr, vaddr len, GdbBreakpointType type);
 
 /* Return the current value of the system counter in ticks */
 uint64_t gt_get_countervalue(CPUARMState *env);
+/* TCG: recompute ISTATUS and re-arm the EL1 physical and virtual timers */
+void arm_gt_recalc_el1_timers(ARMCPU *cpu);
 /*
  * Return the currently applicable offset between the system counter
  * and the counter for the specified timer, as used for direct register
diff --git a/target/arm/machine.c b/target/arm/machine.c
index 89127e5d83c0ea6c303e2ee55106911c07565e5b..63941f9c28a58ad9fbf32a312b5b020ebef55f8e 100644
--- a/target/arm/machine.c
+++ b/target/arm/machine.c
@@ -5,6 +5,7 @@
 #include "qemu/error-report.h"
 #include "system/hvf.h"
 #include "system/tcg.h"
+#include "system/runstate.h"
 #include "kvm_arm.h"
 #include "internals.h"
 #include "cpu-features.h"
@@ -368,11 +369,84 @@ static bool wfxt_timer_needed(void *opaque)
     return cpu->wfxt_timer;
 }
 
+static void wfxt_timer_dummy_cb(void *opaque)
+{
+}
+
+/*
+ * Only TCG creates the WFxT timer (cpu.c), but a TCG stream may arrive at
+ * a KVM destination (accelerator handoff). Give the field somewhere to
+ * land instead of asserting in VMSTATE_TIMER_PTR; KVM never arms it.
+ */
+static int wfxt_timer_pre_load(void *opaque)
+{
+    ARMCPU *cpu = opaque;
+
+    if (!cpu->wfxt_timer) {
+        cpu->wfxt_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                       wfxt_timer_dummy_cb, cpu);
+    }
+    return 0;
+}
+
+static int wfxt_timer_post_load(void *opaque, int version_id)
+{
+    ARMCPU *cpu = opaque;
+
+    if (!tcg_enabled()) {
+        timer_del(cpu->wfxt_timer);
+    }
+    return 0;
+}
+
+/*
+ * TCG's virtual counter is QEMU_CLOCK_VIRTUAL minus CNTVOFF_EL2, and
+ * CNTVCT is not raw state, so nothing in the cpreg list carries the
+ * guest's virtual count. Send it, so a KVM destination can set
+ * KVM_REG_ARM_TIMER_CNT and a TCG destination without EL2 (no CNTVOFF_EL2
+ * in the list) can rebuild its offset.
+ */
+static bool virt_count_needed(void *opaque)
+{
+    return tcg_enabled() && arm_feature(&((ARMCPU *)opaque)->env,
+                                        ARM_FEATURE_AARCH64);
+}
+
+static int virt_count_pre_save(void *opaque)
+{
+    ARMCPU *cpu = opaque;
+
+    cpu->handoff_vcnt = gt_get_countervalue(&cpu->env) -
+                        cpu->env.cp15.cntvoff_el2;
+    return 0;
+}
+
+static int virt_count_post_load(void *opaque, int version_id)
+{
+    ((ARMCPU *)opaque)->handoff_vcnt_valid = true;
+    return 0;
+}
+
+static const VMStateDescription vmstate_virt_count = {
+    .name = "cpu/virt-count",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = virt_count_needed,
+    .pre_save = virt_count_pre_save,
+    .post_load = virt_count_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT64(handoff_vcnt, ARMCPU),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
 static const VMStateDescription vmstate_wfxt_timer = {
     .name = "cpu/wfxt-timer",
     .version_id = 1,
     .minimum_version_id = 1,
     .needed = wfxt_timer_needed,
+    .pre_load = wfxt_timer_pre_load,
+    .post_load = wfxt_timer_post_load,
     .fields = (const VMStateField[]) {
         VMSTATE_TIMER_PTR(wfxt_timer, ARMCPU),
         VMSTATE_END_OF_LIST()
@@ -1054,6 +1128,8 @@ static int cpu_pre_load(void *opaque)
      * irq-line-state subsection in the incoming migration state.
      */
     env->irq_line_state = UINT32_MAX;
+    cpu->handoff_vcnt_valid = false;
+    cpu->handoff_in = false;
 
     if (tcg_enabled() || hvf_enabled()) {
         pmu_op_start(env);
@@ -1082,8 +1158,13 @@ static void handle_cpreg_missing_in_incoming_stream(ARMCPU *cpu, uint64_t kvmidx
 {
     g_autofree gchar *name = print_register_name(kvmidx);
 
+    if (cpu->handoff_in && getenv("ARM_HANDOFF_DEBUG")) {
+        fprintf(stderr, "handoff missing 0x%" PRIx64 "\n", kvmidx);
+    }
     if (arm_cpu_match_cpreg_mig_tolerance(cpu, kvmidx,
-                                          0, 0, ToleranceNotOnBothEnds)) {
+                                          0, 0, ToleranceNotOnBothEnds) ||
+        cpu->handoff_in) {
+        /* handoff: the destination's own (reset) value stands */
         trace_tolerate_cpreg_missing_in_incoming_stream(name);
         return;
     }
@@ -1115,6 +1196,194 @@ handle_cpreg_only_in_incoming_stream(ARMCPU *cpu, uint64_t kvmidx, uint64_t valu
     return true;
 }
 
+/*
+ * Accelerator handoff: a cpreg list saved under KVM loaded under TCG, or
+ * the reverse. The two lists differ:
+ *  - KVM lists firmware pseudo-registers (KVM_REG_ARM_FW, _FW_FEAT_BMAP),
+ *    CCSIDR demux entries, all 16 debug register pairs, 31 PMU event
+ *    counters and AArch32 EL2 views that TCG doesn't model; TCG lists
+ *    IMPDEF and other registers KVM doesn't expose.
+ *  - The KVM uapi ids for the virtual timer are swapped relative to the
+ *    architecture: KVM_REG_ARM_TIMER_CNT is CNTV_CVAL_EL0's encoding and
+ *    KVM_REG_ARM_TIMER_CVAL is CNTVCT_EL0's (linux asm/kvm.h). So the same
+ *    id carries the virtual count from KVM and the compare value from TCG.
+ *  - ID registers describe the destination's CPU, not guest state.
+ * Translate the incoming arrays in place so the generic matching below
+ * sees only registers both sides know, with the timer values in the right
+ * slots. The source is KVM iff the stream has firmware pseudo-registers,
+ * which only KVM lists.
+ */
+#define HANDOFF_ARM64_SYSREG(op0, op1, crn, crm, op2)                       \
+    (CP_REG_ARM64 | CP_REG_SIZE_U64 | CP_REG_ARM64_SYSREG |                 \
+     ((uint64_t)(op0) << CP_REG_ARM64_SYSREG_OP0_SHIFT) |                   \
+     ((uint64_t)(op1) << CP_REG_ARM64_SYSREG_OP1_SHIFT) |                   \
+     ((uint64_t)(crn) << CP_REG_ARM64_SYSREG_CRN_SHIFT) |                   \
+     ((uint64_t)(crm) << CP_REG_ARM64_SYSREG_CRM_SHIFT) |                   \
+     ((uint64_t)(op2) << CP_REG_ARM64_SYSREG_OP2_SHIFT))
+/* KVM_REG_ARM_TIMER_CNT == TCG's CNTV_CVAL_EL0 */
+#define HANDOFF_ID_CNT_OR_CVAL  HANDOFF_ARM64_SYSREG(3, 3, 14, 3, 2)
+/* KVM_REG_ARM_TIMER_CVAL (CNTVCT_EL0's encoding; not raw state in TCG) */
+#define HANDOFF_ID_KVM_CVAL     HANDOFF_ARM64_SYSREG(3, 3, 14, 0, 2)
+#define HANDOFF_COPROC_FW       (0x0014ULL << CP_REG_ARM_COPROC_SHIFT)
+#define HANDOFF_COPROC_FW_BMAP  (0x0016ULL << CP_REG_ARM_COPROC_SHIFT)
+
+static int handoff_cmp_u64(const void *a, const void *b)
+{
+    uint64_t x = *(const uint64_t *)a, y = *(const uint64_t *)b;
+
+    return x < y ? -1 : x > y;
+}
+
+static bool handoff_dest_has(ARMCPU *cpu, uint64_t idx)
+{
+    return bsearch(&idx, cpu->cpreg_indexes, cpu->cpreg_array_len,
+                   sizeof(uint64_t), handoff_cmp_u64) != NULL;
+}
+
+/* An identification register: describes the CPU, not the guest's state */
+static bool handoff_is_id_reg(uint64_t idx)
+{
+    if ((idx & CP_REG_ARCH_MASK) != CP_REG_ARM64 ||
+        (idx & CP_REG_ARM_COPROC_MASK) != CP_REG_ARM64_SYSREG) {
+        return false;
+    }
+    return ((idx & CP_REG_ARM64_SYSREG_OP0_MASK) >>
+            CP_REG_ARM64_SYSREG_OP0_SHIFT) == 3 &&
+           ((idx & CP_REG_ARM64_SYSREG_CRN_MASK) >>
+            CP_REG_ARM64_SYSREG_CRN_SHIFT) == 0 &&
+           /* op1 == 2 is CSSELR_EL1, real state */
+           ((idx & CP_REG_ARM64_SYSREG_OP1_MASK) >>
+            CP_REG_ARM64_SYSREG_OP1_SHIFT) != 2;
+}
+
+static void arm_cpu_handoff_translate(ARMCPU *cpu)
+{
+    int n = cpu->cpreg_vmstate_array_len, i, out, dropped = 0, nonzero = 0;
+    uint64_t *idx, *val;
+    bool src_kvm = false, dst_kvm = kvm_enabled();
+    bool have_cnt = false, have_cval = false;
+    uint64_t cnt_or_cval = 0, kvm_cval = 0;
+    GString *nz = g_string_new(NULL);
+
+    cpu->handoff_in = false;
+    for (i = 0; i < n; i++) {
+        uint64_t c = cpu->cpreg_vmstate_indexes[i] & CP_REG_ARM_COPROC_MASK;
+
+        if ((cpu->cpreg_vmstate_indexes[i] & CP_REG_ARCH_MASK) ==
+            CP_REG_ARM64 &&
+            (c == HANDOFF_COPROC_FW || c == HANDOFF_COPROC_FW_BMAP)) {
+            src_kvm = true;
+        }
+    }
+    if (src_kvm == dst_kvm) {
+        g_string_free(nz, true);
+        return;
+    }
+    cpu->handoff_in = true;
+
+    /* room for one insertion (TCG -> KVM adds KVM_REG_ARM_TIMER_CVAL) */
+    cpu->cpreg_vmstate_indexes = g_renew(uint64_t, cpu->cpreg_vmstate_indexes,
+                                         n + 1);
+    cpu->cpreg_vmstate_values = g_renew(uint64_t, cpu->cpreg_vmstate_values,
+                                        n + 1);
+    idx = cpu->cpreg_vmstate_indexes;
+    val = cpu->cpreg_vmstate_values;
+
+    for (i = 0; i < n; i++) {
+        if (idx[i] == HANDOFF_ID_CNT_OR_CVAL) {
+            have_cnt = true;
+            cnt_or_cval = val[i];
+        } else if (idx[i] == HANDOFF_ID_KVM_CVAL) {
+            have_cval = true;
+            kvm_cval = val[i];
+        }
+    }
+
+    for (i = 0, out = 0; i < n; i++) {
+        uint64_t id = idx[i], v = val[i];
+
+        if (id == HANDOFF_ID_KVM_CVAL && !dst_kvm) {
+            continue;       /* moved into the CNTV_CVAL_EL0 slot below */
+        }
+        if (id == HANDOFF_ID_CNT_OR_CVAL) {
+            if (src_kvm) {
+                /* KVM's TIMER_CNT slot: TCG reads it as CNTV_CVAL_EL0 */
+                v = have_cval ? kvm_cval : 0;
+            } else {
+                /* TCG's CNTV_CVAL_EL0: KVM reads this id as TIMER_CNT */
+                v = cpu->handoff_vcnt_valid ? cpu->handoff_vcnt : v;
+            }
+        } else if (!handoff_dest_has(cpu, id) || handoff_is_id_reg(id)) {
+            if (getenv("ARM_HANDOFF_DEBUG")) {
+                fprintf(stderr, "handoff drop 0x%" PRIx64 " = 0x%" PRIx64
+                        "%s\n", id, v, handoff_is_id_reg(id) ? " (id)" : "");
+            }
+            dropped++;
+            if (v && !handoff_is_id_reg(id)) {
+                if (nonzero++ < 24) {
+                    g_string_append_printf(nz, " 0x%" PRIx64 "=0x%" PRIx64,
+                                           id, v);
+                }
+            }
+            continue;
+        }
+        if (getenv("ARM_HANDOFF_DEBUG")) {
+            fprintf(stderr, "handoff keep 0x%" PRIx64 " = 0x%" PRIx64 "\n",
+                    id, v);
+        }
+        idx[out] = id;
+        val[out] = v;
+        out++;
+    }
+    if (src_kvm) {
+        /* KVM -> TCG: TCG rebuilds its virtual offset from the count */
+        cpu->handoff_vcnt = cnt_or_cval;
+        cpu->handoff_vcnt_valid = have_cnt;
+    } else {
