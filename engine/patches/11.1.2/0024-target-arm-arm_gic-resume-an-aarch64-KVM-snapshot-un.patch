index d92764eba159de91a78fe00ae37d00b4b7a9dc30..ef7b823e393a00af1c749ec27ff514fdbb5e0de7 100644
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -1499,6 +1499,14 @@ uint64_t gt_direct_access_timer_offset(CPUARMState *env, int timeridx)
     }
