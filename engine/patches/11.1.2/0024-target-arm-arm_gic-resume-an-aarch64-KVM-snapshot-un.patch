 hw/intc/arm_gic_common.c         | 113 +++++++++++
 include/hw/intc/arm_gic_common.h |   5 +
 target/arm/cpu.h                 |  11 ++
 target/arm/helper.c              |   8 +
 target/arm/internals.h           |   2 +
 target/arm/machine.c             | 325 ++++++++++++++++++++++++++++++-
 target/arm/trace-events          |   1 +
 7 files changed, 461 insertions(+), 4 deletions(-)

diff --git a/hw/intc/arm_gic_common.c b/hw/intc/arm_gic_common.c
index 304d89cf56219bf76eeeb24e55dbfe60be23ba43..fe7fba5374877d760bc1469d10c06f68bddfb8df 100644
--- a/hw/intc/arm_gic_common.c
+++ b/hw/intc/arm_gic_common.c
@@ -40,11 +40,122 @@ static int gic_pre_save(void *opaque)
     return 0;
 }
 
+/*
+ * KVM's vGICv2 device ABI exports the CPU interface in GICH_VMCR/GICH_APR
+ * form: GICC_PMR as VMPriMask (priority >> 3), and the active priorities as
+ * one bit per 5-bit priority in GICH_APR0. kvm-arm-gic keeps them in this
+ * shared state as KVM gives them, while the TCG GIC keeps the architectural
+ * PMR and its own APR layout (one bit per priority >> (GIC_MIN_BPR + 1)).
+ * So a stream saved under one accelerator is wrong under the other: a
+ * KVM-saved PMR of 0xf0 reads as 0x1e under TCG and masks every interrupt.
+ * Streams in the KVM form carry this subsection; gic_post_load() converts
+ * when the destination keeps the other form (KVM <-> TCG handoff).
+ */
+static bool gic_is_kvm(GICState *s)
+{
+    return object_dynamic_cast(OBJECT(s), "kvm-arm-gic") != NULL;
+}
+
+static bool gic_kvm_cpuif_needed(void *opaque)
+{
+    return gic_is_kvm(opaque);
+}
+
+static int gic_kvm_cpuif_pre_save(void *opaque)
+{
+    ((GICState *)opaque)->kvm_cpuif_in = true;
+    return 0;
+}
+
+static const VMStateDescription vmstate_gic_kvm_cpuif = {
+    .name = "arm_gic/kvm-cpuif",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = gic_kvm_cpuif_needed,
+    .pre_save = gic_kvm_cpuif_pre_save,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(kvm_cpuif_in, GICState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static int gic_pre_load(void *opaque)
+{
+    ((GICState *)opaque)->kvm_cpuif_in = false;
+    return 0;
+}
+
+#define GIC_TCG_APR_SHIFT (GIC_MIN_BPR + 1)
+
+static void gic_convert_cpuif(GICState *s, bool to_kvm)
+{
+    for (int cpu = 0; cpu < s->num_cpu; cpu++) {
+        uint32_t apr[GIC_NR_APRS] = { 0 };
+
+        if (to_kvm) {
+            s->priority_mask[cpu] = (s->priority_mask[cpu] & 0xff) >> 3;
+            for (int l = 0; l < GIC_NR_APRS * 32; l++) {
+                if ((s->apr[l / 32][cpu] | s->nsapr[l / 32][cpu]) &
+                    (1u << (l % 32))) {
+                    apr[0] |= 1u << ((l << GIC_TCG_APR_SHIFT) >> 3);
+                }
+            }
+        } else {
+            s->priority_mask[cpu] = (s->priority_mask[cpu] & 0x1f) << 3;
+            s->running_priority[cpu] = 0x100;
+            for (int n = 31; n >= 0; n--) {
+                if (s->apr[0][cpu] & (1u << n)) {
+                    int l = (n << 3) >> GIC_TCG_APR_SHIFT;
+
+                    apr[l / 32] |= 1u << (l % 32);
+                    s->running_priority[cpu] = n << 3;
+                }
+            }
+        }
+        for (int i = 0; i < GIC_NR_APRS; i++) {
+            s->apr[i][cpu] = apr[i];
+            s->nsapr[i][cpu] = 0;
+        }
+    }
+}
+
 static int gic_post_load(void *opaque, int version_id)
 {
     GICState *s = (GICState *)opaque;
     ARMGICCommonClass *c = ARM_GIC_COMMON_GET_CLASS(s);
 
+    if (s->kvm_cpuif_in != gic_is_kvm(s)) {
+        if (!s->security_extn && !s->virt_extn) {
+            gic_convert_cpuif(s, gic_is_kvm(s));
+        } else {
+            warn_report("arm_gic: accelerator handoff with security or "
+                        "virtualization extensions: CPU interface state "
+                        "not converted");
+        }
+    }
+
+    if (getenv("ARM_HANDOFF_DEBUG")) {
+        for (int cpu = 0; cpu < s->num_cpu; cpu++) {
+            fprintf(stderr, "gic cpu%d: in_kvm_form=%d ctlr=0x%x cpu_ctlr=0x%x "
+                    "pmr=0x%x rprio=0x%x apr=%x/%x/%x/%x\n", cpu,
+                    s->kvm_cpuif_in, s->ctlr, s->cpu_ctlr[cpu],
+                    s->priority_mask[cpu], s->running_priority[cpu],
+                    s->apr[0][cpu], s->apr[1][cpu], s->apr[2][cpu],
+                    s->apr[3][cpu]);
+        }
+        for (int irq = 16; irq < 32; irq++) {
+            gic_irq_state *q = &s->irq_state[irq];
+
+            if (q->enabled || q->pending || q->active || q->level) {
+                fprintf(stderr, "gic irq%d: enabled=%x pending=%x active=%x "
+                        "level=%x edge=%d model=%d group=%x prio0=%d\n", irq,
+                        q->enabled, q->pending, q->active, q->level,
+                        q->edge_trigger, q->model, q->group,
+                        s->priority1[irq][0]);
+            }
+        }
+    }
+
     if (c->post_load) {
         c->post_load(s);
     }
@@ -103,6 +214,7 @@ static const VMStateDescription vmstate_gic = {
     .version_id = 12,
     .minimum_version_id = 12,
     .pre_save = gic_pre_save,
+    .pre_load = gic_pre_load,
     .post_load = gic_post_load,
     .fields = (const VMStateField[]) {
         VMSTATE_UINT32(ctlr, GICState),
@@ -124,6 +236,7 @@ static const VMStateDescription vmstate_gic = {
     },
     .subsections = (const VMStateDescription * const []) {
         &vmstate_gic_virt_state,
+        &vmstate_gic_kvm_cpuif,
         NULL
     }
 };
