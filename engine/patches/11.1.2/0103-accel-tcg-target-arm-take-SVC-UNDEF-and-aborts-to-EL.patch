+++ b/target/arm/tcg/helper-a64.c
@@ -630,6 +630,7 @@ void HELPER(exception_return)(CPUARMState *env, uint64_t new_pc)
     uint64_t spsr = env->banked_spsr[spsr_idx];
     int new_el;
     bool return_to_aa64 = (spsr & PSTATE_nRW) == 0;
+    bool hooks;
 
     aarch64_save_sp(env, cur_el);
 
@@ -693,9 +694,13 @@ void HELPER(exception_return)(CPUARMState *env, uint64_t new_pc)
         goto illegal_return;
     }
 
-    bql_lock();
-    arm_call_pre_el_change_hook(cpu);
-    bql_unlock();
+    /* the hooks and the BQL only if some hook has work for this change */
+    hooks = !arm_el_change_hooks_idle(cpu, cur_el, new_el);
+    if (hooks) {
+        bql_lock();
+        arm_call_pre_el_change_hook(cpu);
+        bql_unlock();
+    }
 
     if (!return_to_aa64) {
         env->aarch64 = false;
@@ -760,9 +765,11 @@ void HELPER(exception_return)(CPUARMState *env, uint64_t new_pc)
      */
     aarch64_sve_change_el(env, cur_el, new_el, return_to_aa64);
 
-    bql_lock();
-    arm_call_el_change_hook(cpu);
-    bql_unlock();
+    if (hooks) {
+        bql_lock();
+        arm_call_el_change_hook(cpu);
+        bql_unlock();
+    }
 
     while (new_el == 0 && syscall_trap_waiting()) {
         uint64_t ret = return_to_aa64 ? env->xregs[0] : env->regs[0];
diff --git a/target/arm/tcg/op_helper.c b/target/arm/tcg/op_helper.c
