diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 9130f046cc2ea90aee795a57a0c9cd98aca0fe36..62f5883a2b6828a0887d032562ecb95a53a8a293 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -808,9 +808,13 @@ static inline bool cpu_handle_exception(CPUState *cpu, int *ret)
     if (replay_exception()) {
         const TCGCPUOps *tcg_ops = cpu->cc->tcg_ops;
 
-        bql_lock();
-        tcg_ops->do_interrupt(cpu);
-        bql_unlock();
+        if (tcg_ops->exception_bql_free && tcg_ops->exception_bql_free(cpu)) {
+            tcg_ops->do_interrupt(cpu);
+        } else {
+            bql_lock();
+            tcg_ops->do_interrupt(cpu);
+            bql_unlock();
+        }
         cpu->exception_index = -1;
 
         if (unlikely(cpu_single_stepping(cpu))) {
diff --git a/hw/intc/arm_gicv3_cpuif.c b/hw/intc/arm_gicv3_cpuif.c
index 67a0bba4b03968035c00faa441de5462bf5d2024..2c16ed475d01cadf306f54fb462d7a28174f238b 100644
--- a/hw/intc/arm_gicv3_cpuif.c
+++ b/hw/intc/arm_gicv3_cpuif.c
@@ -3048,6 +3048,18 @@ static void gicv3_cpuif_el_change_hook(ARMCPU *cpu, void *opaque)
     gicv3_cpuif_virt_irq_fiq_update(cs);
 }
 
+/*
+ * What the hook computes depends on the exception level only through EL2
+ * and EL3 (and the security state, which EL0 and EL1 share): a change
+ * between EL0 and EL1 leaves the signalled IRQ/FIQ/NMI and virtual
+ * IRQ/FIQ levels as they are.
+ */
+static bool gicv3_cpuif_el_change_idle(ARMCPU *cpu, void *opaque,
+                                       int from_el, int to_el)
+{
+    return from_el <= 1 && to_el <= 1;
+}
+
 void gicv3_init_cpuif(GICv3State *s, Error **errp)
 {
     /* Called from the GICv3 realize function; register our system
@@ -3196,6 +3208,8 @@ void gicv3_init_cpuif(GICv3State *s, Error **errp)
              * the non-TCG case this is OK, as EL2 and EL3 can't exist.
              */
             arm_register_el_change_hook(cpu, gicv3_cpuif_el_change_hook, cs);
+            arm_set_el_change_hook_idle(cpu, gicv3_cpuif_el_change_hook, cs,
+                                        gicv3_cpuif_el_change_idle);
         } else {
             assert(!arm_feature(&cpu->env, ARM_FEATURE_EL2));
             assert(!arm_feature(&cpu->env, ARM_FEATURE_EL3));
diff --git a/include/accel/tcg/cpu-ops.h b/include/accel/tcg/cpu-ops.h
index 4d4a327c9fc90291f7a51bf83572c0952d6ee195..e39e377958b71f673c6f3a323d7cb4b457e59dd8 100644
--- a/include/accel/tcg/cpu-ops.h
+++ b/include/accel/tcg/cpu-ops.h
@@ -207,6 +207,16 @@ struct TCGCPUOps {
 #else
     /** @do_interrupt: Callback for interrupt handling.  */
     void (*do_interrupt)(CPUState *cpu);
+    /**
+     * @exception_bql_free: Callback: may @do_interrupt deliver the
+     * pending exception (cpu->exception_index) without the BQL?
+     *
+     * Optional.  The cpu loop holds the BQL around @do_interrupt unless
+     * this returns true; @do_interrupt then runs without it and must
+     * touch nothing but the vCPU's own state.  Called on the vCPU's
+     * thread without the BQL; it may read only the vCPU's own state.
+     */
+    bool (*exception_bql_free)(CPUState *cpu);
     /** @cpu_exec_interrupt: Callback for processing interrupts in cpu_exec */
     bool (*cpu_exec_interrupt)(CPUState *cpu, int interrupt_request);
     /** @cpu_exec_reset: Callback for reset in cpu_exec.  */
diff --git a/target/arm/cpregs-pmu.c b/target/arm/cpregs-pmu.c
index 46df6597b1ab3ff387c634f4eb82ec96156c58df..765ac0f1c4821cb22739a6aec2502857f73dea7e 100644
--- a/target/arm/cpregs-pmu.c
+++ b/target/arm/cpregs-pmu.c
@@ -622,6 +622,19 @@ void pmu_post_el_change(ARMCPU *cpu, void *ignored)
     pmu_op_finish(&cpu->env);
 }
 
+/*
+ * With no counter enabled in PMCNTENSET, pmu_op_start() only records each
+ * counter's underlying count as its delta, and pmu_op_finish() does nothing.
+ * Every reader of a counter or of its delta (counter, type, enable, PMCR and
+ * MDCR accesses, migration) calls pmu_op_start() first, which records the
+ * delta again, so an EL change can skip both hooks.  PMCNTENSET is this
+ * vCPU's own register, written only by its own accesses and by state loads.
+ */
+bool pmu_el_change_idle(ARMCPU *cpu, void *ignored, int from_el, int to_el)
+{
+    return cpu->env.cp15.c9_pmcnten == 0;
+}
+
 void arm_pmu_timer_cb(void *opaque)
 {
     ARMCPU *cpu = opaque;
diff --git a/target/arm/cpu.c b/target/arm/cpu.c
index 499713696a30cc36becbb8ed0584809f2f0ae57f..1ebb3bccf1029deac8901fbdac027d1f4d36675b 100644
--- a/target/arm/cpu.c
+++ b/target/arm/cpu.c
@@ -243,6 +243,40 @@ void arm_register_el_change_hook(ARMCPU *cpu, ARMELChangeHookFn *hook,
     QLIST_INSERT_HEAD(&cpu->el_change_hooks, entry, node);
 }
 
+void arm_set_el_change_hook_idle(ARMCPU *cpu, ARMELChangeHookFn *hook,
+                                 void *opaque, ARMELChangeHookIdleFn *idle)
+{
+    ARMELChangeHook *entry;
+
+    QLIST_FOREACH(entry, &cpu->pre_el_change_hooks, node) {
+        if (entry->hook == hook && entry->opaque == opaque) {
+            entry->idle = idle;
+        }
+    }
+    QLIST_FOREACH(entry, &cpu->el_change_hooks, node) {
+        if (entry->hook == hook && entry->opaque == opaque) {
+            entry->idle = idle;
+        }
+    }
+}
+
+bool arm_el_change_hooks_idle(ARMCPU *cpu, int from_el, int to_el)
+{
+    ARMELChangeHook *entry;
+
+    QLIST_FOREACH(entry, &cpu->pre_el_change_hooks, node) {
+        if (!entry->idle || !entry->idle(cpu, entry->opaque, from_el, to_el)) {
+            return false;
+        }
+    }
+    QLIST_FOREACH(entry, &cpu->el_change_hooks, node) {
+        if (!entry->idle || !entry->idle(cpu, entry->opaque, from_el, to_el)) {
+            return false;
+        }
+    }
+    return true;
+}
+
 static ARMCPRegMigTolerance *find_mig_tolerance(ARMCPU *cpu, uint64_t kvmidx)
 {
     ARMCPRegMigTolerance *t;
@@ -2248,6 +2282,10 @@ static void arm_cpu_realizefn(DeviceState *dev, Error **errp)
         if (tcg_enabled() || hvf_enabled()) {
             arm_register_pre_el_change_hook(cpu, &pmu_pre_el_change, 0);
             arm_register_el_change_hook(cpu, &pmu_post_el_change, 0);
+            arm_set_el_change_hook_idle(cpu, &pmu_pre_el_change, 0,
+                                        &pmu_el_change_idle);
+            arm_set_el_change_hook_idle(cpu, &pmu_post_el_change, 0,
+                                        &pmu_el_change_idle);
         }
 
 #ifndef CONFIG_USER_ONLY
@@ -2655,6 +2693,7 @@ static const TCGCPUOps arm_tcg_ops = {
     .cpu_exec_halt = arm_cpu_exec_halt,
     .cpu_exec_reset = cpu_reset,
     .do_interrupt = arm_cpu_do_interrupt,
+    .exception_bql_free = arm_cpu_exception_bql_free,
     .do_transaction_failed = arm_cpu_do_transaction_failed,
     .do_unaligned_access = arm_cpu_do_unaligned_access,
     .adjust_watchpoint_address = arm_adjust_watchpoint_address,
