+++ b/target/arm/cpu.h
@@ -842,9 +842,19 @@ static inline void unset_feature(CPUARMState *env, int feature)
  * to get callbacks when the CPU changes its exception level or mode.
  */
 typedef void ARMELChangeHookFn(ARMCPU *cpu, void *opaque);
+/**
+ * ARMELChangeHookIdleFn:
+ * type of a function which says whether an EL change hook would do nothing
+ * for a change from @from_el to @to_el, so that the change may skip the
+ * hooks and the BQL (arm_el_change_hooks_idle()).  It is called on the
+ * vCPU's thread without the BQL, and may read only the vCPU's own state.
+ */
+typedef bool ARMELChangeHookIdleFn(ARMCPU *cpu, void *opaque,
+                                   int from_el, int to_el);
 typedef struct ARMELChangeHook ARMELChangeHook;
 struct ARMELChangeHook {
     ARMELChangeHookFn *hook;
+    ARMELChangeHookIdleFn *idle;
     void *opaque;
     QLIST_ENTRY(ARMELChangeHook) node;
 };
@@ -1251,6 +1261,7 @@ uint64_t arm_build_mp_affinity(int idx, uint8_t clustersz);
 extern const VMStateDescription vmstate_arm_cpu;
 
 void arm_cpu_do_interrupt(CPUState *cpu);
+bool arm_cpu_exception_bql_free(CPUState *cpu);
 void arm_v7m_cpu_do_interrupt(CPUState *cpu);
 
 typedef struct ARMGranuleProtectionConfig {
@@ -1399,6 +1410,8 @@ void arm_pmu_timer_cb(void *opaque);
  */
 void pmu_pre_el_change(ARMCPU *cpu, void *ignored);
 void pmu_post_el_change(ARMCPU *cpu, void *ignored);
+/* Their ARMELChangeHookIdleFn: idle while no counter is enabled */
+bool pmu_el_change_idle(ARMCPU *cpu, void *ignored, int from_el, int to_el);
 
 /*
  * pmu_init
@@ -2680,6 +2693,24 @@ void arm_register_pre_el_change_hook(ARMCPU *cpu, ARMELChangeHookFn *hook,
 void arm_register_el_change_hook(ARMCPU *cpu, ARMELChangeHookFn *hook, void
         *opaque);
 
+/**
+ * arm_set_el_change_hook_idle:
+ * Give the hook @hook registered with @opaque (pre- or post-change) a
+ * function that says when it would do nothing.  A hook without one is
+ * never idle: every EL change runs it, with the BQL held.
+ */
+void arm_set_el_change_hook_idle(ARMCPU *cpu, ARMELChangeHookFn *hook,
+                                 void *opaque, ARMELChangeHookIdleFn *idle);
+
+/**
+ * arm_el_change_hooks_idle:
+ * True if every registered pre- and post-change hook would do nothing for
+ * a change from @from_el to @to_el: the change may then skip them all, and
+ * need not take the BQL for them.  Called on the vCPU's thread, with or
+ * without the BQL.
+ */
+bool arm_el_change_hooks_idle(ARMCPU *cpu, int from_el, int to_el);
+
 /**
  * arm_rebuild_hflags:
  * Rebuild the cached TBFLAGS for arbitrary changed processor state.
diff --git a/target/arm/helper.c b/target/arm/helper.c
index 0dd6a6726f885c4550cd386e055d6f0fd669d310..8db6b4c1f604b9c874dd596b86eb0548a8e63630 100644
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -9830,12 +9830,45 @@ void arm_sc_return_aa32(CPUARMState *env)
     }
 }
 
+/*
+ * The synchronous exceptions that may be taken without the BQL: an SVC,
+ * an undefined instruction or an instruction or data abort, from EL0 or
+ * EL1 to EL1, while every EL change hook is idle for that change.  Taking
+ * one writes only this vCPU's state (ESR/FAR/ELR/SPSR, PSTATE, SP, the
+ * hflags; the AArch32 banked registers and fault status for an AArch32
+ * EL1), sets CPU_INTERRUPT_EXITTB (atomically), and reports the syscall
+ * trap's entry and the plugins' exception callback, which x86's SYSCALL
+ * already does without the BQL.  PSCI and semihosting calls (HVC, SMC,
+ * EXCP_SEMIHOST), anything to EL2 or EL3, interrupts and debug exceptions
+ * keep the BQL.
+ */
+bool arm_cpu_exception_bql_free(CPUState *cs)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    CPUARMState *env = &cpu->env;
+    int cur_el;
+
+    switch (cs->exception_index) {
+    case EXCP_SWI:
+    case EXCP_UDEF:
+    case EXCP_PREFETCH_ABORT:
+    case EXCP_DATA_ABORT:
+        break;
+    default:
+        return false;
+    }
+    cur_el = arm_current_el(env);
+    return env->exception.target_el == 1 && cur_el <= 1 &&
+           arm_el_change_hooks_idle(cpu, cur_el, 1);
+}
+
 void arm_cpu_do_interrupt(CPUState *cs)
 {
     ARMCPU *cpu = ARM_CPU(cs);
     CPUARMState *env = &cpu->env;
     unsigned int new_el = env->exception.target_el;
     uint64_t last_pc = cs->cc->get_pc(cs);
+    bool hooks = true, unlock = false;
 
     assert(!arm_feature(env, ARM_FEATURE_M));
 
@@ -9884,13 +9917,24 @@ void arm_cpu_do_interrupt(CPUState *cs)
     }
 
     /*
-     * Hooks may change global state so BQL should be held, also the
-     * BQL needs to be held for any modification of
-     * cs->interrupt_request.
+     * Hooks may change global state so BQL should be held.  The cpu loop
+     * calls us without it only for an exception that
+     * arm_cpu_exception_bql_free() allowed, whose hooks have nothing to
+     * do.  Ask again (the consumers of the engine's system-call entry and
+     * of the syscall trap have run since), and take the BQL if the answer
+     * changed.
      */
-    g_assert(bql_locked());
-
-    arm_call_pre_el_change_hook(cpu);
+    if (!bql_locked()) {
+        if (arm_cpu_exception_bql_free(cs)) {
+            hooks = false;
+        } else {
+            bql_lock();
+            unlock = true;
+        }
+    }
+    if (hooks) {
+        arm_call_pre_el_change_hook(cpu);
+    }
 
     assert(!excp_is_internal(cs->exception_index));
     if (arm_el_is_aa64(env, new_el)) {
@@ -9899,7 +9943,12 @@ void arm_cpu_do_interrupt(CPUState *cs)
         arm_cpu_do_interrupt_aarch32(cs);
     }
 
-    arm_call_el_change_hook(cpu);
+    if (hooks) {
+        arm_call_el_change_hook(cpu);
+    }
+    if (unlock) {
+        bql_unlock();
+    }
 
     if (tcg_enabled()) {
         cpu_set_interrupt(cs, CPU_INTERRUPT_EXITTB);
diff --git a/target/arm/tcg/helper-a64.c b/target/arm/tcg/helper-a64.c
index e235c9d1aa8e30cf87dab47e5d3e949d6110118e..2892e23c3b4e8ea6bc7ce1f153a781bc2f4e5e78 100644
