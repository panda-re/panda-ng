+++ b/plugins/api.c
@@ -106,6 +106,37 @@ void qemu_plugin_register_vcpu_tb_exec_cb(struct qemu_plugin_tb *tb,
     }
 }
 
+void qemu_plugin_register_vcpu_tb_end_cb(struct qemu_plugin_tb *tb,
+                                        qemu_plugin_vcpu_udata_cb_t cb,
+                                        enum qemu_plugin_cb_flags flags,
+                                        void *udata)
+{
+    if (!tb_is_mem_only()) {
+        plugin_register_dyn_cb__udata(&tb->end_cbs, cb, flags, udata);
+    }
+}
+
+void qemu_plugin_register_vcpu_tb_exec_gated_cb(struct qemu_plugin_tb *tb,
+                                                qemu_plugin_vcpu_udata_cb_t cb,
+                                                enum qemu_plugin_cb_flags flags,
+                                                uint8_t gate, void *udata)
+{
+    if (gate && !tb_is_mem_only()) {
+        plugin_register_dyn_gated_cb__udata(&tb->cbs, cb, flags, gate, udata);
+    }
+}
+
+void qemu_plugin_register_vcpu_tb_end_gated_cb(struct qemu_plugin_tb *tb,
+                                               qemu_plugin_vcpu_udata_cb_t cb,
+                                               enum qemu_plugin_cb_flags flags,
+                                               uint8_t gate, void *udata)
+{
+    if (gate && !tb_is_mem_only()) {
+        plugin_register_dyn_gated_cb__udata(&tb->end_cbs, cb, flags, gate,
+                                            udata);
+    }
+}
+
 void qemu_plugin_register_vcpu_tb_exec_cond_cb(struct qemu_plugin_tb *tb,
                                                qemu_plugin_vcpu_udata_cb_t cb,
                                                enum qemu_plugin_cb_flags flags,
