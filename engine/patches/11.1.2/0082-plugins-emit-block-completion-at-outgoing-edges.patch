+     */
+    uint64_t plugin_tb_vaddr;
 
     bool vcpu_dirty;
     AccelCPUState *accel;
diff --git a/include/plugins/qemu-plugin.h b/include/plugins/qemu-plugin.h
index 9c509144d41cadd41e5a75164ae75196f081b400..ce2305f987f574303e22dad4d78403400c3a5522 100644
--- a/include/plugins/qemu-plugin.h
+++ b/include/plugins/qemu-plugin.h
@@ -463,6 +463,29 @@ void qemu_plugin_register_vcpu_tb_exec_cb(struct qemu_plugin_tb *tb,
                                           enum qemu_plugin_cb_flags flags,
                                           void *userdata);
 
+/**
+ * qemu_plugin_register_vcpu_tb_end_cb() - register a normal block-exit callback
+ * @tb: the opaque translation handle
+ * @cb: callback function
+ * @flags: whether the callback reads or writes registers
+ * @userdata: user data for callback
+ *
+ * Runs after the block's guest operations and outgoing PC update, before
+ * transferring to another block or returning to the dispatcher. Direct and
+ * indirect chaining stay enabled. No callback is made for a block that exits
+ * at its entry, or leaves through a fault, exception or other nonlocal exit.
+ * An end event therefore need not accompany every block-entry event.
+ * Changing control flow requires qemu_plugin_set_pc(), not a raw PC write.
+ * A block that runs at any virtual address (CF_PCREL) stays shared: it
+ * stores the address it runs at, at its start, in CPUState.plugin_tb_vaddr
+ * for its end callbacks (a target without TCGCPUOps.gen_tb_pc binds it).
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_vcpu_tb_end_cb(struct qemu_plugin_tb *tb,
+                                        qemu_plugin_vcpu_udata_cb_t cb,
+                                        enum qemu_plugin_cb_flags flags,
+                                        void *userdata);
+
 /**
  * qemu_plugin_register_vcpu_tb_exec_cond_cb() - register conditional callback
  * @tb: the opaque qemu_plugin_tb handle for the translation
@@ -500,6 +523,47 @@ enum qemu_plugin_op {
     QEMU_PLUGIN_INLINE_STORE_U64,
 };
 
+/**
+ * qemu_plugin_register_vcpu_tb_exec_gated_cb() - register a gated TB-entry
+ * callback
+ * @tb: the opaque translation handle
+ * @cb: callback function
+ * @flags: whether the callback reads or writes registers
+ * @gate: a bit mask
+ * @userdata: user data for callback
+ *
+ * As qemu_plugin_register_vcpu_tb_exec_cb(), called only while the vCPU's
+ * gate byte (CPUState.plugin_tb_gates) has a bit of @gate set. The block
+ * tests the byte inline, so opening and closing the gate needs no
+ * retranslation. The embedding writes the gates; a block that reads one
+ * while it changes may call once more or once less.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_vcpu_tb_exec_gated_cb(struct qemu_plugin_tb *tb,
+                                                qemu_plugin_vcpu_udata_cb_t cb,
+                                                enum qemu_plugin_cb_flags flags,
+                                                uint8_t gate,
+                                                void *userdata);
+
+/**
+ * qemu_plugin_register_vcpu_tb_end_gated_cb() - register a gated normal
+ * block-exit callback
+ * @tb: the opaque translation handle
+ * @cb: callback function
+ * @flags: whether the callback reads or writes registers
+ * @gate: a bit mask
+ * @userdata: user data for callback
+ *
+ * As qemu_plugin_register_vcpu_tb_end_cb(), gated as
+ * qemu_plugin_register_vcpu_tb_exec_gated_cb().
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_vcpu_tb_end_gated_cb(struct qemu_plugin_tb *tb,
+                                               qemu_plugin_vcpu_udata_cb_t cb,
+                                               enum qemu_plugin_cb_flags flags,
+                                               uint8_t gate,
+                                               void *userdata);
+
 /**
  * qemu_plugin_register_vcpu_tb_exec_inline_per_vcpu() - execution inline op
  * @tb: the opaque qemu_plugin_tb handle for the translation
