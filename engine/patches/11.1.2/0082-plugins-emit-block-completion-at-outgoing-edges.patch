+    tcg_out_plugin_gate(s, g);
+    if (!(g->ctl & TCG_PLUGIN_GATE_INLINE)) {
+        QSIMPLEQ_INSERT_TAIL(&s->plugin_gates, g, next);
+    }
+}
+
+static int tcg_out_plugin_gate_finalize(TCGContext *s)
+{
+    TCGPluginGate *g;
+
+    QSIMPLEQ_FOREACH(g, &s->plugin_gates, next) {
+        if (!tcg_out_plugin_gate_slow_path(s, g)) {
+            return -2;
+        }
