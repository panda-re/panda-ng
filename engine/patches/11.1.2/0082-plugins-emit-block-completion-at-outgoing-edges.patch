+        if (unlikely((void *)s->code_ptr > s->code_gen_highwater)) {
+            return -1;
+        }
+    }
+    return 0;
+}
+#endif
+
+bool tcg_plugin_gate_supported(void)
+{
+    return TCG_TARGET_HAS_plugin_gate && !tcg_ctx->nb_indirects;
+}
