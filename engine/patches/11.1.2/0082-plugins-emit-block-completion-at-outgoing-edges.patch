+/*
+ * plugin_gate (tcg_reg_alloc_plugin_gate): the call. The registers in
+ * g->save hold temps live across it and are pushed around it, keeping the
+ * stack 16-byte aligned for the call. Globals need nothing: they are in env.
+ */
+static void tcg_out_plugin_gate_call(TCGContext *s, const TCGPluginGate *g)
+{
+    TCGReg a0 = tcg_target_call_iarg_regs[0];
+    TCGReg a1 = tcg_target_call_iarg_regs[1];
+    uint32_t flags = (g->ctl >> TCG_PLUGIN_GATE_FLAGS_SHIFT)
+                     & TCG_PLUGIN_GATE_FLAGS_MASK;
+    int n = 0;
+
+    for (int r = 0; r < TCG_TARGET_NB_REGS; r++) {
+        if (tcg_regset_test_reg(g->save, r)) {
+            tcg_out_push(s, r);
+            n++;
+        }
+    }
+    if (n & 1) {
+        tcg_out_addi(s, TCG_REG_ESP, -8);
+    }
+    tcg_out_sti(s, TCG_TYPE_I32, flags, TCG_AREG0, g->flags_ofs);
+    if (g->ctl & TCG_PLUGIN_GATE_LOAD_CPU) {
+        tcg_out_ld(s, TCG_TYPE_I32, a0, TCG_AREG0, g->cpu);
+    } else {
+        tcg_out_movi(s, TCG_TYPE_I32, a0, g->cpu);
+    }
+    tcg_out_movi(s, TCG_TYPE_PTR, a1, g->userp);
+    tcg_out_call(s, (const tcg_insn_unit *)g->func, NULL);
+    tcg_out_sti(s, TCG_TYPE_I32, 0, TCG_AREG0, g->flags_ofs);
+    if (n & 1) {
+        tcg_out_addi(s, TCG_REG_ESP, 8);
+    }
+    for (int r = TCG_TARGET_NB_REGS - 1; r >= 0; r--) {
+        if (tcg_regset_test_reg(g->save, r)) {
+            tcg_out_pop(s, r);
+        }
+    }
+}
+
+/*
+ * plugin_gate: "test byte [env + gate_ofs], mask", then the call inline
+ * behind a forward "je", or a "jne" to the call after the block's code.
+ */
+static void tcg_out_plugin_gate(TCGContext *s, TCGPluginGate *g)
+{
+    tcg_out_modrm_offset(s, OPC_GRP3_Eb, EXT3_TESTi, TCG_AREG0, g->gate_ofs);
+    tcg_out8(s, g->ctl & TCG_PLUGIN_GATE_MASK);
+    if (g->ctl & TCG_PLUGIN_GATE_INLINE) {
+        tcg_out_jxx(s, JCC_JE, g->label, false);
+        tcg_out_plugin_gate_call(s, g);
+        tcg_out_label(s, g->label);
+    } else {
+        tcg_out_jxx(s, JCC_JNE, g->label, false);
+        g->raddr = tcg_splitwx_to_rx(s->code_ptr);
+    }
+}
+
+static bool tcg_out_plugin_gate_slow_path(TCGContext *s, TCGPluginGate *g)
+{
+    tcg_out_label(s, g->label);
+    tcg_out_plugin_gate_call(s, g);
+    tcg_out_jmp(s, g->raddr);
+    return true;
+}
