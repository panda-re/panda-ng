+++ b/plugins/core.c
@@ -490,6 +490,21 @@ void plugin_register_dyn_cond_cb__udata(GArray **arr,
     dyn_cb->cond = cond_cb;
 }
 
+/* A conditional callback on the vCPU's CPUState.plugin_tb_gates byte. */
+void plugin_register_dyn_gated_cb__udata(GArray **arr,
+                                         qemu_plugin_vcpu_udata_cb_t cb,
+                                         enum qemu_plugin_cb_flags flags,
+                                         uint8_t gate, void *udata)
+{
+    struct qemu_plugin_dyn_cb *dyn_cb;
+
+    assert(flags != QEMU_PLUGIN_CB_RW_REGS_PC);
+    plugin_register_dyn_cond_cb__udata(arr, cb, flags, QEMU_PLUGIN_COND_NE,
+                                       (qemu_plugin_u64) { 0 }, gate, udata);
+    dyn_cb = &g_array_index(*arr, struct qemu_plugin_dyn_cb, (*arr)->len - 1);
+    dyn_cb->type = PLUGIN_CB_GATED;
+}
