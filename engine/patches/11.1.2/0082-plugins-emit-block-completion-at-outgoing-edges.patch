 }
 
+/*
+ * Gated callbacks: a callback behind bits of the vCPU's gate byte
+ * (CPUState.plugin_tb_gates, at a fixed offset from env, so no scoreboard
+ * index), which the embedding turns on and off without retranslation.
+ *
+ * plugin_cb_flags is set around the call as for any callback, so the plugin
+ * API grants the callback the register access it registered with. The call
+ * itself needs no register sync of its own (TCG_CALL_NO_RWG): the gate syncs
+ * every global to CPUState before it, and no register copy of a global is used
+ * after it, so the callback reads and writes the guest registers in CPUState.
+ */
+static TCGHelperInfo gated_cb_info = {
+    .flags = TCG_CALL_NO_RWG,
+    /* qemu_plugin_vcpu_udata_cb_t: void (*)(uint32_t, void *) */
+    .typemask = dh_typemask(void, 0) | dh_typemask(i32, 1) | dh_typemask(ptr, 2),
+};
+
+/*
+ * Where the host backend has it, the gate and the call are one op,
+ * plugin_gate (tcg/tcg.c): no branch or label in the ops, so the gate does
+ * not end a basic block. The op's liveness (an op with side effects: globals
+ * synced before it) and its register allocation (register copies of globals
+ * dropped at it) give the sync above.
+ *
+ * The backend tests the gate byte inline and places the call by the gate's
+ * state now: inline, behind a forward branch, when the gate is open; out of
+ * line, after the block's code, when it is closed. Gates change without
+ * retranslation, but a block translated while its gate is open most likely
+ * runs with it open, and a closed gate then costs no taken branch.
+ */
+static void gen_plugin_gate(struct qemu_plugin_conditional_cb *cb)
+{
+    TCGOp *op = tcg_emit_op(INDEX_op_plugin_gate, 6);
+    TCGArg ctl = (cb->imm & TCG_PLUGIN_GATE_MASK)
+        | ((TCGArg)tcg_call_to_qemu_plugin_cb_flags(cb->info->flags)
+           << TCG_PLUGIN_GATE_FLAGS_SHIFT);
+
+    if (qatomic_read(&current_cpu->plugin_tb_gates) & cb->imm) {
+        ctl |= TCG_PLUGIN_GATE_INLINE;
+    }
+    /* as gen_cpu_index: a constant unless vCPUs run in parallel */
+    if (tcg_cflags_has(current_cpu, CF_PARALLEL)) {
+        ctl |= TCG_PLUGIN_GATE_LOAD_CPU;
+        op->args[5] = offsetof(CPUState, cpu_index) - sizeof(CPUState);
+    } else {
+        op->args[5] = current_cpu->cpu_index;
+    }
+    op->args[0] = ctl;
+    op->args[1] = (uintptr_t)cb->f.vcpu_udata;
+    op->args[2] = (uintptr_t)cb->userp;
+    op->args[3] = offsetof(CPUState, plugin_tb_gates) - sizeof(CPUState);
+    op->args[4] = offsetof(CPUState, neg.plugin_cb_flags) - sizeof(CPUState);
+}
+
+/*
+ * Elsewhere: load the gate byte, test it and branch around the call. The
+ * conditional branch syncs every global to CPUState, and the label after the
+ * call ends the basic block, which drops every register copy of a global.
+ */
+static void gen_udata_gated_cb(struct qemu_plugin_conditional_cb *cb)
+{
+    TCGv_i32 gates, cpu_index;
+    TCGLabel *after_cb;
+
+    if (tcg_plugin_gate_supported()) {
+        gen_plugin_gate(cb);
+        return;
+    }
+
+    gates = tcg_temp_ebb_new_i32();
+    after_cb = gen_new_label();
+    tcg_gen_ld8u_i32(gates, tcg_env,
+                     offsetof(CPUState, plugin_tb_gates) - sizeof(CPUState));
+    tcg_gen_brcondi_i32(TCG_COND_TSTEQ, gates, cb->imm, after_cb);
+    tcg_temp_free_i32(gates);
+
+    cpu_index = gen_cpu_index();
+    tcg_gen_st_i32(tcg_constant_i32(
+                       tcg_call_to_qemu_plugin_cb_flags(cb->info->flags)),
+                   tcg_env,
+                   offsetof(CPUState, neg.plugin_cb_flags) - sizeof(CPUState));
+    tcg_gen_call2(cb->f.vcpu_udata, &gated_cb_info, NULL,
+                  tcgv_i32_temp(cpu_index),
+                  tcgv_ptr_temp(tcg_constant_ptr(cb->userp)));
+    tcg_gen_st_i32(tcg_constant_i32(QEMU_PLUGIN_CB_NO_REGS), tcg_env,
+                   offsetof(CPUState, neg.plugin_cb_flags) - sizeof(CPUState));
+    tcg_temp_free_i32(cpu_index);
+    gen_set_label(after_cb);
+}
+
 static void gen_inline_add_u64_cb(struct qemu_plugin_inline_cb *cb)
 {
     TCGv_ptr ptr = gen_plugin_u64_ptr(cb->entry);
@@ -258,6 +350,9 @@ static void inject_cb(struct qemu_plugin_dyn_cb *cb)
     case PLUGIN_CB_COND:
         gen_udata_cond_cb(&cb->cond);
         break;
+    case PLUGIN_CB_GATED:
+        gen_udata_gated_cb(&cb->cond);
+        break;
     case PLUGIN_CB_INLINE_ADD_U64:
         gen_inline_add_u64_cb(&cb->inline_insn);
         break;
@@ -290,7 +385,65 @@ static void inject_mem_cb(struct qemu_plugin_dyn_cb *cb,
     }
 }
 
-static void plugin_gen_inject(struct qemu_plugin_tb *plugin_tb)
+/*
+ * A direct link normally skips the outgoing PC store on its fallback path.
+ * End observers need that store before the link. Move the goto, only for
+ * instrumented blocks, after the fallback's state updates. Every supported
+ * target pairs goto_tb with exit_tb(tb, slot) on this same path.
+ */
+static void plugin_move_direct_exits(void)
+{
+    TCGOp *op, *next, *jump = NULL;
+
+    QTAILQ_FOREACH_SAFE(op, &tcg_ctx->ops, link, next) {
+        if (op->opc == INDEX_op_goto_tb) {
+            g_assert(jump == NULL);
+            jump = op;
+        } else if (jump && op->opc == INDEX_op_exit_tb) {
+            g_assert((op->args[0] & TB_EXIT_MASK) == jump->args[0]);
+            QTAILQ_REMOVE(&tcg_ctx->ops, jump, link);
+            QTAILQ_INSERT_BEFORE(op, jump, link);
+            jump = NULL;
+        }
+    }
+    g_assert(jump == NULL);
+}
+
+/*
+ * Where a block's end callbacks go: before its exit. An indirect link's
+ * goto_ptr takes the result of the lookup call just before it, an EBB temp: a
+ * conditional end callback branches, so the callbacks go before that lookup
+ * (which then also sees any CPU state a callback changed).
+ */
+static TCGOp *plugin_end_point(TCGOp *op)
+{
+    if (op->opc == INDEX_op_goto_ptr) {
+        TCGOp *call = QTAILQ_PREV(op, link);
+
+        g_assert(call && call->opc == INDEX_op_call && TCGOP_CALLO(call) == 1
+                 && call->args[0] == op->args[0]);
+        return call;
+    }
+    return op;
+}
+
+/*
+ * At the start of a CF_PCREL TB with end callbacks: store the virtual address
+ * it runs at, which its end callbacks need after the PC has moved on, rather
+ * than binding the TB to one address (see plugin_gen_tb_end).
+ */
+static void gen_store_tb_vaddr(const TCGCPUOps *ops, const TranslationBlock *tb)
+{
+    TCGv_i64 pc = tcg_temp_ebb_new_i64();
+
+    ops->gen_tb_pc(pc, tb);
+    tcg_gen_st_i64(pc, tcg_env,
+                   offsetof(CPUState, plugin_tb_vaddr) - sizeof(CPUState));
+    tcg_temp_free_i64(pc);
+}
+
+static void plugin_gen_inject(struct qemu_plugin_tb *plugin_tb,
+                              const TCGCPUOps *store_vaddr)
 {
     TCGOp *op, *next;
     int insn_idx = -1;
@@ -313,8 +466,28 @@ static void plugin_gen_inject(struct qemu_plugin_tb *plugin_tb)
      */
     tcg_temp_ebb_reset_freed(tcg_ctx);
 
+    if (plugin_tb->end_cbs && plugin_tb->end_cbs->len) {
+        plugin_move_direct_exits();
+    }
+
     QTAILQ_FOREACH_SAFE(op, &tcg_ctx->ops, link, next) {
         switch (op->opc) {
+        case INDEX_op_goto_tb:
+        case INDEX_op_goto_ptr:
+        case INDEX_op_exit_tb:
+            /* A linked exit has already dispatched before its goto_tb.
+             * The prologue's TB_EXIT_REQUESTED did not execute the block. */
+            if (op->opc != INDEX_op_exit_tb || op->args[0] == 0) {
+                const GArray *cbs = plugin_tb->end_cbs;
+                int n_end = cbs ? cbs->len : 0;
+                tcg_ctx->emit_before_op = n_end ? plugin_end_point(op) : op;
+                for (int i = 0; i < n_end; i++) {
+                    inject_cb(&g_array_index(cbs, struct qemu_plugin_dyn_cb, i));
+                }
+                tcg_ctx->emit_before_op = NULL;
+            }
+            break;
+
         case INDEX_op_insn_start:
             insn_idx++;
             break;
@@ -349,6 +522,9 @@ static void plugin_gen_inject(struct qemu_plugin_tb *plugin_tb)
             case PLUGIN_GEN_FROM_TB:
                 assert(insn == NULL);
 
+                if (store_vaddr) {
+                    gen_store_tb_vaddr(store_vaddr, tcg_ctx->plugin_db->tb);
+                }
                 cbs = plugin_tb->cbs;
                 for (i = 0, n = (cbs ? cbs->len : 0); i < n; i++) {
                     inject_cb(
@@ -427,6 +603,9 @@ bool plugin_gen_tb_start(CPUState *cpu, const DisasContextBase *db)
         if (ptb->cbs) {
             g_array_set_size(ptb->cbs, 0);
         }
+        if (ptb->end_cbs) {
+            g_array_set_size(ptb->end_cbs, 0);
+        }
         ptb->n = 0;
         ptb->mem_helper = false;
         ptb->vaddr_read = false;
@@ -500,6 +679,22 @@ void plugin_gen_tb_end(CPUState *cpu, size_t num_insns)
     /* collect instrumentation requests */
     qemu_plugin_tb_trans_cb(cpu, ptb);
 
+    /*
+     * End callbacks run after the PC has moved on. A CF_PCREL TB stays shared
+     * and stores the address it runs at, at its start (gen_store_tb_vaddr);
+     * on a target that can't say where that address is, bind it instead.
+     */
+    const TCGCPUOps *ops = cpu->cc->tcg_ops;
+    const TCGCPUOps *store_vaddr = NULL;
+    if (ptb->end_cbs && ptb->end_cbs->len && !ptb->vaddr_read
+        && (tb_cflags(tcg_ctx->plugin_db->tb) & CF_PCREL)) {
+        if (ops->gen_tb_pc) {
+            store_vaddr = ops;
+        } else {
+            ptb->vaddr_read = true;
+        }
+    }
+
     /*
      * A CF_PCREL TB runs at every virtual address that maps its physical
      * page.  If a plugin read the address while instrumenting it, the
@@ -511,7 +706,7 @@ void plugin_gen_tb_end(CPUState *cpu, size_t num_insns)
     }
 
     /* inject the instrumentation at the appropriate places */
-    plugin_gen_inject(ptb);
+    plugin_gen_inject(ptb, store_vaddr);
 
     /* reset plugin translation state (plugin_tb is reused between blocks) */
     tcg_ctx->plugin_db = NULL;
