 };
 
+/**
+ * qemu_plugin_register_vcpu_tb_exec_gated_cb() - register a gated TB-entry
+ * callback
+ * @tb: the opaque translation handle
+ * @cb: callback function
+ * @flags: whether the callback reads or writes registers
+ * @gate: a bit mask
+ * @userdata: user data for callback
+ *
+ * As qemu_plugin_register_vcpu_tb_exec_cb(), called only while the vCPU's
+ * gate byte (CPUState.plugin_tb_gates) has a bit of @gate set. The block
+ * tests the byte inline, so opening and closing the gate needs no
+ * retranslation. The embedding writes the gates; a block that reads one
+ * while it changes may call once more or once less.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_vcpu_tb_exec_gated_cb(struct qemu_plugin_tb *tb,
+                                                qemu_plugin_vcpu_udata_cb_t cb,
+                                                enum qemu_plugin_cb_flags flags,
+                                                uint8_t gate,
+                                                void *userdata);
+
+/**
+ * qemu_plugin_register_vcpu_tb_end_gated_cb() - register a gated normal
+ * block-exit callback
+ * @tb: the opaque translation handle
+ * @cb: callback function
+ * @flags: whether the callback reads or writes registers
+ * @gate: a bit mask
+ * @userdata: user data for callback
+ *
+ * As qemu_plugin_register_vcpu_tb_end_cb(), gated as
+ * qemu_plugin_register_vcpu_tb_exec_gated_cb().
+ */
+QEMU_PLUGIN_API
