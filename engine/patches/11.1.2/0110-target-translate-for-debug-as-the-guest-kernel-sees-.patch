 };
 
 static int64_t loongarch_cpu_get_arch_id(CPUState *cs)
diff --git a/target/loongarch/cpu_helper.c b/target/loongarch/cpu_helper.c
index 123cad3d930974becf51b12f4f88c43ef2d2f3bc..53f0f8a6e54c6f44d5cebce3a03be64c3bf927e2 100644
--- a/target/loongarch/cpu_helper.c
+++ b/target/loongarch/cpu_helper.c
@@ -376,6 +376,30 @@ hwaddr loongarch_cpu_get_phys_addr_debug(CPUState *cs, vaddr addr)
     return context.physical;
 }
 
+/*
+ * The kernel's view: privilege level 0, for which the kernel's direct map
+ * windows (CSR.DMWn with only PLV0 enabled, as Linux sets them) and its
+ * pages (PTE.PLV 0) translate. Direct-address mode translates as it does
+ * for every privilege level.
+ */
+bool loongarch_cpu_translate_for_debug_kernel(CPUState *cs, vaddr addr,
+                                              TranslateForDebugResult *result)
+{
+    CPULoongArchState *env = cpu_env(cs);
+    MMUContext context;
+
+    context.addr = addr;
+    if (get_physical_address(env, &context, MMU_DATA_LOAD, MMU_KERNEL_IDX,
+                             1) != TLBRET_MATCH) {
+        return false;
+    }
+    result->physaddr = context.physical;
+    result->attrs = MEMTXATTRS_UNSPECIFIED;
+    result->attrs.debug = 1;
+    result->lg_page_size = TARGET_PAGE_BITS;
+    return true;
+}
+
 uint64_t loongarch_palen_mask(CPULoongArchState *env)
 {
     /* PALEN stores physical address bits - 1 */
