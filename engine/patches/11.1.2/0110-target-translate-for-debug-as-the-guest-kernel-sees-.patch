diff --git a/hw/core/cpu-system.c b/hw/core/cpu-system.c
index 936b73985ab855e301ea3fbdc554e0037d9e7724..c629e346461e308493385b0a728de4efe9ab687f 100644
--- a/hw/core/cpu-system.c
+++ b/hw/core/cpu-system.c
@@ -80,6 +80,15 @@ bool cpu_translate_for_debug(CPUState *cpu, vaddr addr,
     }
 }
 
+bool cpu_translate_for_debug_kernel(CPUState *cpu, vaddr addr,
+                                    TranslateForDebugResult *result)
+{
+    if (!cpu->cc->sysemu_ops->translate_for_debug_kernel) {
+        return false;
+    }
+    return cpu->cc->sysemu_ops->translate_for_debug_kernel(cpu, addr, result);
+}
+
 int cpu_asidx_from_attrs(CPUState *cpu, MemTxAttrs attrs)
 {
     int ret = 0;
diff --git a/include/hw/core/cpu.h b/include/hw/core/cpu.h
index a0b1fed9b41d5373454a59291de655934802eacf..092f1389fb9fb63ba6cac3fafe3bcedf640a111b 100644
--- a/include/hw/core/cpu.h
+++ b/include/hw/core/cpu.h
@@ -805,6 +805,30 @@ typedef struct TranslateForDebugResult {
 bool cpu_translate_for_debug(CPUState *cpu, vaddr addr,
                              TranslateForDebugResult *result);
 
+/**
+ * cpu_translate_for_debug_kernel:
+ * @cpu: The CPU use for the virtual-to-physical translation
+ * @addr: The virtual address
+ * @result: Struct filled in with results of translation
+ *
+ * As cpu_translate_for_debug(), but as the guest's kernel sees @addr: in
+ * the translation regime of the CPU's supervisor (with the current page
+ * tables), whatever privilege level the CPU is at, and without the checks
+ * that depend on privilege. Where privilege only decides whether an address
+ * translates, not where to, this succeeds wherever cpu_translate_for_debug()
+ * does and gives the same address. The CPU's state is not changed, so it may
+ * be called while the CPU runs.
+ *
+ * The answer doesn't depend on the CPU's current privilege level, so it
+ * stays the kernel's view while the CPU changes level.
+ *
+ * Returns: false on translation failure, or if the CPU's translation
+ * doesn't depend on privilege (cpu_translate_for_debug() answers for it);
+ * true on success, and fills in the fields of @result.
+ */
+bool cpu_translate_for_debug_kernel(CPUState *cpu, vaddr addr,
+                                    TranslateForDebugResult *result);
+
 /** cpu_asidx_from_attrs:
  * @cpu: CPU
  * @attrs: memory transaction attributes
diff --git a/include/hw/core/sysemu-cpu-ops.h b/include/hw/core/sysemu-cpu-ops.h
index 9a45596169a31823a0d4c1566fa4273a840bcd7c..e42cd2dcf5cbdb6634e8f2429f7666ca7ae082e8 100644
--- a/include/hw/core/sysemu-cpu-ops.h
+++ b/include/hw/core/sysemu-cpu-ops.h
@@ -58,6 +58,21 @@ typedef struct SysemuCPUOps {
      */
     bool (*translate_for_debug)(CPUState *cpu, vaddr addr,
                                 TranslateForDebugResult *result);
+    /**
+     * @translate_for_debug_kernel: Callback for translating a virtual
+     * address as @translate_for_debug does, but as the guest's kernel sees
+     * it: in the translation regime the CPU's supervisor uses with the
+     * current page tables, whatever the CPU's privilege level is now, and
+     * with the access controls that depend on privilege (user/supervisor
+     * page permissions, user-access enables such as RISC-V SUM, address
+     * regions reserved to the kernel) not applied. It must not change the
+     * CPU's state, and it doesn't depend on the CPU's current privilege
+     * level, so the answer stays the kernel's view while the CPU changes
+     * level. Returns false on translation failure. NULL if privilege
+     * doesn't change what translates.
+     */
+    bool (*translate_for_debug_kernel)(CPUState *cpu, vaddr addr,
+                                       TranslateForDebugResult *result);
     /**
      * @asidx_from_attrs: Callback to return the CPU AddressSpace to use for
      *       a memory access with the specified memory transaction attributes.
diff --git a/target/arm/cpu.c b/target/arm/cpu.c
index 1ebb3bccf1029deac8901fbdac027d1f4d36675b..df265037b1017ed4b0de1f188d6af1fad44b4939 100644
--- a/target/arm/cpu.c
+++ b/target/arm/cpu.c
@@ -2634,6 +2634,7 @@ static vaddr aarch64_untagged_addr(CPUState *cs, vaddr x)
 static const struct SysemuCPUOps arm_sysemu_ops = {
     .has_work = arm_cpu_has_work,
     .translate_for_debug = arm_cpu_translate_for_debug,
+    .translate_for_debug_kernel = arm_cpu_translate_for_debug_kernel,
     .asidx_from_attrs = arm_asidx_from_attrs,
     .write_elf32_note = arm_cpu_write_elf32_note,
     .write_elf64_note = arm_cpu_write_elf64_note,
diff --git a/target/arm/internals.h b/target/arm/internals.h
index e8c2ebdc819063821838994a1364bb0f5e071fcd..6663f59295d0f258bb3ee445fcd23a51d28db76d 100644
--- a/target/arm/internals.h
+++ b/target/arm/internals.h
@@ -1613,6 +1613,9 @@ void arm_log_exception(CPUState *cs);
 /* Implementation of SysemuCPUOps::translate_for_debug */
 bool arm_cpu_translate_for_debug(CPUState *cs, vaddr addr,
                                  TranslateForDebugResult *result);
+/* Implementation of SysemuCPUOps::translate_for_debug_kernel */
+bool arm_cpu_translate_for_debug_kernel(CPUState *cs, vaddr addr,
+                                        TranslateForDebugResult *result);
 
 #endif /* !CONFIG_USER_ONLY */
 
diff --git a/target/arm/ptw.c b/target/arm/ptw.c
index 9afc1aa0e7c7971cc6a670af8dde781bf8a77492..bfb5d372011695937b5fdf2d0f78c5afa3c9601c 100644
--- a/target/arm/ptw.c
+++ b/target/arm/ptw.c
@@ -4149,3 +4149,45 @@ bool arm_cpu_translate_for_debug(CPUState *cs, vaddr addr,
         return false;
     }
 }
+
+/*
+ * The kernel's view: an EL0 regime's privileged counterpart, which uses the
+ * same translation tables. Debug walks check no permissions, so what this
+ * adds is what is refused to EL0 before any permission check: the TTBR1
+ * half under TCR_ELx.E0PD1, and the TTBR0 half under E0PD0.
+ */
+bool arm_cpu_translate_for_debug_kernel(CPUState *cs, vaddr addr,
+                                        TranslateForDebugResult *result)
+{
+    CPUARMState *env = cpu_env(cs);
+    ARMMMUIdx mmu_idx;
+
+    switch (arm_mmu_idx(env)) {
+    case ARMMMUIdx_E10_0:
+        mmu_idx = ARMMMUIdx_E10_1;
+        break;
+    case ARMMMUIdx_E20_0:
+        mmu_idx = ARMMMUIdx_E20_2;
+        break;
+    case ARMMMUIdx_E30_0:
+        mmu_idx = ARMMMUIdx_E30_3_PAN;
+        break;
+    case ARMMMUIdx_MUser:
+        mmu_idx = ARMMMUIdx_MPriv;
+        break;
+    case ARMMMUIdx_MUserNegPri:
+        mmu_idx = ARMMMUIdx_MPrivNegPri;
+        break;
+    case ARMMMUIdx_MSUser:
+        mmu_idx = ARMMMUIdx_MSPriv;
+        break;
+    case ARMMMUIdx_MSUserNegPri:
+        mmu_idx = ARMMMUIdx_MSPrivNegPri;
+        break;
+    default:
+        /* Already privileged: the current regime is the kernel's */
+        mmu_idx = arm_mmu_idx(env);
+        break;
+    }
+    return arm_cpu_get_phys_addr(env, addr, result, mmu_idx);
+}
