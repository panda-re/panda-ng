@@ -19,6 +19,7 @@
 #include "qemu/osdep.h"
 #include "cpu.h"
 #include "exec/page-protection.h"
+#include "exec/target_page.h"
 #include "../internal.h"
 
 static int is_seg_am_mapped(unsigned int am, bool eu, int mmu_idx)
@@ -239,3 +240,30 @@ hwaddr mips_cpu_get_phys_addr_debug(CPUState *cs, vaddr addr)
     }
     return phys_addr;
 }
+
+/*
+ * The kernel's view: kernel mode, to which every segment is accessible
+ * (user and supervisor modes take an address error outside their segments).
+ * Error level keeps its own view (kuseg unmapped).
+ */
+bool mips_cpu_translate_for_debug_kernel(CPUState *cs, vaddr addr,
+                                         TranslateForDebugResult *result)
+{
+    CPUMIPSState *env = cpu_env(cs);
+    int mmu_idx = mips_env_mmu_index(env);
+    hwaddr phys_addr;
+    int prot;
+
+    if (mmu_idx != MMU_ERL_IDX) {
+        mmu_idx = MIPS_HFLAG_KM;
+    }
+    if (get_physical_address(env, &phys_addr, &prot, addr, MMU_DATA_LOAD,
+                             mmu_idx) != TLBRET_MATCH) {
+        return false;
+    }
+    result->physaddr = phys_addr;
+    result->attrs = MEMTXATTRS_UNSPECIFIED;
+    result->attrs.debug = 1;
+    result->lg_page_size = TARGET_PAGE_BITS;
+    return true;
+}
