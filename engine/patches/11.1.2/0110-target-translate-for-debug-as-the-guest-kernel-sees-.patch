 bool x86_cpu_translate_for_debug(CPUState *cpu, vaddr addr,
                                  TranslateForDebugResult *result);
+bool x86_cpu_translate_for_debug_cr3(CPUState *cpu, uint64_t cr3, vaddr addr,
+                                     TranslateForDebugResult *result);
 int cpu_get_pic_interrupt(CPUX86State *s);
 
 /* MS-DOS compatibility mode FPU exception support */
diff --git a/target/i386/helper.c b/target/i386/helper.c
index 93be0b9357e69e1feb38f0f076631b02c5b72046..fc557174e4dbf784d8e38bcbd0eec4389ba0c414 100644
--- a/target/i386/helper.c
+++ b/target/i386/helper.c
@@ -258,8 +258,14 @@ void cpu_x86_update_cr4(CPUX86State *env, uint32_t new_cr4)
 }
 
 #if !defined(CONFIG_USER_ONLY)
-bool x86_cpu_translate_for_debug(CPUState *cs, vaddr addr,
-                                 TranslateForDebugResult *result)
+/*
+ * x86_cpu_translate_for_debug_cr3: as x86_cpu_translate_for_debug, with
+ * @cr3 as the page table root instead of CR3 (the other paging controls are
+ * the CPU's). For a caller that knows another table the guest uses for the
+ * same address space, e.g. the kernel's half of a page-table isolation pair.
+ */
+bool x86_cpu_translate_for_debug_cr3(CPUState *cs, uint64_t cr3, vaddr addr,
+                                     TranslateForDebugResult *result)
 {
     X86CPU *cpu = X86_CPU(cs);
     CPUX86State *env = &cpu->env;
@@ -291,14 +297,14 @@ bool x86_cpu_translate_for_debug(CPUState *cs, vaddr addr,
             }
 
             if (la57) {
-                pml5e_addr = ((env->cr[3] & ~0xfff) +
+                pml5e_addr = ((cr3 & ~0xfff) +
                         (((addr >> 48) & 0x1ff) << 3)) & a20_mask;
                 pml5e = x86_ldq_phys(cs, pml5e_addr);
                 if (!(pml5e & PG_PRESENT_MASK)) {
                     return false;
                 }
             } else {
-                pml5e = env->cr[3];
+                pml5e = cr3;
             }
 
             pml4e_addr = ((pml5e & PG_ADDRESS_MASK) +
@@ -322,7 +328,7 @@ bool x86_cpu_translate_for_debug(CPUState *cs, vaddr addr,
         } else
 #endif
         {
-            pdpe_addr = ((env->cr[3] & ~0x1f) + ((addr >> 27) & 0x18)) &
+            pdpe_addr = ((cr3 & ~0x1f) + ((addr >> 27) & 0x18)) &
                 a20_mask;
             pdpe = x86_ldq_phys(cs, pdpe_addr);
             if (!(pdpe & PG_PRESENT_MASK))
@@ -353,7 +359,7 @@ bool x86_cpu_translate_for_debug(CPUState *cs, vaddr addr,
         uint32_t pde;
 
         /* page directory entry */
-        pde_addr = ((env->cr[3] & ~0xfff) + ((addr >> 20) & 0xffc)) & a20_mask;
+        pde_addr = ((cr3 & ~0xfff) + ((addr >> 20) & 0xffc)) & a20_mask;
         pde = x86_ldl_phys(cs, pde_addr);
         if (!(pde & PG_PRESENT_MASK))
             return false;
@@ -385,6 +391,13 @@ out:
     return true;
 }
 
+bool x86_cpu_translate_for_debug(CPUState *cs, vaddr addr,
+                                 TranslateForDebugResult *result)
+{
+    return x86_cpu_translate_for_debug_cr3(cs, cpu_env(cs)->cr[3], addr,
+                                           result);
+}
