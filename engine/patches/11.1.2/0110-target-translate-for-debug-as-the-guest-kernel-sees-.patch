+
+static bool ppc_debug_xlate(PowerPCCPU *cpu, vaddr addr, int dmmu_idx,
+                            int immu_idx, hwaddr *raddr)
+{
+    int s, p;
+
+    /* As ppc_cpu_get_phys_addr_debug: code TLBs may be separate */
+    return ppc_xlate(cpu, addr, MMU_DATA_LOAD, raddr, &s, &p, dmmu_idx,
+                     false) ||
+           ppc_xlate(cpu, addr, MMU_INST_FETCH, raddr, &s, &p, immu_idx,
+                     false);
+}
+
+/*
+ * The kernel's view: supervisor state (MSR[PR] clear), with translation on
+ * for Book3S (real mode doesn't translate) and in the same address space
+ * (MSR[IS]/[DS]) for BookE. Where the kernel's own accesses to user pages
+ * are blocked by a protection key (Book3S radix AMR, as Linux's KUAP sets
+ * it in the kernel), problem state reads them: that is tried second.
+ */
+bool ppc_cpu_translate_for_debug_kernel(CPUState *cs, vaddr addr,
+                                        TranslateForDebugResult *result)
+{
+    PowerPCCPU *cpu = POWERPC_CPU(cs);
+    CPUPPCState *env = &cpu->env;
+    int didx = ppc_env_mmu_index(env, false);
+    int iidx = ppc_env_mmu_index(env, true);
+    int kd, ki, ud, ui;
+    hwaddr raddr;
+
+    switch (env->mmu_model) {
+    case POWERPC_MMU_BOOKE206:
+        /* bit 0: !PR, bit 1: AS, bit 2: GS */
+        kd = didx | 1;
+        ki = iidx | 1;
+        break;
+#if defined(TARGET_PPC64)
+    case POWERPC_MMU_64B:
+    case POWERPC_MMU_2_03:
+    case POWERPC_MMU_2_06:
+    case POWERPC_MMU_2_07:
+    case POWERPC_MMU_3_00:
+#endif
+    case POWERPC_MMU_32B:
+        /* bit 0: !PR, bit 1: real mode, bit 2: HV */
+        kd = (didx | 1) & ~2;
+        ki = (iidx | 1) & ~2;
+        break;
+    default:
+        /* BookE 2.0x, 4xx and 6xx take the privilege from the MSR */
+        return false;
+    }
+    ud = kd & ~1;
+    ui = ki & ~1;
+    if (!ppc_debug_xlate(cpu, addr, kd, ki, &raddr) &&
+        !ppc_debug_xlate(cpu, addr, ud, ui, &raddr)) {
+        return false;
+    }
+    result->physaddr = raddr | (addr & ~TARGET_PAGE_MASK);
+    result->attrs = MEMTXATTRS_UNSPECIFIED;
+    result->attrs.debug = 1;
+    result->lg_page_size = TARGET_PAGE_BITS;
+    return true;
+}
