From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Tue, 24 Nov 2026 11:19:29 -0500
Subject: [PATCH] accel/tcg, target/arm: serve page-in requests between blocks

Page-in requests (src/include/panda/pagein.h) wait until a vCPU reaches a
user-mode instruction boundary of the request's address space.  The CPU
loop calls panda_pagein_service() before each block lookup while any
request or held register set is outstanding (PANDA_LOOP_PAGEIN in
panda_loop_hooks); with nothing outstanding it costs the load and test of
panda_loop_hooks that the exception hook already makes.

The service makes the task enter the kernel with madvise(MADV_POPULATE_*)
as if it had executed a system call instruction at that boundary.  On
AArch64 that is an SVC exception raised from the loop: arm_cpu_do_interrupt
does not report it to the syscall trap, which would otherwise see a call
the program never made.

Vendored source: src/panda/src/pagein.c, src/include/panda/pagein.h.

SPDX-License-Identifier: GPL-2.0-or-later
Origin: new
---
 accel/tcg/cpu-exec.c | 4 ++++
 target/arm/helper.c  | 7 +++++--
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 0bb254b908d89d8e95835e6f2d1f04bd65ff7ae3..877242e4326362172acd1142e707c7a612662200 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -1042,6 +1042,10 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
 
         while (!cpu_handle_interrupt(cpu, &last_tb)) {
             TranslationBlock *tb;
+
+            if (panda_loop_wants(PANDA_LOOP_PAGEIN)) {
+                panda_pagein_service(cpu);      /* may leave the loop */
+            }
             TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
             s.cflags = cpu->cflags_next_tb;
 
diff --git a/target/arm/helper.c b/target/arm/helper.c
index e59195f61b7e7bf27c735401cd9c2246e5562f09..87160c11b1fdf44601afc71ab958fe9477186f9a 100644
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -9867,7 +9867,10 @@ void arm_cpu_do_interrupt(CPUState *cs)
     unsigned int new_el = env->exception.target_el;
     uint64_t last_pc = cs->cc->get_pc(cs);
     bool hooks = true, unlock = false;
+    /* a page-in request's system call: the program did not make it */
+    bool injected = panda_pagein_injecting;
 
+    panda_pagein_injecting = false;
     assert(!arm_feature(env, ARM_FEATURE_M));
 
     arm_log_exception(cs);
@@ -9900,7 +9903,7 @@ void arm_cpu_do_interrupt(CPUState *cs)
     }
 #endif
 
-    if (cs->exception_index == EXCP_SWI && !is_a64(env) &&
+    if (cs->exception_index == EXCP_SWI && !injected && !is_a64(env) &&
         panda_sc_enter_inline(PANDA_SYSCALL_FORM_A32_SVC) && arm_current_el(env) == 0 &&
         /* under an AArch64 kernel, or an AArch32 one on a CPU without AArch64 */
         (arm_feature(env, ARM_FEATURE_AARCH64) ? arm_el_is_aa64(env, 1) : true)) {
@@ -9909,7 +9912,7 @@ void arm_cpu_do_interrupt(CPUState *cs)
 
         panda_sc_enter_c(cs, PANDA_SYSCALL_FORM_A32_SVC, env->regs[15] - len, len);
     }
-    if (cs->exception_index == EXCP_SWI && syscall_trap_enabled() &&
+    if (cs->exception_index == EXCP_SWI && !injected && syscall_trap_enabled() &&
         arm_current_el(env) == 0 && arm_sc_enter(env)) {
         return;
     }
