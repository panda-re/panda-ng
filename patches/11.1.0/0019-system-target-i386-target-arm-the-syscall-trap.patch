index 4026f67579e768232b51cddc792e156adfb1d680..d3696e138ac9214776a5d385310fbcc33e9a1323 100644
--- a/target/arm/internals.h
+++ b/target/arm/internals.h
@@ -366,6 +366,14 @@ static inline unsigned int aarch64_banked_spsr_index(unsigned int el)
 }
 
 /* Map CPU modes onto saved register banks.  */
+#ifndef CONFIG_USER_ONLY
+uint64_t arm_sc_key(CPUARMState *env);
+uint64_t arm_sc_percpu(CPUARMState *env);
+uint64_t arm_sc_usp(CPUARMState *env);
+uint32_t arm_sc_kmmu(void);
+void arm_sc_return_aa32(CPUARMState *env);
+#endif
+
 static inline int bank_number(int mode)
 {
     switch (mode) {
diff --git a/target/arm/tcg/helper-a64.c b/target/arm/tcg/helper-a64.c
index 05ab9ab6d31b638606c4dd79bedbfbb0b69748ff..0419b282cf980ed5112c83612fad7b3d7737cb16 100644
--- a/target/arm/tcg/helper-a64.c
+++ b/target/arm/tcg/helper-a64.c
@@ -28,6 +28,7 @@
 #include "qemu/main-loop.h"
 #include "qemu/bitops.h"
 #include "internals.h"
+#include "system/syscall-trap.h"
 #include "qemu/crc32c.h"
 #include "exec/cpu-common.h"
 #include "accel/tcg/cpu-ldst.h"
@@ -762,6 +763,61 @@ void HELPER(exception_return)(CPUARMState *env, uint64_t new_pc)
     arm_call_el_change_hook(cpu);
     bql_unlock();
 
+    while (new_el == 0 && syscall_trap_waiting()) {
+        uint64_t ret = return_to_aa64 ? env->xregs[0] : env->regs[0];
+        SyscallTrapRewind rw;
+        int r = syscall_trap_return(env_cpu(env),
+                                    return_to_aa64 ? env->pc : env->regs[15],
+                                    arm_sc_key(env), arm_sc_usp(env),
+                                    arm_sc_percpu(env), arm_sc_kmmu(), &ret,
+                                    &rw);
+
+        if ((r & SYSCALL_TRAP_REWIND) && return_to_aa64 &&
+            rw.abi == SYSCALL_ABI_AARCH64) {
+            /* an injected call is back: the task's own call, again */
+            env->xregs[8] = rw.num;
+            memcpy(env->xregs, rw.args, sizeof(rw.args));
+            env->pc -= rw.len;
+            break;
+        }
+        if ((r & SYSCALL_TRAP_REWIND) && !return_to_aa64 &&
+            rw.abi == SYSCALL_ABI_ARM) {
+            /* the same for an AArch32 task: r7, r0-r5, back on the svc */
+            env->regs[7] = rw.num;
+            for (int i = 0; i < 6; i++) {
+                env->regs[i] = (uint32_t)rw.args[i];
+            }
+            env->regs[15] -= rw.len;
+            break;
+        }
+
+        if (r & SYSCALL_TRAP_RESTORE) {
+            /* back from a call injected at the return: this call's registers */
+            if (return_to_aa64 && rw.abi == SYSCALL_ABI_AARCH64) {
+                env->xregs[8] = rw.num;
+                for (int i = 1; i < 6; i++) {
+                    env->xregs[i] = rw.args[i];
+                }
+            } else if (!return_to_aa64 && rw.abi == SYSCALL_ABI_ARM) {
+                env->regs[7] = rw.num;
+                for (int i = 1; i < 6; i++) {
+                    env->regs[i] = (uint32_t)rw.args[i];
+                }
+            }
+        }
+        if (r & SYSCALL_TRAP_RET) {
+            if (return_to_aa64) {
+                env->xregs[0] = ret;
+            } else {
+                env->regs[0] = ret;
+            }
+        }
+        if (!(r & SYSCALL_TRAP_FAULT)) {
+            break;
+        }
+        /* the state is exact: the task is back at EL0 */
+        syscall_trap_fault(env_cpu(env), 0);
+    }
     return;
 
 illegal_return:
