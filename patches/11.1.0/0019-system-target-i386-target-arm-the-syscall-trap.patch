 include/accel/tcg/probe.h           |  14 ++++
 include/hw/core/cpu.h               |   6 ++
 system/meson.build                  |   1 +
 target/arm/helper.c                 | 119 +++++++++++++++++++++++++++
 target/arm/internals.h              |   7 ++
 target/arm/tcg/helper-a64.c         |  32 ++++++++
 target/i386/tcg/emit.c.inc          |   1 +
 target/i386/tcg/seg_helper.c        | 123 ++++++++++++++++++++++++++++
 target/i386/tcg/seg_helper.h        |  21 +++++
 target/i386/tcg/system/seg_helper.c |  50 +++++++++++
 11 files changed, 387 insertions(+)

diff --git a/accel/tcg/cputlb.c b/accel/tcg/cputlb.c
index 7f7c208ba1219d2967ee1c2ef170d5af942ff113..d7f51c94c29454c80b54d56252c73035e73747e8 100644
--- a/accel/tcg/cputlb.c
+++ b/accel/tcg/cputlb.c
@@ -1528,6 +1528,19 @@ void *tlb_vaddr_to_host(CPUArchState *env, vaddr addr,
     return flags ? NULL : host;
 }
 
+void *tlb_vaddr_to_host_lookup(CPUState *cpu, vaddr addr,
+                               MMUAccessType access_type, int mmu_idx)
+{
+    CPUTLBEntry *entry = tlb_entry(cpu, mmu_idx, addr);
+    uint64_t cmp = tlb_read_idx(entry, access_type);
+
+    /* a hit on plain RAM only: no fill, so no page walk side effects */
+    if (!tlb_hit(cmp, addr) || (cmp & (TLB_FORCE_SLOW | TLB_NOTDIRTY))) {
+        return NULL;
+    }
+    return (void *)((uintptr_t)addr + entry->addend);
+}
+
 /*
  * Return a ram_addr_t for the virtual address for execution.
  *
diff --git a/include/accel/tcg/probe.h b/include/accel/tcg/probe.h
