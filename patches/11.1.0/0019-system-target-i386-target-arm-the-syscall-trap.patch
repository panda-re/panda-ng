 #ifdef TARGET_X86_64
 #define SET_ESP(val, sp_mask)                                   \
@@ -1145,6 +1146,9 @@ void helper_sysret(CPUX86State *env, int dflag)
                                DESC_S_MASK | (3 << DESC_DPL_SHIFT) |
                                DESC_W_MASK | DESC_A_MASK);
     }
+#ifndef CONFIG_USER_ONLY
