+    }
+#endif
     if (env->cr[0] & CR0_PE_MASK) {
 #if !defined(CONFIG_USER_ONLY)
         if (env->hflags & HF_GUEST_MASK) {
@@ -2285,6 +2395,9 @@ void helper_iret_protected(CPUX86State *env, int shift, int next_eip)
         helper_ret_protected(env, shift, 1, 0, GETPC());
     }
     env->hflags2 &= ~HF2_NMI_MASK;
+#ifndef CONFIG_USER_ONLY
+    x86_sc_return(env);
+#endif
 }
 
 void helper_lret_protected(CPUX86State *env, int shift, int addend)
@@ -2297,6 +2410,13 @@ void helper_sysenter(CPUX86State *env)
     if (env->sysenter_cs == 0) {
         raise_exception_err_ra(env, EXCP0D_GPF, 0, GETPC());
     }
+#ifndef CONFIG_USER_ONLY
+    /* the vDSO puts the user stack pointer in ebp: sysenter loses esp */
+    if (syscall_trap_enabled() && (env->hflags & HF_CPL_MASK) == 3 &&
+        x86_sc_i386(env, env->eip + 2, 2, R_ECX, R_EBP, true)) {
+        return;
+    }
+#endif
     env->eflags &= ~(VM_MASK | IF_MASK | RF_MASK);
 
 #ifdef TARGET_X86_64
@@ -2362,6 +2482,9 @@ void helper_sysexit(CPUX86State *env, int dflag)
     }
     env->regs[R_ESP] = env->regs[R_ECX];
     env->eip = env->regs[R_EDX];
+#ifndef CONFIG_USER_ONLY
+    x86_sc_return(env);
+#endif
 }
 
