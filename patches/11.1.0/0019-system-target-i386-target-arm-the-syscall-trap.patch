diff --git a/target/arm/helper.c b/target/arm/helper.c
index af45234ad2a7e86bbc02f6faa6c5534436133e1b..74f82038fe9f77d8380fcaa4acada3fe1a13edf3 100644
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -35,6 +35,7 @@
 #include "cpregs.h"
 #include "target/arm/gtimer.h"
 #include "qemu/plugin.h"
+#include "system/syscall-trap.h"
 
 static void switch_mode(CPUARMState *env, int mode);
 #ifndef CONFIG_USER_ONLY
@@ -3278,6 +3279,16 @@ static uint64_t aa64_dczid_read(CPUARMState *env, const ARMCPRegInfo *ri)
     return cpu->isar.idregs[DCZID_EL0_IDX] | dzp_bit;
 }
 
+static void sp_el0_write(CPUARMState *env, const ARMCPRegInfo *ri,
+                         uint64_t value)
+{
+    env->sp_el[0] = value;
+    /* a kernel address: Linux's current (CPUState.syscall_current) */
+    if (value >> 63) {
+        env_cpu(env)->syscall_current = value;
+    }
+}
+
 static CPAccessResult sp_el0_access(CPUARMState *env, const ARMCPRegInfo *ri,
                                     bool isread)
 {
@@ -3650,7 +3661,7 @@ static const ARMCPRegInfo v8_cp_reginfo[] = {
     { .name = "SP_EL0", .state = ARM_CP_STATE_AA64,
       .opc0 = 3, .opc1 = 0, .crn = 4, .crm = 1, .opc2 = 0,
       .access = PL1_RW, .accessfn = sp_el0_access,
-      .type = ARM_CP_ALIAS,
+      .type = ARM_CP_ALIAS, .writefn = sp_el0_write,
       .fieldoffset = offsetof(CPUARMState, sp_el[0]) },
     { .name = "SP_EL1", .state = ARM_CP_STATE_AA64,
       .opc0 = 3, .opc1 = 4, .crn = 4, .crm = 1, .opc2 = 0,
@@ -9618,6 +9629,173 @@ static void tcg_handle_semihosting(CPUState *cs)
  *       and KVM to re-inject guest debug exceptions, and to
  *       inject a Synchronous-External-Abort.
  */
+/*
+ * The task key for syscall events: the kernel's stack pointer for
+ * the task, which the CPU banks while the task runs in user mode, and the
+ * user stack pointer (arm_sc_usp), which tells a signal handler's calls
+ * from the call it interrupted.
+ */
+uint64_t arm_sc_usp(CPUARMState *env)
+{
+    return is_a64(env) ? env->xregs[31] : env->regs[13];
+}
+
+uint32_t arm_sc_kmmu(void)
+{
+    return (1u << arm_to_core_mmu_idx(ARMMMUIdx_E10_1)) |
+           (1u << arm_to_core_mmu_idx(ARMMMUIdx_E10_1_PAN));
+}
+
+uint64_t arm_sc_key(CPUARMState *env)
+{
+    if (arm_el_is_aa64(env, 1)) {
+        return env->sp_el[1];
+    }
+    return env->banked_r13[bank_number(ARM_CPU_MODE_SVC)];
+}
+
+/* where the kernel finds the task: its per-CPU base, or its stack */
+uint64_t arm_sc_percpu(CPUARMState *env)
+{
+    return arm_el_is_aa64(env, 1) ? env->cp15.tpidr_el[1] : arm_sc_key(env);
+}
+
+/* svc from EL0: report the syscall; true if the consumer skipped it */
+static bool arm_sc_enter(CPUARMState *env)
+{
+    uint64_t args[6], ret, pc;
+    int abi, r;
+    int64_t num;
+    unsigned len;
+
+    if (is_a64(env)) {
+        abi = SYSCALL_ABI_AARCH64;
+        num = env->xregs[8];
+        memcpy(args, env->xregs, sizeof(args));
+        pc = env->pc;
+        len = 4;
+    } else {
+        uint32_t imm = env->exception.syndrome & 0xffff;   /* ISS imm16 */
+
+        abi = SYSCALL_ABI_ARM;
+        num = (uint32_t)env->regs[7];
+        if (!arm_el_is_aa64(env, 1) && imm && !env->thumb) {
+            /* OABI: swi 0x900000 + n; the syndrome holds the low 16 bits */
+            abi = SYSCALL_ABI_ARM_OABI;
+            num = imm;
+        }
+        for (int i = 0; i < 6; i++) {
+            args[i] = (uint32_t)env->regs[i];
+        }
+        pc = env->regs[15];
+        len = env->thumb ? 2 : 4;
+        if (arm_el_is_aa64(env, 1)) {
+            /*
+             * The 64-bit view of the user registers, as the exception entry
+             * would make it (a consumer reads them through the gdbstub,
+             * which shows xregs): dead state while EL0 runs AArch32.
+             */
+            aarch64_sync_32_to_64(env);
+        }
+    }
+    /*
+     * An injected call's registers go back on the way out to EL0: AArch64's,
+     * and an AArch32 task's when the kernel is AArch64 (helper-a64.c).
+     */
+    env_cpu(env)->syscall_inject_abis = arm_el_is_aa64(env, 1) ?
+        (1u << SYSCALL_ABI_AARCH64) | (1u << SYSCALL_ABI_ARM) :
+        1u << SYSCALL_ABI_ARM;          /* an AArch32 kernel: EABI, not OABI */
+    while ((r = syscall_trap_enter(env_cpu(env), abi, num, args, pc, len,
+                                   arm_sc_key(env), arm_sc_usp(env),
+                                   arm_sc_percpu(env), arm_sc_kmmu(),
+                                   &ret)) & SYSCALL_TRAP_FAULT) {
+        /*
+         * Take a data abort at the svc instead: back to it, still at EL0,
+         * so the abort returns there and the svc runs again.
+         */
+        if (is_a64(env)) {
+            env->pc -= len;
+        } else {
+            env->regs[15] -= len;
+        }
+        syscall_trap_fault(env_cpu(env), 0);
+        if (is_a64(env)) {
+            env->pc += len;
+        } else {
+            env->regs[15] += len;
+        }
+    }
+    if (r & (SYSCALL_TRAP_ARGS | SYSCALL_TRAP_INJECT)) {
+        for (int i = 0; i < 6; i++) {
+            if (is_a64(env)) {
+                env->xregs[i] = args[i];
+            } else {
+                env->regs[i] = args[i];
+            }
+        }
+    }
+    if (r & SYSCALL_TRAP_INJECT) {
+        /* the call the kernel runs: x8, or an EABI task's r7 */
+        if (is_a64(env)) {
+            env->xregs[8] = ret;
+        } else {
+            env->regs[7] = ret;
+        }
+    }
+    if (r & SYSCALL_TRAP_SKIP) {
+        /* the PC is already past the svc */
+        if (is_a64(env)) {
+            env->xregs[0] = ret;
+        } else {
+            env->regs[0] = ret;
+        }
+        return true;
+    }
+    return false;
+}
+
+/*
+ * An AArch32 kernel's exception return to user mode (cpsr_write_eret: the
+ * PC and the user registers are in place): report it, and put back what an
+ * injection changed, as helper_exception_return does for AArch64 kernels.
+ */
+void arm_sc_return_aa32(CPUARMState *env)
+{
+    while (syscall_trap_waiting()) {
+        uint64_t ret = (uint32_t)env->regs[0];
+        SyscallTrapRewind rw;
+        int r = syscall_trap_return(env_cpu(env), env->regs[15],
+                                    arm_sc_key(env), arm_sc_usp(env),
+                                    arm_sc_percpu(env), arm_sc_kmmu(), &ret,
+                                    &rw);
+
+        if ((r & SYSCALL_TRAP_REWIND) && rw.abi == SYSCALL_ABI_ARM) {
+            /* an injected call is back: r7, r0-r5, back on the svc */
+            env->regs[7] = rw.num;
+            for (int i = 0; i < 6; i++) {
+                env->regs[i] = (uint32_t)rw.args[i];
+            }
+            env->regs[15] -= rw.len;
+            break;
+        }
+        if ((r & SYSCALL_TRAP_RESTORE) && rw.abi == SYSCALL_ABI_ARM) {
+            /* back from a call injected at the return: this call's registers */
+            env->regs[7] = rw.num;
+            for (int i = 1; i < 6; i++) {
+                env->regs[i] = (uint32_t)rw.args[i];
+            }
+        }
+        if (r & SYSCALL_TRAP_RET) {
+            env->regs[0] = (uint32_t)ret;
+        }
+        if (!(r & SYSCALL_TRAP_FAULT)) {
+            break;
+        }
+        /* the state is exact: the task is back in user mode */
+        syscall_trap_fault(env_cpu(env), 0);
+    }
+}
+
 void arm_cpu_do_interrupt(CPUState *cs)
 {
     ARMCPU *cpu = ARM_CPU(cs);
@@ -9657,6 +9835,11 @@ void arm_cpu_do_interrupt(CPUState *cs)
     }
 #endif
 
+    if (cs->exception_index == EXCP_SWI && syscall_trap_enabled() &&
+        arm_current_el(env) == 0 && arm_sc_enter(env)) {
+        return;
+    }
+
     /*
      * Hooks may change global state so BQL should be held, also the
      * BQL needs to be held for any modification of
