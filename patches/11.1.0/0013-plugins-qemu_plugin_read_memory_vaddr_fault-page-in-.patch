 include/hw/core/cpu.h         |  1 +
 include/plugins/qemu-plugin.h | 51 ++++++++++++++++++++++++
 plugins/api-system.c          | 73 +++++++++++++++++++++++++++++++++++
 plugins/api-user.c            |  8 ++++
 plugins/core.c                | 61 +++++++++++++++++++++++++++++
 target/arm/cpu.c              |  6 +++
 target/i386/tcg/tcg-cpu.c     |  6 +++
 target/mips/cpu.c             |  6 +++
 9 files changed, 218 insertions(+)

