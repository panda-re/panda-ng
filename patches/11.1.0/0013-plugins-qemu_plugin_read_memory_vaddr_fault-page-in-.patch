diff --git a/include/plugins/qemu-plugin.h b/include/plugins/qemu-plugin.h
index 3e913cd89ce62f9f65b9837d086afb19fa86fa05..73dd2c68756e9ef52fe7987cc6a9d5321fce8827 100644
--- a/include/plugins/qemu-plugin.h
+++ b/include/plugins/qemu-plugin.h
@@ -1144,6 +1144,57 @@ QEMU_PLUGIN_API
 bool qemu_plugin_write_register(struct qemu_plugin_register *handle,
                                 GByteArray *buf);
 
+/**
+ * enum qemu_plugin_vaddr_mode - privilege for a virtual memory read
+ *
+ * @QEMU_PLUGIN_VADDR_CURRENT: translate as a data load at the current
+ *                             privilege level (with its access controls)
+ * @QEMU_PLUGIN_VADDR_USER: translate as an unprivileged data load, as
+ *                          e.g. AArch64 LDTR or an x86 CPL3 access would
+ */
+enum qemu_plugin_vaddr_mode {
+    QEMU_PLUGIN_VADDR_CURRENT,
+    QEMU_PLUGIN_VADDR_USER,
+};
+
+enum qemu_plugin_vaddr_result {
+    QEMU_PLUGIN_VADDR_OK = 0,
+    QEMU_PLUGIN_VADDR_UNMAPPED = -1,
+    QEMU_PLUGIN_VADDR_IO = -2,
+    QEMU_PLUGIN_VADDR_BAD_MODE = -3,
+};
+
+/**
+ * qemu_plugin_read_memory_vaddr_fault() - read guest memory, paging it in
+ *
+ * @addr: guest virtual address
+ * @data: buffer, resized to @len on success
+ * @len: number of bytes
+ * @mode: privilege used for translation
+ * @fault: if a page has no valid translation, raise a guest fault
+ *
+ * Reads @len bytes through the guest MMU. Pages that are not RAM are
+ * never read (QEMU_PLUGIN_VADDR_IO), avoiding device side effects.
+ *
+ * If @fault is true and a page has no valid translation, this raises the
+ * exception a guest data load of @addr at the start of the instrumented
+ * instruction would take, and does not return. The guest handles it (for
+ * example by paging the address in) and resumes at the same instruction,
+ * which re-runs the callback. Callers must therefore be idempotent and
+ * must bound their retries. Faulting requires a callback registered with
+ * QEMU_PLUGIN_CB_RW_REGS_PC; otherwise QEMU_PLUGIN_VADDR_UNMAPPED is
+ * returned. Whether the guest can legally take the fault at this point
+ * (privilege, IRQ state, locks held, a valid mapping) is the caller's
+ * responsibility.
+ *
+ * Returns a qemu_plugin_vaddr_result.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_read_memory_vaddr_fault(uint64_t addr, GByteArray *data,
+                                        size_t len,
+                                        enum qemu_plugin_vaddr_mode mode,
+                                        bool fault);
+
 /**
  * qemu_plugin_set_pc() - set the program counter for the current vCPU
  *
diff --git a/plugins/api-system.c b/plugins/api-system.c
index fbf905cd63e4cc109748b379f4209f6ad6547c2c..4f6f88df2322cbc5bb0b299314be250ad8bb5260 100644
--- a/plugins/api-system.c
+++ b/plugins/api-system.c
@@ -17,6 +17,11 @@
 #include "hw/core/boards.h"
 #include "qemu/plugin-memory.h"
 #include "qemu/plugin.h"
+#include "accel/tcg/cpu-ops.h"
+#include "accel/tcg/probe.h"
+#include "accel/tcg/cpu-mmu-index.h"
+#include "exec/target_page.h"
+#include "exec/tlb-flags.h"
 
 /*
  * In system mode we cannot trace the binary being executed so the
@@ -129,3 +134,71 @@ void qemu_plugin_update_ns(const void *handle, int64_t new_time)
                          RUN_ON_CPU_HOST_ULONG(new_time));
     }
 }
+
+/*
+ * Consistent virtual memory reads
+ */
+
+int qemu_plugin_read_memory_vaddr_fault(uint64_t addr, GByteArray *data,
+                                        size_t len,
+                                        enum qemu_plugin_vaddr_mode mode,
+                                        bool fault)
+{
+    CPUState *cpu = current_cpu;
+    CPUArchState *env;
+    size_t done = 0, page_size = qemu_target_page_size();
+    int mmu_idx;
+
+    g_assert(cpu);
+    env = cpu_env(cpu);
+
+    if (len == 0) {
+        return QEMU_PLUGIN_VADDR_UNMAPPED;
+    }
+    if (mode == QEMU_PLUGIN_VADDR_USER) {
+        if (!cpu->cc->tcg_ops->user_mmu_index) {
+            return QEMU_PLUGIN_VADDR_BAD_MODE;
+        }
+        mmu_idx = cpu->cc->tcg_ops->user_mmu_index(cpu);
+    } else {
+        mmu_idx = cpu_mmu_index(cpu, false);
+    }
+
+    g_byte_array_set_size(data, len);
+
+    while (done < len) {
+        vaddr a = addr + done;
+        size_t chunk = MIN(len - done, page_size - (a & (page_size - 1)));
+        CPUTLBEntryFull *full;
+        void *host;
+        int flags;
+
+        /* Never faults, never triggers plugin memory instrumentation. */
+        flags = probe_access_full_mmu(env, a, 0, MMU_DATA_LOAD, mmu_idx,
+                                      &host, &full);
+        if (flags & TLB_INVALID_MASK) {
+            uintptr_t ra = cpu->neg.plugin_cb_ra;
+
+            if (!fault || !ra ||
+                qemu_plugin_get_cb_flags() != QEMU_PLUGIN_CB_RW_REGS_PC) {
+                return QEMU_PLUGIN_VADDR_UNMAPPED;
+            }
+            /*
+             * Raise the exception a guest load at the start of the current
+             * instruction would take (#PF, data abort, TLBL, DSI ...).  The
+             * guest resolves it and resumes at the same instruction, so the
+             * callback runs again.  Returns only if the translation became
+             * valid in the meantime.
+             */
+            probe_access(env, a, 0, MMU_DATA_LOAD, mmu_idx, ra);
+            continue;
+        }
+        if (flags & TLB_MMIO) {
+            /* Not RAM: a read could have device side effects. */
+            return QEMU_PLUGIN_VADDR_IO;
+        }
+        memcpy(data->data + done, host, chunk);
+        done += chunk;
+    }
+    return QEMU_PLUGIN_VADDR_OK;
+}
diff --git a/plugins/api-user.c b/plugins/api-user.c
index 28704a89e89944890be3d824013ed3a9e7de2e43..4b79f76117f4dd57d16e917bfd954a420d61dcc8 100644
--- a/plugins/api-user.c
+++ b/plugins/api-user.c
@@ -55,3 +55,11 @@ void qemu_plugin_update_ns(const void *handle, int64_t new_time)
 {
