option('plugin_debug_rust', type : 'boolean', value : false,
       description : 'Enable debug symbols for Rust plugins')
option('engine_libdir', type : 'string', value : '',
       description : 'Directory with libpanda-<target>.so to link the plugins against (default: the lib/ next to the panda-ng headers found)')
option('targets', type : 'array',
       description : 'List of qemu targets to build plugins',
       value: [
                 'x86_64-softmmu',
                 'i386-softmmu',
                 'arm-softmmu',
                 'aarch64-softmmu',
                 'ppc-softmmu',
                 'ppc64-softmmu',
                 'mips-softmmu',
                 'mipsel-softmmu',
                 'mips64-softmmu',
                 'mips64el-softmmu',
                 'loongarch64-softmmu',
                 'riscv32-softmmu',
                 'riscv64-softmmu',
          ]
       )